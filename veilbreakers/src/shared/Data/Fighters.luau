local function apply(base: { [string]: any }, overrides: { [string]: any }?): { [string]: MoveKit.Move }
	local out: { [string]: MoveKit.Move } = {}
	if overrides then
		for id, o in overrides do
			if base[id] then
				for k, v in o do
					base[id][k] = v
				end
			else
				base[id] = o
			end
		end
	end
	for id, def in base do
		def.id = id
		out[id] = M(def)
	end
	return out
end

