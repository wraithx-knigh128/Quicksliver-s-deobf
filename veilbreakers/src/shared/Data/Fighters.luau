local function super(name: string, anim: string, cinematic: string, reach: number?): { [string]: any }
	return {
		name = name,
		input = "SUPER (2 bars)",
		kind = "super",
		anim = anim,
		startup = 9,
		active = 4,
		recovery = 42,
		damage = 300,
		guard = "mid",
		onHit = 0,
		onBlock = -30,
		push = 0,
		box = { x = 1.9 + (reach or 0), y = 3.0, w = 2.6 + (reach or 0) * 2, h = 4.2 },
		invuln = { 1, 13 },
		cost = 200,
		cinematic = cinematic,
		sfx = "super_start",
		hitSfx = "hit_heavy",
	}
end

