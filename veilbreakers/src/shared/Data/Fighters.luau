local Fighters = {}
Fighters.list = list
Fighters.byId = {} :: { [string]: Fighter }
for i, f in list do
	Fighters.byId[f.id] = f
	;(f :: any).index = i
end

Fighters.selectable = {} :: { string }
for _, f in list do
	table.insert(Fighters.selectable, f.id)
end

function Fighters.get(id: string): Fighter
	local f = Fighters.byId[id]
	assert(f, "unknown fighter " .. tostring(id))
	return f
end

return Fighters
