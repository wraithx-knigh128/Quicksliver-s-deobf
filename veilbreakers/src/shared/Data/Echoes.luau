local Echoes = {}
Echoes.list = list
Echoes.byId = {} :: { [string]: Echo }
for _, e in list do
	Echoes.byId[e.id] = e
end

function Echoes.get(id: string): Echo
	local e = Echoes.byId[id]
	assert(e, "unknown echo " .. tostring(id))
	return e
end

return Echoes
