-- Victory poses per style
local WIN = {
	blade = merge(LEGS.tall, { UT = { 8, 10, 0 }, H = { 12, -10, 0 } }, {
		RUA = { 176, 0, 14 },
		RLA = { 4, 0, 0 },
		RH = { 0, 0, 0 },
		LUA = { 10, 0, -14 },
