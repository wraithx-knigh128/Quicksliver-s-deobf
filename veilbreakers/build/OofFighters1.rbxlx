		n.JH.anim = "air_slash"
	else
		n.H.anim = "hook"
		n.H.name = "Haymaker"
		n.FH.anim = "hammer_fist"
		n.JH.anim = "air_slam"
	end
	return n
end

local function apply(base: { [string]: any }, overrides: { [string]: any }?): { [string]: MoveKit.Move }
	local out: { [string]: MoveKit.Move } = {}
	if overrides then
		for id, o in overrides do
			if base[id] then
				for k, v in o do
					base[id][k] = v
				end
			else
				base[id] = o
			end
		end
	end
	for id, def in base do
		def.id = id
		out[id] = M(def)
	end
	return out
end

