		n.H.box = { x = 2.7, y = 3.5, w = 3.0, h = 1.0 }
		n.FH.anim = "overhead_chop"
		n.JH.anim = "air_slash"
		n.L3.anim = "slash_rising"
	elseif style == "heavy" then
		n.H.anim = "hammer_swing"
		n.H.name = "Hammer Swing"
