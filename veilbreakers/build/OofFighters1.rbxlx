			extras = { "prayer_beads", "sash" },
			weapon = "staff",
		},
		neutral = E({
			id = "okoro_n",
			name = "Back In My Day",
			input = "ECHO",
			anim = "cast_forward",
			spawn = "behind",
			startup = 16,
			active = 1,
			recovery = 22,
			damage = 0,
			projectile = {
				kind = "seal",
				offset = { x = 1.2, y = 3.4 },
				vx = 0.36,
				life = 90,
				box = { w = 1.8, h = 1.8 },
				damage = 30,
				hits = 2,
				hitEvery = 8,
				onHit = 22,
				onBlock = 8,
				absorbs = true,
				element = "radiant",
			},
			sfx = "cast_radiant",
			element = "radiant",
		}),
		down = E({
			id = "okoro_d",
			name = "Old Man Strength",
			input = "↓ + ECHO",
			anim = "palm_strike",
			spawn = "front",
			startup = 14,
			active = 4,
			recovery = 18,
