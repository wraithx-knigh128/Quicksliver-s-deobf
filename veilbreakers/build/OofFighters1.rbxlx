            <string name="Name">Echoes</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Friends (internally "Echoes"): spectral allies summoned mid-fight. Each has a neutral and a down variant.
-- Frame counts are measured from the moment the Echo materialises.

local MoveKit = require(script.Parent.MoveKit)

export type EchoMove = {
	id: string,
	name: string,
	input: string,
	anim: string,
	spawn: string, -- "behind" | "front" | "above_opponent"
	startup: number,
	active: number,
	recovery: number,
	damage: number,
	guard: string,
	onHit: number,
	onBlock: number,
	push: number,
	box: MoveKit.Box?,
	launch: { vx: number, vy: number }?,
	knockdown: boolean?,
	hits: number?,
	hitEvery: number?,
	motion: { { from: number, to: number, vx: number, vy: number? } }?,
	projectile: MoveKit.Projectile?,
	strength: string,
	sfx: string?,
	hitSfx: string?,
	element: string?,
	shield: number?, -- frames the caller is protected from projectiles
}

export type Echo = {
	id: string,
	name: string,
	title: string,
	bio: string,
	accent: string,
	look: { [string]: any },
	neutral: EchoMove,
	down: EchoMove,
	callLine: string,
}

local function E(t: { [string]: any }): EchoMove
	t.strength = t.strength or "special"
	t.guard = t.guard or "mid"
	t.onHit = t.onHit or 10
	t.onBlock = t.onBlock or 0
	t.push = t.push or 0.25
	t.recovery = t.recovery or 18
	return (t :: any) :: EchoMove
end

local list: { Echo } = {
	{
		id = "grandpa",
		name = "GRANDPA STUDS",
		title = "Played Since Beta, Will Tell You About It",
		bio = "He remembers when everything was bricks and there was no jumping. He will tell you about it. Mid-fight. Whether you asked or not.",
		accent = "#E8C66A",
		callLine = "Back in MY day we didn't HAVE combos!",
		look = {
			scale = 1.02,
			width = 1.05,
