end
S.kneel = function()
	return merge({ root = { 0, -1.15, 0 }, ikL = { -0.6, 0, -0.95, 0 }, ikR = { 0.6, 0, 0.75, -60 } }, { UT = { -20, 0, 0 }, H = { -30, 0, 0 } }, {
		RUA = { 20, 0, 6 },
