		RLA = { 90, 0, 0 },
		LUA = { 30, 0, 10 },
		LLA = { 90, 0, 0 },
	})
end
S.hit_low = function()
	return merge(LEGS.crouch, { root = { 0, -0.9, 0.2 }, UT = { -18, 0, 12 }, H = { 10, 0, 0 } }, {
		RUA = { 10, 0, 40 },
		RLA = { 30, 0, 0 },
		LUA = { 10, 0, -40 },
		LLA = { 30, 0, 0 },
	})
end
S.juggle = function()
	return merge({ root = { 0, 0, 0, 52, 0, 0 } }, { UT = { 20, 0, 0 }, H = { 30, 0, 0 } }, {
		RUA = { 150, 0, 40 },
		RLA = { 30, 0, 0 },
		LUA = { 140, 0, -40 },
		LLA = { 40, 0, 0 },
		RUL = { 50, 0, 6 },
		RLL = { -50, 0, 0 },
		LUL = { 30, 0, -6 },
