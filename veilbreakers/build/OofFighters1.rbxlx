	}),
	pole = merge(LEGS.tall, { UT = { 4, 0, 0 }, H = { 10, 0, 0 } }, {
		RUA = { 30, 0, 26 },
		RLA = { 40, 0, 0 },
		RH = { -88, 0, 0 },
		LUA = { 60, 0, -60 },
		LLA = { 120, 0, 0 },
	}),
	heavy = merge(LEGS.wide, { UT = { 6, 20, 0 }, H = { 14, -10, 0 } }, {
		RUA = { 140, 0, 40 },
		RLA = { 120, 0, 0 },
		RH = { 50, 0, 0 },
		LUA = { 100, 0, -60 },
		LLA = { 60, 0, 0 },
	}),
	dual = merge(LEGS.stance, { UT = { 4, -20, 0 }, H = { -6, 30, 0 } }, {
		RUA = { 60, 0, -50 },
		RLA = { 100, 0, 0 },
		LUA = { 60, 0, 50 },
		LLA = { 100, 0, 0 },
	}),
	unarmed = merge(LEGS.tall, { UT = { 10, 0, 0 }, H = { 16, 0, 0 } }, {
		RUA = { 172, 0, 10 },
		RLA = { 10, 0, 0 },
		LUA = { 30, 0, -20 },
		LLA = { 110, 0, 0 },
	}),
	ranged = merge(LEGS.tall, { UT = { 4, 20, 0 }, H = { 6, -20, 0 } }, {
		RUA = { 150, 0, 30 },
		RLA = { 130, 0, 0 },
		RH = { 40, 0, 0 },
		LUA = { 20, 0, -14 },
		LLA = { 60, 0, 0 },
	}),
}
Poses.WIN = WIN

-------------------------------------------------------------------------------
-- Super cinematic sequences (anim names played back-to-back)
-------------------------------------------------------------------------------

Poses.SuperSequence = {
	blade = { "lunge_slash", "slash_diag", "slash_rising", "lunge_slash", "overhead_chop" },
	pole = { "thrust", "slash_diag", "thrust_lunge", "slash_rising", "overhead_chop" },
	heavy = { "hammer_swing", "uppercut", "hammer_swing", "ground_pound", "hammer_slam" },
	dual = { "dual_stab", "dual_flurry", "spin_kick", "dual_flurry", "veil_drop" },
	unarmed = { "jab", "cross", "hook", "uppercut", "hammer_fist" },
	ranged = { "butt_strike", "shoot", "kick_front", "shoot", "shoot" },
}

-------------------------------------------------------------------------------
-- Sampling
-------------------------------------------------------------------------------

local function lerpVec(a, b, t)
	if a == nil and b == nil then
		return nil
	end
	a = a or { 0, 0, 0, 0, 0, 0 }
	b = b or { 0, 0, 0, 0, 0, 0 }
	local n = math.max(#a, #b)
	local out = table.create(n)
	for i = 1, n do
		local x = a[i] or 0
		local y = b[i] or 0
		out[i] = x + (y - x) * t
	end
	return out
end

local POSE_KEYS = { "root", "LT", "UT", "H", "RUA", "RLA", "RH", "LUA", "LLA", "LH", "RUL", "RLL", "RF", "LUL", "LLL", "LF" }
Poses.POSE_KEYS = POSE_KEYS

function Poses.lerp(a, b, t: number)
	if t <= 0 then
		return a
	elseif t >= 1 then
		return b
	end
	local out = {}
	for _, k in POSE_KEYS do
		out[k] = lerpVec(a[k], b[k], t)
	end
	-- leg IK: blend targets when both have them; otherwise snap at halfway
	for _, k in { "ikL", "ikR" } do
		if a[k] and b[k] then
			out[k] = lerpVec(a[k], b[k], t)
		elseif t < 0.5 then
			out[k] = a[k]
		else
			out[k] = b[k]
		end
		if out[k] == nil then
			-- FK legs: blend the leg angles
			local side = k == "ikL" and "L" or "R"
			for _, part in { "UL", "LL", "F" } do
				local key = side .. part
				out[key] = lerpVec(a[key], b[key], t)
			end
		end
	end
	return out
end

local function ease(t: number): number
	return t * t * (3 - 2 * t)
end
local function easeOut(t: number): number
	return 1 - (1 - t) * (1 - t)
end
local function easeIn(t: number): number
	return t * t
end
Poses.ease = ease

-- Attack animation at frame `t` of a move with the given frame data.
function Poses.attack(name: string, style: string, t: number, startup: number, active: number, recovery: number)
	local def = A[name] or A.jab
	local stance = Poses.stance(style)
	local wind = def.wind
	local hit = def.hit
	local windEnd = math.max(1, math.floor(startup * 0.65))
	local pose
	local extra = nil
	if t <= windEnd then
		pose = Poses.lerp(stance, wind, easeOut(t / windEnd))
	elseif t <= startup then
		local k = (t - windEnd) / math.max(1, startup - windEnd)
		if def.air and k < 0.85 then
			pose = Poses.lerp(wind, def.air, easeOut(k / 0.85))
		else
			pose = Poses.lerp(def.air or wind, hit, easeIn(k))
		end
	elseif t <= startup + active then
		if def.hit2 then
			local k = (t - startup) / math.max(1, active)
			local cyc = math.floor(k * 5) % 2
			pose = cyc == 0 and hit or def.hit2
		elseif def.hold then
			local k = (t - startup) / math.max(1, active)
			pose = Poses.lerp(wind, hit, 0.5 + 0.5 * math.sin(k * math.pi * 4))
		else
			pose = hit
		end
	else
		local k = (t - startup - active) / math.max(1, recovery)
		pose = Poses.lerp(hit, stance, ease(math.clamp(k, 0, 1)))
	end
	if def.spin and t > windEnd then
		local k = math.clamp((t - windEnd) / math.max(1, startup + active - windEnd), 0, 1)
		extra = { spin = def.spin * easeOut(k) }
	end
	if def.flip and t > windEnd then
		local k = math.clamp((t - windEnd) / math.max(1, startup + active + recovery * 0.5 - windEnd), 0, 1)
		extra = { flip = def.flip * ease(k) }
	end
	if extra then
		pose = table.clone(pose)
		local r = pose.root and table.clone(pose.root) or { 0, 0, 0, 0, 0, 0 }
		for i = #r + 1, 6 do
			r[i] = 0
		end
		if extra.spin then
			r[5] = (r[5] or 0) + extra.spin
		end
		if extra.flip then
			r[4] = (r[4] or 0) + extra.flip
		end
		pose.root = r
	end
	return pose
end

-- Walk cycle: stepping IK targets around the stance.
function Poses.walk(style: string, phase: number, dir: number)
	local base = Poses.stance(style)
	local p = table.clone(base)
	local s = math.sin(phase)
	local c = math.cos(phase)
	local stride = 0.38 * dir
	local lift = 0.28
	local L = base.ikL
	local R = base.ikR
	p.ikL = { L[1], math.max(0, s) * lift, L[3] - s * stride, 0 }
	p.ikR = { R[1], math.max(0, -s) * lift, R[3] + s * stride, 0 }
	local r = base.root
	p.root = { r[1], r[2] + math.abs(c) * 0.06, r[3] }
	return p
end

-- Idle breathing on top of the stance.
function Poses.idle(style: string, time: number)
	local p = table.clone(Poses.stance(style))
	local b = math.sin(time * 2.4)
	local r = p.root
	p.root = { r[1], r[2] + b * 0.04, r[3] }
	p.UT = { (p.UT[1] or 0) + b * 1.6, p.UT[2], p.UT[3] }
	if p.RUA then
		p.RUA = { p.RUA[1] + b * 2, p.RUA[2], p.RUA[3] }
	end
	if p.LUA then
		p.LUA = { p.LUA[1] - b * 2, p.LUA[2], p.LUA[3] }
	end
	return p
end

return Poses
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Rig</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Builds an R15-proportioned fighter model from a look spec (Data/Fighters.luau) and
-- poses it every frame with forward kinematics. All parts are anchored and moved with
-- BulkMoveTo, so there is no physics, no Humanoid and no replication cost.

local RigMath = require(script.Parent.RigMath)
local Looks = require(script.Parent.Looks)

local Rig = {}

local function hex(c: string): Color3
	return Color3.fromHex(c)
end
Rig.hex = hex

local function newPart(className: string?): BasePart
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end
Rig.newPart = newPart

local BONE_COLOR_KEY = {
	Head = "skin",
	UpperTorso = "torso",
	LowerTorso = "torso",
	RightUpperArm = "arms",
	RightLowerArm = "arms",
	LeftUpperArm = "arms",
	LeftLowerArm = "arms",
	RightHand = "hands",
	LeftHand = "hands",
	RightUpperLeg = "legs",
	RightLowerLeg = "legs",
	LeftUpperLeg = "legs",
	LeftLowerLeg = "legs",
	RightFoot = "feet",
	LeftFoot = "feet",
}
local BONE_MAT_KEY = {
	UpperTorso = "torsoMat",
	LowerTorso = "torsoMat",
	RightUpperArm = "armsMat",
	RightLowerArm = "armsMat",
	LeftUpperArm = "armsMat",
	LeftLowerArm = "armsMat",
	RightUpperLeg = "legsMat",
	RightLowerLeg = "legsMat",
	LeftUpperLeg = "legsMat",
	LeftLowerLeg = "legsMat",
}

local function material(name: string?): Enum.Material
	if name and (Enum.Material :: any)[name] then
		return (Enum.Material :: any)[name]
	end
	return Enum.Material.SmoothPlastic
end
Rig.material = material

-- opts: { name: string?, spectral: Color3?, world: WorldRoot? }
function Rig.build(look, opts)
	opts = opts or {}
	local s = look.scale or 1
	local w = look.width or 1
	local sk = RigMath.skeleton(s, w)
	local model = Instance.new("Model")
	model.Name = opts.name or "Fighter"

	local rig = {
		model = model,
		sk = sk,
		look = look,
		scale = s,
		parts = {},
		attached = {},
		allParts = {},
		glow = {},
		trails = {},
		lights = {},
		world = opts.world or workspace,
		poseCache = {},
		transparency = 0,
		baseT = {},
		decals = {},
	}

	for _, name in sk.order do
		local b = sk.bones[name]
		local p = newPart()
		p.Name = name
		p.Size = b.size
		local colorKey = BONE_COLOR_KEY[name]
		p.Color = hex(look[colorKey] or "#888888")
		p.Material = material(look[BONE_MAT_KEY[name] or ""] )
		if name == "Head" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Head
			mesh.Scale = Vector3.new(1, 1, 1)
			mesh.Parent = p
			p.Material = Enum.Material.SmoothPlastic
		elseif name == "RightHand" or name == "LeftHand" or name == "RightFoot" or name == "LeftFoot" then
			p.Material = material(look[BONE_MAT_KEY[name] or ""] or "SmoothPlastic")
		end
		p.Parent = model
		rig.parts[name] = p
		table.insert(rig.allParts, p)
	end
	model.PrimaryPart = rig.parts.LowerTorso

	-- Accessory helper handed to Looks: attach(bone, size, offsetCF, color, materialName, extra)
	local function attach(bone: string, size: Vector3, offset: CFrame, color, matName: string?, extra)
		extra = extra or {}
		local p = newPart(extra.class)
		p.Name = extra.name or (bone .. "_acc")
		if extra.class ~= "WedgePart" and extra.class ~= "CornerWedgePart" and extra.shape then
			p.Shape = extra.shape
		end
		p.Size = size * s
		if typeof(color) == "string" then
			p.Color = hex(color)
		else
			p.Color = color
		end
		p.Material = material(matName)
		if extra.transparency then
			p.Transparency = extra.transparency
		end
		if extra.reflectance then
			p.Reflectance = extra.reflectance
		end
		if extra.mesh then
			local m = Instance.new("SpecialMesh")
			m.MeshType = extra.mesh
			m.Parent = p
		end
		p.CastShadow = extra.shadow ~= false
		p.Parent = model
		local pos = offset.Position * s
		local entry = {
			part = p,
			bone = bone,
			offset = CFrame.new(pos) * offset.Rotation,
			swing = extra.swing,
			baseTransparency = p.Transparency,
		}
		if extra.swing and extra.swing.pivot then
			entry.pivot = extra.swing.pivot * s
		end
		table.insert(rig.attached, entry)
		table.insert(rig.allParts, p)
		rig.baseT[p] = p.Transparency
		if extra.glow then
			table.insert(rig.glow, p)
		end
		return p
	end

	Looks.apply(rig, look, attach)

	if opts.spectral then
		Rig.makeSpectral(rig, opts.spectral)
	end

	-- buffers for BulkMoveTo
	rig.moveParts = {}
	for _, name in sk.order do
		table.insert(rig.moveParts, rig.parts[name])
	end
	for _, a in rig.attached do
		table.insert(rig.moveParts, a.part)
	end
	rig.moveCFrames = table.create(#rig.moveParts, CFrame.identity)

	model:SetAttribute("VeilRig", true)
	return rig
end

function Rig.makeSpectral(rig, color: Color3)
	for _, p in rig.allParts do
		p.Material = Enum.Material.ForceField
		p.Color = color
		p.CastShadow = false
	end
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 0.82
	hl.FillColor = color
	hl.OutlineColor = color
	hl.OutlineTransparency = 0.15
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = rig.model
	rig.spectral = hl
end

local bulkOk = true

-- Pose the rig. motion = { time, vx, vy } drives cloth / hair sway.
function Rig.apply(rig, rootCF: CFrame, pose, motion)
	local sk = rig.sk
	local bones = RigMath.solve(sk, rootCF, pose, rig.poseCache)
	local cfs = rig.moveCFrames
	local i = 0
	for _, name in sk.order do
		i += 1
		cfs[i] = bones[name]
	end
	local t = motion and motion.time or 0
	local vx = motion and motion.vx or 0
	local vy = motion and motion.vy or 0
	for _, a in rig.attached do
		i += 1
		local boneCF = bones[a.bone]
		local sw = a.swing
		if sw then
			local ang = (sw.base or 0)
				+ math.sin(t * (sw.speed or 3) + (sw.phase or 0)) * (sw.amp or 6)
				+ math.clamp(vx * (sw.vel or 40), -35, 35)
				+ math.clamp(-vy * (sw.velY or 30), -25, 25)
			local piv = a.pivot or Vector3.zero
			local r = sw.axis == "z" and CFrame.Angles(0, 0, math.rad(ang)) or CFrame.Angles(math.rad(ang), 0, 0)
			cfs[i] = boneCF * CFrame.new(piv) * r * CFrame.new(-piv) * a.offset
		else
			cfs[i] = boneCF * a.offset
		end
	end
	if bulkOk then
		local ok = pcall(function()
			rig.world:BulkMoveTo(rig.moveParts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		if not ok then
			bulkOk = false
		end
	end
	if not bulkOk then
		for k, p in rig.moveParts do
			p.CFrame = cfs[k]
		end
	end
	rig.lastBones = bones
end

-- World position of a bone (after the last apply)
function Rig.bonePosition(rig, bone: string): Vector3
	local b = rig.lastBones and rig.lastBones[bone]
	if b then
		return b.Position
	end
	return rig.model:GetPivot().Position
end

function Rig.setTransparency(rig, t: number)
	if rig.transparency == t then
		return
	end
	rig.transparency = t
	for _, p in rig.allParts do
		p.Transparency = math.max(rig.baseT[p] or 0, t)
	end
	for _, d in rig.decals do
		d.Transparency = t
	end
end

function Rig.setTrails(rig, enabled: boolean)
	for _, tr in rig.trails do
		tr.Enabled = enabled
	end
end

function Rig.setVisible(rig, visible: boolean)
	rig.model.Parent = visible and (rig.parentWhenVisible or workspace) or nil
end

function Rig.destroy(rig)
	rig.model:Destroy()
end

return Rig
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">RigMath</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Skeleton definition + forward kinematics + leg IK for OOF FIGHTERS 1 fighters.
-- Pure CFrame math (no Instances) so poses can be evaluated headless for previews.
--
-- Rig space: origin on the floor between the feet, +Y up, facing -Z (Roblox
-- convention), +X is the fighter's right-hand side. Proportions follow R15.

local RigMath = {}

-- name, parent, size, joint position in parent space, joint position in child space
-- (unscaled; scale `s` and torso width `w` are applied in RigMath.skeleton)
local function boneDefs(w: number)
	local armX = w + 0.47
	local legX = 0.5 * w
	return {
		{ "LowerTorso", nil, Vector3.new(2 * w, 0.55, 1.0 * w), Vector3.new(0, 2.35, 0), Vector3.new(0, 0, 0) },
		{ "UpperTorso", "LowerTorso", Vector3.new(2 * w, 1.55, 1.0 * w), Vector3.new(0, 0.275, 0), Vector3.new(0, -0.775, 0) },
		{ "Head", "UpperTorso", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 0.775, 0), Vector3.new(0, -0.62, 0) },
		{ "RightUpperArm", "UpperTorso", Vector3.new(0.95, 0.95, 0.95), Vector3.new(armX, 0.52, 0), Vector3.new(0, 0.3, 0) },
		{ "RightLowerArm", "RightUpperArm", Vector3.new(0.9, 0.86, 0.9), Vector3.new(0, -0.47, 0), Vector3.new(0, 0.4, 0) },
		{ "RightHand", "RightLowerArm", Vector3.new(0.84, 0.42, 0.84), Vector3.new(0, -0.43, 0), Vector3.new(0, 0.19, 0) },
		{ "LeftUpperArm", "UpperTorso", Vector3.new(0.95, 0.95, 0.95), Vector3.new(-armX, 0.52, 0), Vector3.new(0, 0.3, 0) },
		{ "LeftLowerArm", "LeftUpperArm", Vector3.new(0.9, 0.86, 0.9), Vector3.new(0, -0.47, 0), Vector3.new(0, 0.4, 0) },
		{ "LeftHand", "LeftLowerArm", Vector3.new(0.84, 0.42, 0.84), Vector3.new(0, -0.43, 0), Vector3.new(0, 0.19, 0) },
		{ "RightUpperLeg", "LowerTorso", Vector3.new(0.98, 0.98, 0.98), Vector3.new(legX, -0.25, 0), Vector3.new(0, 0.46, 0) },
		{ "RightLowerLeg", "RightUpperLeg", Vector3.new(0.9, 0.94, 0.9), Vector3.new(0, -0.465, 0), Vector3.new(0, 0.45, 0) },
		{ "RightFoot", "RightLowerLeg", Vector3.new(0.9, 0.28, 1.15), Vector3.new(0, -0.45, 0), Vector3.new(0, 0.135, 0.1) },
		{ "LeftUpperLeg", "LowerTorso", Vector3.new(0.98, 0.98, 0.98), Vector3.new(-legX, -0.25, 0), Vector3.new(0, 0.46, 0) },
		{ "LeftLowerLeg", "LeftUpperLeg", Vector3.new(0.9, 0.94, 0.9), Vector3.new(0, -0.465, 0), Vector3.new(0, 0.45, 0) },
		{ "LeftFoot", "LeftLowerLeg", Vector3.new(0.9, 0.28, 1.15), Vector3.new(0, -0.45, 0), Vector3.new(0, 0.135, 0.1) },
	}
end

-- Short pose keys -> bone names
RigMath.Keys = {
	LT = "LowerTorso",
	UT = "UpperTorso",
	H = "Head",
	RUA = "RightUpperArm",
	RLA = "RightLowerArm",
	RH = "RightHand",
	LUA = "LeftUpperArm",
	LLA = "LeftLowerArm",
	LH = "LeftHand",
	RUL = "RightUpperLeg",
	RLL = "RightLowerLeg",
	RF = "RightFoot",
	LUL = "LeftUpperLeg",
	LLL = "LeftLowerLeg",
	LF = "LeftFoot",
}

function RigMath.skeleton(scale: number, width: number)
	local s = scale
	local defs = boneDefs(width)
	local sk = { scale = s, width = width, bones = {}, order = {} }
	for _, d in defs do
		local name, parent, size, jp, jc = d[1], d[2], d[3], d[4], d[5]
		local b = {
			name = name,
			parent = parent,
			size = size * s,
			c0 = CFrame.new(jp * s),
			c1inv = CFrame.new(-jc * s),
		}
		sk.bones[name] = b
		table.insert(sk.order, name)
	end
	-- leg lengths for IK
	sk.thigh = 0.925 * s
	sk.shin = 0.9 * s
	sk.ankle = 0.275 * s
	sk.hipHeight = 2.35 * s
	return sk
end

local rad = math.rad

local function rot(v): CFrame
	if v == nil then
		return CFrame.identity
	end
	return CFrame.Angles(rad(v[1] or 0), rad(v[2] or 0), rad(v[3] or 0))
end
RigMath.rot = rot

-- Two-bone leg IK in the LowerTorso's local frame.
-- Returns hip {rx, 0, rz}, knee {rx}, foot {rx, 0, rz} in degrees.
local function solveLeg(sk, ltCF: CFrame, hipLocal: Vector3, targetWorld: Vector3, footPitch: number)
	local hipWorld = ltCF:PointToWorldSpace(hipLocal)
	local v = ltCF:VectorToObjectSpace(targetWorld - hipWorld)
	local a, b = sk.thigh, sk.shin
	local L = v.Magnitude
	L = math.clamp(L, math.abs(a - b) + 0.05, a + b - 0.002)
	local cosK = math.clamp((a * a + b * b - L * L) / (2 * a * b), -1, 1)
	local k = math.pi - math.acos(cosK)
	local cosA = math.clamp((a * a + L * L - b * b) / (2 * a * L), -1, 1)
	local alpha = math.acos(cosA)
	local phi = math.atan2(-v.Z, -v.Y)
	local hipRx = phi + alpha
	local kneeRx = -k
	local rz = math.asin(math.clamp(v.X / math.max(L, 0.001), -0.9, 0.9))
	-- keep the sole parallel to the floor: undo LowerTorso pitch too
	local _, _, _ = ltCF:ToOrientation()
	local ltLook = ltCF.LookVector
	local ltPitch = math.asin(math.clamp(ltLook.Y, -1, 1)) -- forward lean (look down -> negative)
	local footRx = -(hipRx + kneeRx) - ltPitch + rad(footPitch or 0)
	return { math.deg(hipRx), 0, math.deg(rz) }, { math.deg(kneeRx), 0, 0 }, { math.deg(footRx), 0, -math.deg(rz) }
end

-- Evaluate a pose into world CFrames for every bone.
-- pose: { root = {x,y,z, rx,ry,rz}, LT = {rx,ry,rz}, ..., ikL = {x,y,z,p}, ikR = {...} }
-- ik targets are in rig space (relative to rootCF, on the floor), p = toe pitch in degrees.
function RigMath.solve(sk, rootCF: CFrame, pose, out)
	out = out or {}
	local r = pose.root
	local hip = sk.hipHeight
	local base = rootCF
	if r then
		base = rootCF
			* CFrame.new(0, hip, 0)
			* CFrame.new((r[1] or 0) * sk.scale, (r[2] or 0) * sk.scale, (r[3] or 0) * sk.scale)
			* CFrame.Angles(rad(r[4] or 0), rad(r[5] or 0), rad(r[6] or 0))
			* CFrame.new(0, -hip, 0)
	end
	local bones = sk.bones
	-- lower torso
	local lt = bones.LowerTorso
	local ltCF = base * lt.c0 * rot(pose.LT) * lt.c1inv
	out.LowerTorso = ltCF
	local legAngles = {}
	if pose.ikL or pose.ikR then
		for side, key in { L = "ikL", R = "ikR" } do
			local t = pose[key]
			if t then
				local prefix = side == "L" and "Left" or "Right"
				local ul = bones[prefix .. "UpperLeg"]
				local hipLocal = ul.c0.Position
				local target = rootCF:PointToWorldSpace(Vector3.new((t[1] or 0) * sk.scale, (t[2] or 0) * sk.scale + sk.ankle, (t[3] or 0) * sk.scale))
				local h, k, f = solveLeg(sk, ltCF, hipLocal, target, t[4] or 0)
				legAngles[prefix .. "UpperLeg"] = h
				legAngles[prefix .. "LowerLeg"] = k
				legAngles[prefix .. "Foot"] = f
			end
		end
	end
	local keyOf = RigMath.BoneKey
	for _, name in sk.order do
		if name ~= "LowerTorso" then
			local b = bones[name]
			local parentCF = out[b.parent]
			local angles = legAngles[name] or pose[keyOf[name]]
			out[name] = parentCF * b.c0 * rot(angles) * b.c1inv
		end
	end
	return out
end

RigMath.BoneKey = {}
for k, v in RigMath.Keys do
	RigMath.BoneKey[v] = k
end

return RigMath
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">StageBuilder</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Builds the arenas: a matte-painted backdrop (ForgeGUI art) far behind the lane,
-- 3D mid-ground set dressing, foreground silhouettes, lighting, post-processing and
-- ambient particles. Everything created is tagged and cleaned up by StageBuilder.clear.

local Lighting = game:GetService("Lighting")

local Veil = game:GetService("ReplicatedStorage"):WaitForChild("Veil")
local Assets = require(Veil.Assets)
local Stages = require(Veil.Data.Stages)

local StageBuilder = {}

local V = Vector3.new
local C = CFrame.new
local A = CFrame.Angles
local rad = math.rad

local current = nil

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

local function part(parent: Instance, props)
	local p = Instance.new(props.class or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.shape and p:IsA("Part") then
		p.Shape = props.shape
	end
	p.Size = props.size or V(1, 1, 1)
	p.CFrame = props.cf or C()
	p.Color = typeof(props.color) == "string" and hex(props.color) or (props.color or Color3.new(0.5, 0.5, 0.5))
	p.Material = props.material or Enum.Material.SmoothPlastic
	if props.transparency then
		p.Transparency = props.transparency
	end
	if props.reflectance then
		p.Reflectance = props.reflectance
	end
	p.CastShadow = props.shadow ~= false
	p.Name = props.name or "Prop"
	p.Parent = parent
	return p
end

local function light(parent: Instance, color, brightness: number, range: number, shadows: boolean?)
	local l = Instance.new("PointLight")
	l.Color = typeof(color) == "string" and hex(color) or color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = shadows == true
	l.Parent = parent
	return l
end

local function seq(a: number, b: number, c: number?)
	if c then
		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, a),
			NumberSequenceKeypoint.new(0.5, b),
			NumberSequenceKeypoint.new(1, c),
		})
	end
	return NumberSequence.new(a, b)
end
StageBuilder.seq = seq

local function emitter(parent: Instance, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = props.texture or Assets.Particles.Spark
	e.Rate = props.rate or 10
	e.Lifetime = props.lifetime or NumberRange.new(2, 4)
	e.Speed = props.speed or NumberRange.new(0.5, 1.5)
	e.SpreadAngle = props.spread or Vector2.new(30, 30)
	e.Size = props.sizeSeq or seq(props.size or 0.3, 0)
	e.Transparency = props.transparencySeq or seq(0.2, 1)
	e.Color = props.colorSeq or ColorSequence.new(typeof(props.color) == "string" and hex(props.color) or (props.color or Color3.new(1, 1, 1)))
	e.LightEmission = props.lightEmission or 1
	e.LightInfluence = props.lightInfluence or 0
	e.Acceleration = props.accel or V(0, 0, 0)
	e.Drag = props.drag or 0
	e.RotSpeed = props.rotSpeed or NumberRange.new(-30, 30)
	e.Rotation = NumberRange.new(0, 360)
	e.EmissionDirection = props.dir or Enum.NormalId.Top
	e.ZOffset = props.zoffset or 0
	e.LockedToPart = props.locked == true
	e.Parent = parent
	return e
end
StageBuilder.emitter = emitter

-------------------------------------------------------------------------------
-- Lighting presets
-------------------------------------------------------------------------------

local function applyLighting(stage, theme: string, made: { Instance })
	Lighting.ClockTime = stage.clockTime
	Lighting.Ambient = hex(stage.ambient)
	Lighting.OutdoorAmbient = hex(stage.ambient)
	Lighting.FogColor = hex(stage.fogColor)
	Lighting.FogStart = 0
	Lighting.FogEnd = 100000
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.ExposureCompensation = 0

	for _, child in Lighting:GetChildren() do
		if child:GetAttribute("VeilStage") or child:IsA("Sky") or child:IsA("Atmosphere") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end

	local function add(inst: Instance)
		inst:SetAttribute("VeilStage", true)
		inst.Parent = Lighting
		table.insert(made, inst)
		return inst
	end

	local atmo = Instance.new("Atmosphere")
	atmo.Color = hex(stage.fogColor)
	atmo.Decay = hex(stage.fogColor)
	atmo.Density = 0.3
	atmo.Offset = 0.15
	atmo.Glare = 0
	atmo.Haze = 1.2

	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.StarCount = 3000
	sky.MoonAngularSize = 14
	sky.SunAngularSize = 12

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.9
	bloom.Size = 30
	bloom.Threshold = 1.6

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "StageGrade"
	cc.Contrast = 0.12
	cc.Saturation = -0.05
	cc.Brightness = 0
	cc.TintColor = Color3.new(1, 1, 1)

	local dof = Instance.new("DepthOfFieldEffect")
	dof.FarIntensity = 0.28
	dof.FocusDistance = 21
	dof.InFocusRadius = 16
	dof.NearIntensity = 0.6

	local rays = nil

	if theme == "forest" then
		Lighting.Brightness = 1.2
		Lighting.ColorShift_Top = hex("#7FA88A")
		Lighting.ColorShift_Bottom = hex("#1C2A20")
		atmo.Density = 0.38
		atmo.Haze = 2.2
		atmo.Color = hex("#4A6A58")
		atmo.Decay = hex("#1A2A22")
		cc.TintColor = hex("#D6F0DC")
		cc.Saturation = -0.12
		cc.Contrast = 0.16
	elseif theme == "monastery" then
		Lighting.Brightness = 2.4
		Lighting.ColorShift_Top = hex("#FFB070")
		Lighting.ColorShift_Bottom = hex("#3A2A3A")
		atmo.Density = 0.3
		atmo.Haze = 1.6
		atmo.Glare = 0.6
		atmo.Color = hex("#C99A8A")
		atmo.Decay = hex("#6A5A7A")
		cc.TintColor = hex("#FFE8D6")
		cc.Saturation = 0.05
		rays = Instance.new("SunRaysEffect")
		rays.Intensity = 0.12
		rays.Spread = 0.6
	elseif theme == "cathedral" then
		Lighting.Brightness = 0.9
		Lighting.ColorShift_Top = hex("#8A9AFF")
		Lighting.ColorShift_Bottom = hex("#1A1A2A")
		atmo.Density = 0.34
		atmo.Haze = 1.8
		atmo.Color = hex("#3A3A6A")
		atmo.Decay = hex("#151A2A")
		cc.TintColor = hex("#DCD8FF")
		cc.Saturation = -0.1
		sky.MoonAngularSize = 22
	elseif theme == "volcano" then
		Lighting.Brightness = 1.0
		Lighting.ColorShift_Top = hex("#FF7A3A")
		Lighting.ColorShift_Bottom = hex("#3A0A04")
		atmo.Density = 0.36
		atmo.Haze = 2.4
		atmo.Glare = 0.4
		atmo.Color = hex("#8A2A12")
		atmo.Decay = hex("#2A0A04")
		cc.TintColor = hex("#FFD8C8")
		cc.Saturation = 0.08
		cc.Contrast = 0.18
		sky.StarCount = 0
	elseif theme == "baseplate" then
		Lighting.Brightness = 2.8
		Lighting.ColorShift_Top = hex("#FFFFFF")
		Lighting.ColorShift_Bottom = hex("#000000")
		Lighting.EnvironmentDiffuseScale = 1
		atmo.Density = 0.22
		atmo.Haze = 0.6
		atmo.Color = hex("#C8E0F5")
		atmo.Decay = hex("#9FC3E6")
		cc.TintColor = hex("#FFFFFF")
		cc.Contrast = 0.04
		cc.Saturation = 0.05
		dof.FarIntensity = 0.12
		sky.StarCount = 0
		rays = Instance.new("SunRaysEffect")
		rays.Intensity = 0.06
		rays.Spread = 0.5
	else
		Lighting.Brightness = 1.4
		Lighting.ColorShift_Top = hex("#C9B88A")
		Lighting.ColorShift_Bottom = hex("#101114")
		atmo.Density = 0.25
		atmo.Color = hex("#2A2A30")
		atmo.Decay = hex("#101114")
		cc.TintColor = hex("#F2EEE6")
	end

	add(atmo)
	add(sky)
	add(bloom)
	add(cc)
	add(dof)
	if rays then
		add(rays)
	end
	return { grade = cc, bloom = bloom, dof = dof, atmosphere = atmo }
end

-------------------------------------------------------------------------------
-- Shared set-dressing pieces
-------------------------------------------------------------------------------

local function floor(model, stage, _theme)
	local f = part(model, {
		name = "Floor",
		size = V(220, 2, 70),
		cf = C(0, -1, -12),
		color = stage.floorColor,
		material = (Enum.Material :: any)[stage.floorMaterial] or Enum.Material.Slate,
	})
	-- solid so finisher debris (Roblox-style break apart) lands on it
	f.CanCollide = true
	-- lane strip: slightly different tone under the fighters
	part(model, {
		name = "Lane",
		size = V(90, 0.08, 9),
		cf = C(0, 0.0, 0),
		color = Color3.fromHex(stage.floorColor):Lerp(Color3.new(0, 0, 0), 0.15),
		material = (Enum.Material :: any)[stage.floorMaterial] or Enum.Material.Slate,
		shadow = false,
	})
	return f
end

local function backdrop(model, stage)
	local id = Assets.image(stage.backdrop)
	if id == "" then
		return nil
	end
	local p = part(model, {
		name = "Backdrop",
		size = V(250, 141, 1),
		cf = C(0, 26, -100),
		color = Color3.new(0, 0, 0),
		transparency = 1,
		shadow = false,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 6
	gui.LightInfluence = 0
	gui.Brightness = 1.05
	gui.AlwaysOnTop = false
	gui.Parent = p
	local img = Instance.new("ImageLabel")
	img.Size = UDim2.fromScale(1, 1)
	img.BackgroundTransparency = 1
	img.Image = id
	img.ScaleType = Enum.ScaleType.Crop
	img.Parent = gui
	return p
end

local function rock(model, cf: CFrame, size: Vector3, color: string)
	return part(model, { size = size, cf = cf, color = color, material = Enum.Material.Rock })
end

local function tree(model, x: number, z: number, height: number, thick: number, bark: string, seed: number)
	local trunk = part(model, {
		name = "Trunk",
		size = V(height, thick, thick),
		cf = C(x, height / 2 - 0.5, z) * A(0, 0, rad(90)) * A(rad(seed * 37 % 20 - 10), 0, 0),
		shape = Enum.PartType.Cylinder,
		color = bark,
		material = Enum.Material.Wood,
	})
	-- flared roots
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2 + seed
		part(model, {
			size = V(thick * 0.45, thick * 1.2, thick * 0.45),
			cf = C(x + math.cos(a) * thick * 0.55, thick * 0.35, z + math.sin(a) * thick * 0.55) * A(math.sin(a) * 0.6, 0, -math.cos(a) * 0.6),
			color = bark,
			material = Enum.Material.Wood,
		})
	end
	-- twisting branches
	local bx, by = x, height * 0.75
	for i = 1, 4 do
		local dir = (i % 2 == 0) and 1 or -1
		local len = height * (0.35 - i * 0.04)
		part(model, {
			size = V(len, thick * (0.35 - i * 0.05), thick * (0.35 - i * 0.05)),
			cf = C(bx + dir * len * 0.4, by + i * height * 0.05, z + (seed % 3 - 1) * 1.5) * A(0, rad(seed * 13 % 40 - 20), rad(dir * (25 + i * 8))),
			shape = Enum.PartType.Cylinder,
			color = bark,
			material = Enum.Material.Wood,
		})
	end
	return trunk
end

-------------------------------------------------------------------------------
-- Themes
-------------------------------------------------------------------------------

local THEMES = {}

THEMES.forest = function(model, _stage, _ctx)
	local bark = "#2A2018"
	-- distant + mid trees
	local positions = {
		{ -34, -26, 26, 3.4 },
		{ -20, -34, 30, 4.2 },
		{ -8, -42, 34, 5 },
		{ 10, -38, 30, 4.4 },
		{ 24, -28, 28, 3.8 },
		{ 38, -34, 32, 4.6 },
		{ -44, -16, 22, 3 },
		{ 46, -18, 24, 3.2 },
		{ -28, -55, 38, 6 },
		{ 30, -58, 40, 6.5 },
	}
	for i, p in positions do
		tree(model, p[1], p[2], p[3], p[4], bark, i)
	end
	-- the great hollow tree with a face of spirit-fire
	local hx, hz = 2, -24
	part(model, { name = "HollowTree", size = V(12, 30, 10), cf = C(hx, 14, hz) * A(0, rad(8), rad(3)), color = "#3A2C20", material = Enum.Material.Wood })
	part(model, { size = V(14, 6, 12), cf = C(hx, 2.5, hz), color = "#2E2218", material = Enum.Material.Wood })
	for _, sx in { -1, 1 } do
		local eye = part(model, {
			name = "SpiritEye",
			size = V(2.0, 1.4, 0.6),
			cf = C(hx + sx * 2.2, 18, hz + 5.2) * A(0, 0, rad(sx * -12)),
			color = "#7DFF8C",
			material = Enum.Material.Neon,
			shadow = false,
		})
		light(eye, "#63FF8A", 3, 18)
		emitter(eye, {
			texture = Assets.Particles.Fire,
			rate = 18,
			lifetime = NumberRange.new(0.8, 1.6),
			speed = NumberRange.new(0.5, 1.5),
			size = 1.6,
			color = "#63FF8A",
			accel = V(0, 2, 0),
		})
	end
	part(model, { size = V(4.5, 3.5, 0.6), cf = C(hx, 12.5, hz + 5.1), color = "#0A0806", material = Enum.Material.SmoothPlastic })
	-- spirit flames along the roots
	for i = 1, 7 do
		local fx = -30 + i * 9 + (i % 2) * 2
		local fz = -14 - (i % 3) * 3
		local anchor = part(model, { size = V(2, 0.4, 2), cf = C(fx, 0.2, fz), color = "#1A1A12", material = Enum.Material.Mud })
		emitter(anchor, {
			texture = Assets.Particles.Fire,
			rate = 22,
			lifetime = NumberRange.new(0.6, 1.4),
			speed = NumberRange.new(1, 3),
			sizeSeq = seq(1.4, 0.6, 0),
			colorSeq = ColorSequence.new(hex("#B6FF9A"), hex("#2ACC5A")),
			accel = V(0, 3, 0),
		})
		light(anchor, "#5BFF6A", 2.2, 14)
	end
	-- hanging moss curtains
	for i = 1, 14 do
		local mx = -40 + i * 6
		part(model, {
			size = V(0.4, 3 + (i % 4), 0.4),
			cf = C(mx, 13 + (i % 3) * 2, -18 - (i % 4) * 4),
			color = "#3A5230",
			material = Enum.Material.Grass,
			shadow = false,
		})
	end
	-- red wildflowers and pale mushrooms near the lane
	for i = 1, 40 do
		local fx = -42 + (i * 2.17) % 84
		local fz = -5 - ((i * 1.37) % 9)
		part(model, {
			size = V(0.32, 0.32, 0.32),
			cf = C(fx, 0.35, fz),
			shape = Enum.PartType.Ball,
			color = i % 5 == 0 and "#D8D2C0" or "#B0141E",
			material = i % 5 == 0 and Enum.Material.SmoothPlastic or Enum.Material.Neon,
			shadow = false,
		})
	end
	-- still black water pools
	for i = 1, 4 do
		part(model, {
			size = V(12, 0.1, 6),
			cf = C(-30 + i * 15, 0.06, -9 - (i % 2) * 3),
			color = "#0C1210",
			material = Enum.Material.Glass,
			reflectance = 0.35,
			transparency = 0.1,
			shadow = false,
		})
	end
	-- rocks & roots crossing behind the lane
	for i = 1, 8 do
		rock(model, C(-38 + i * 10, 0.4, -7 - (i % 3)) * A(rad(i * 23), rad(i * 41), 0), V(1.6 + i % 3, 1 + i % 2, 1.4), "#2E2A24")
	end
	-- foreground silhouettes (out of focus)
	part(model, { size = V(2.4, 26, 2.4), cf = C(-26, 12, 9) * A(0, 0, rad(-6)), color = "#0A0806", material = Enum.Material.Wood })
	part(model, { size = V(2.8, 28, 2.8), cf = C(29, 13, 10) * A(0, 0, rad(8)), color = "#0A0806", material = Enum.Material.Wood })
	part(model, { size = V(18, 1.4, 1.4), cf = C(-18, 22, 8) * A(0, 0, rad(-20)), color = "#0A0806", material = Enum.Material.Wood })
	-- floating motes & low mist
	local air = part(model, { name = "Motes", size = V(90, 12, 30), cf = C(0, 6, -12), transparency = 1, shadow = false })
	emitter(air, {
		rate = 26,
		lifetime = NumberRange.new(4, 8),
		speed = NumberRange.new(0.2, 0.6),
		size = 0.18,
		color = "#B8FF9A",
		spread = Vector2.new(180, 180),
	})
	local mist = part(model, { name = "Mist", size = V(110, 1, 26), cf = C(0, 0.6, -6), transparency = 1, shadow = false })
	emitter(mist, {
		texture = Assets.Particles.Smoke,
		rate = 8,
		lifetime = NumberRange.new(8, 12),
		speed = NumberRange.new(0.3, 0.8),
		sizeSeq = seq(6, 12),
		transparencySeq = seq(1, 0.85, 1),
		color = "#9AB8A6",
		lightEmission = 0,
		lightInfluence = 1,
		dir = Enum.NormalId.Right,
	})
end

THEMES.monastery = function(model, _stage, ctx)
	local wood = "#3A1E14"
	local roof = "#2A3A3A"
	-- courtyard stones
	for i = -9, 9 do
		part(model, {
			size = V(4.6, 0.12, 2.2),
			cf = C(i * 4.8, 0.05, -4.2),
			color = (i % 2 == 0) and "#BDB6AC" or "#AFA89E",
			material = Enum.Material.Slate,
			shadow = false,
		})
	end
	-- temple halls behind the lane
	for i, hx in { -26, 0, 26 } do
		local z = -26 - (i == 2 and 6 or 0)
		local h = i == 2 and 12 or 9
		part(model, { size = V(18, h, 8), cf = C(hx, h / 2, z), color = "#5A2A1E", material = Enum.Material.WoodPlanks })
		for k = 0, 1 do
			local w = 24 - k * 6
			local y = h + 1 + k * 4
			part(model, { class = "WedgePart", size = V(w, 3, 7), cf = C(hx, y, z - 3.5), color = roof, material = Enum.Material.Slate })
			part(model, { class = "WedgePart", size = V(w, 3, 7), cf = C(hx, y, z + 3.5) * A(0, rad(180), 0), color = roof, material = Enum.Material.Slate })
			part(model, { size = V(w + 1, 0.4, 0.6), cf = C(hx, y - 1.4, z - 6.6), color = "#C9A24A", material = Enum.Material.Metal })
		end
		for c = -2, 2 do
			part(model, { size = V(0.8, h, 0.8), cf = C(hx + c * 4, h / 2, z - 4.2), color = "#7A1E14", material = Enum.Material.Wood })
		end
		-- glowing paper lanterns
		for c = -1, 1 do
			local lan = part(model, {
				size = V(1.1, 1.4, 1.1),
				cf = C(hx + c * 5, h - 2.5, z - 5),
				shape = Enum.PartType.Ball,
				color = "#FFB25A",
				material = Enum.Material.Neon,
				shadow = false,
			})
			light(lan, "#FFB25A", 2.5, 16)
		end
	end
	-- stone railing at the cliff edge behind
	for i = -12, 12 do
		part(model, { size = V(0.8, 2.4, 0.8), cf = C(i * 3.6, 1.2, -12), color = "#8A867E", material = Enum.Material.Slate })
	end
	part(model, { size = V(90, 0.6, 0.9), cf = C(0, 2.5, -12), color = "#8A867E", material = Enum.Material.Slate })
	-- prayer flags on ropes
	ctx.flags = {}
	for row = 0, 1 do
		for i = -10, 10 do
			local colors = { "#C0392B", "#2E86C1", "#F1C40F", "#27AE60", "#ECF0F1" }
			local f = part(model, {
				size = V(1.0, 1.2, 0.05),
				cf = C(i * 2.6, 10 - math.abs(i) * 0.12 + row * 3, -14 - row * 6),
				color = colors[(i % 5) + 1],
				material = Enum.Material.Fabric,
				shadow = false,
			})
			table.insert(ctx.flags, { part = f, base = f.CFrame, phase = i * 0.7 + row })
		end
	end
	-- incense burner
	local burner = part(model, { size = V(2.4, 2, 2.4), cf = C(0, 1, -8), shape = Enum.PartType.Cylinder, color = "#5A4A2A", material = Enum.Material.Metal })
	burner.CFrame = C(0, 1, -8) * A(0, 0, rad(90))
	emitter(burner, {
		texture = Assets.Particles.Smoke,
		rate = 4,
		lifetime = NumberRange.new(4, 6),
		speed = NumberRange.new(1, 2),
		sizeSeq = seq(1, 4),
		transparencySeq = seq(0.6, 1),
		color = "#D8D0C8",
		lightEmission = 0,
		lightInfluence = 1,
		dir = Enum.NormalId.Right,
	})
	light(burner, "#FF9A4A", 1.5, 10)
	-- falling snow
	local snow = part(model, { name = "Snow", size = V(100, 1, 40), cf = C(0, 24, -6), transparency = 1, shadow = false })
	emitter(snow, {
		rate = 60,
		lifetime = NumberRange.new(6, 9),
		speed = NumberRange.new(2, 4),
		size = 0.2,
		color = "#FFFFFF",
		lightEmission = 0.3,
		lightInfluence = 1,
		accel = V(1.2, 0, 0),
		dir = Enum.NormalId.Bottom,
		spread = Vector2.new(15, 15),
	})
	-- foreground pillar silhouettes
	part(model, { size = V(2.2, 30, 2.2), cf = C(-28, 15, 10), color = "#2A0E0A", material = Enum.Material.Wood })
	part(model, { size = V(2.2, 30, 2.2), cf = C(30, 15, 10), color = "#2A0E0A", material = Enum.Material.Wood })
	part(model, { size = V(70, 1.4, 1.6), cf = C(0, 26, 10), color = "#2A0E0A", material = Enum.Material.Wood })
	local _ = wood
end

THEMES.cathedral = function(model, _stage, _ctx)
	local stone = "#3A3C46"
	-- reflective flood water around the stone lane
	part(model, {
		name = "Water",
		size = V(220, 0.2, 60),
		cf = C(0, 0.08, -32),
		color = "#0C1022",
		material = Enum.Material.Glass,
		reflectance = 0.45,
		transparency = 0.05,
		shadow = false,
	})
	-- columns
	for i = -6, 6 do
		for row = 0, 1 do
			local x = i * 9 + row * 4.5
			local z = -14 - row * 14
			local broken = (i + row) % 4 == 0
			local h = broken and (8 + (i % 3) * 3) or 30
			part(model, { size = V(h, 2.4, 2.4), cf = C(x, h / 2, z) * A(0, 0, rad(90)), shape = Enum.PartType.Cylinder, color = stone, material = Enum.Material.Slate })
			part(model, { size = V(3.4, 1.2, 3.4), cf = C(x, 0.6, z), color = "#2A2C34", material = Enum.Material.Slate })
			if not broken then
				part(model, { size = V(3.6, 1.4, 3.6), cf = C(x, h - 0.6, z), color = "#2A2C34", material = Enum.Material.Slate })
			end
		end
	end
	-- vault ribs
	for i = -3, 3 do
		part(model, { size = V(1.2, 1.2, 40), cf = C(i * 18, 34, -20) * A(rad(-8), 0, 0), color = stone, material = Enum.Material.Slate })
	end
	-- rose window (ring of glowing panes)
	local cx, cy, cz = 0, 26, -44
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		part(model, {
			size = V(3.2, 1.6, 0.4),
			cf = C(cx + math.cos(a) * 9, cy + math.sin(a) * 9, cz) * A(0, 0, a + math.pi / 2),
			color = i % 2 == 0 and "#6A5AFF" or "#B07AFF",
			material = Enum.Material.Neon,
			shadow = false,
		})
		part(model, {
			size = V(0.6, 8, 0.3),
			cf = C(cx + math.cos(a) * 4.5, cy + math.sin(a) * 4.5, cz + 0.1) * A(0, 0, a + math.pi / 2),
			color = "#2A2A3A",
			material = Enum.Material.Slate,
		})
	end
	local core = part(model, { size = V(4, 4, 0.4), cf = C(cx, cy, cz), color = "#C9B8FF", material = Enum.Material.Neon, shadow = false })
	light(core, "#9A8AFF", 4, 40)
	-- moonlight shafts
	for i = -1, 1 do
		local shaft = part(model, {
			size = V(5, 40, 5),
			cf = C(i * 14, 18, -16) * A(rad(-12), 0, rad(i * 8)),
			color = "#B8C8FF",
			material = Enum.Material.Neon,
			transparency = 0.93,
			shadow = false,
		})
		local _ = shaft
	end
	-- candles
	for i = 1, 22 do
		local x = -40 + (i * 3.9) % 80
		local z = -7 - (i % 4) * 1.8
		part(model, { size = V(0.3, 0.8 + (i % 3) * 0.3, 0.3), cf = C(x, 0.5, z), color = "#E8E0CC", material = Enum.Material.SmoothPlastic })
		local fl = part(model, { size = V(0.16, 0.3, 0.16), cf = C(x, 1.1 + (i % 3) * 0.15, z), color = "#FFC86A", material = Enum.Material.Neon, shadow = false })
		if i % 3 == 0 then
			light(fl, "#FFB25A", 1.2, 8)
		end
	end
	-- faceless statues
	for _, sx in { -1, 1 } do
		local x = sx * 22
		part(model, { size = V(3, 2, 3), cf = C(x, 1, -10), color = "#2A2C34", material = Enum.Material.Slate })
		part(model, { size = V(2.4, 6, 1.6), cf = C(x, 5, -10), color = "#4A4C56", material = Enum.Material.Marble })
		part(model, { size = V(1.4, 1.6, 1.4), cf = C(x, 8.8, -10), color = "#4A4C56", material = Enum.Material.Marble })
		part(model, { size = V(3.4, 0.4, 2.2), cf = C(x, 7.6, -10), color = "#4A4C56", material = Enum.Material.Marble })
	end
	-- hanging chains
	for i = -4, 4 do
		for k = 0, 6 do
			part(model, { size = V(0.25, 0.6, 0.25), cf = C(i * 10 + 3, 30 - k * 0.6, -12), color = "#2A2A2A", material = Enum.Material.Metal, shadow = false })
		end
	end
	-- violet arcane motes
	local air = part(model, { name = "Motes", size = V(90, 16, 30), cf = C(0, 8, -14), transparency = 1, shadow = false })
	emitter(air, {
		rate = 22,
		lifetime = NumberRange.new(5, 9),
		speed = NumberRange.new(0.2, 0.5),
		size = 0.2,
		color = "#C9A0FF",
		spread = Vector2.new(180, 180),
	})
	local mist = part(model, { name = "Mist", size = V(110, 1, 26), cf = C(0, 0.4, -10), transparency = 1, shadow = false })
	emitter(mist, {
		texture = Assets.Particles.Smoke,
		rate = 7,
		lifetime = NumberRange.new(8, 12),
		speed = NumberRange.new(0.3, 0.6),
		sizeSeq = seq(6, 12),
		transparencySeq = seq(1, 0.88, 1),
		color = "#8A8AC8",
		lightEmission = 0,
		lightInfluence = 1,
		dir = Enum.NormalId.Right,
	})
	-- foreground columns
	part(model, { size = V(34, 3, 3), cf = C(-27, 16, 10) * A(0, 0, rad(90)), shape = Enum.PartType.Cylinder, color = "#101118", material = Enum.Material.Slate })
	part(model, { size = V(34, 3, 3), cf = C(28, 16, 10) * A(0, 0, rad(90)), shape = Enum.PartType.Cylinder, color = "#101118", material = Enum.Material.Slate })
end

THEMES.volcano = function(model, _stage, ctx)
	ctx.lava = {}
	-- cracked floor with glowing seams
	for i = 1, 18 do
		local x = -44 + i * 5 + (i % 3)
		local seam = part(model, {
			size = V(3 + (i % 4), 0.06, 0.18),
			cf = C(x, 0.04, -1.5 - (i % 5) * 1.2) * A(0, rad(i * 37), 0),
			color = "#FF6A1A",
			material = Enum.Material.Neon,
			shadow = false,
		})
		table.insert(ctx.lava, seam)
	end
	-- lava river behind the lane
	local river = part(model, {
		name = "LavaRiver",
		size = V(220, 0.4, 10),
		cf = C(0, -0.1, -16),
		color = "#FF4A0A",
		material = Enum.Material.Neon,
		shadow = false,
	})
	table.insert(ctx.lava, river)
	part(model, { size = V(220, 1.2, 1.6), cf = C(0, 0.3, -10.8), color = "#1A1412", material = Enum.Material.Basalt })
	part(model, { size = V(220, 1.2, 1.6), cf = C(0, 0.3, -21.2), color = "#1A1412", material = Enum.Material.Basalt })
	for i = 1, 6 do
		local anchor = part(model, { size = V(1, 1, 1), cf = C(-40 + i * 14, 1, -16), transparency = 1, shadow = false })
		light(anchor, "#FF5A1A", 3, 22)
		emitter(anchor, {
			texture = Assets.Particles.Fire,
			rate = 6,
			lifetime = NumberRange.new(0.6, 1.2),
			speed = NumberRange.new(2, 4),
			size = 1.2,
			color = "#FF7A2A",
		})
	end
	-- the throne citadel
	part(model, { size = V(40, 26, 10), cf = C(0, 13, -40), color = "#141010", material = Enum.Material.Basalt })
	part(model, { size = V(10, 16, 4), cf = C(0, 8, -34), color = "#1C1614", material = Enum.Material.Basalt })
	part(model, { size = V(12, 2, 6), cf = C(0, 1, -33), color = "#1C1614", material = Enum.Material.Basalt })
	for _, sx in { -1, 1 } do
		part(model, { size = V(4, 36, 4), cf = C(sx * 22, 18, -38), color = "#100C0C", material = Enum.Material.Basalt })
		part(model, { class = "WedgePart", size = V(4, 8, 4), cf = C(sx * 22, 40, -38), color = "#100C0C", material = Enum.Material.Basalt })
		-- lava falls
		local fall = part(model, {
			size = V(4, 26, 0.6),
			cf = C(sx * 13, 13, -34.6),
			color = "#FF6A1A",
			material = Enum.Material.Neon,
			shadow = false,
		})
		table.insert(ctx.lava, fall)
		-- braziers
		local br = part(model, { size = V(2.2, 1.2, 2.2), cf = C(sx * 9, 1.6, -8), color = "#3A2A1A", material = Enum.Material.CorrodedMetal })
		part(model, { size = V(0.6, 1.2, 0.6), cf = C(sx * 9, 0.6, -8), color = "#2A1A0A", material = Enum.Material.CorrodedMetal })
		emitter(br, {
			texture = Assets.Particles.Fire,
			rate = 30,
			lifetime = NumberRange.new(0.5, 1.0),
			speed = NumberRange.new(2, 4),
			sizeSeq = seq(1.8, 0.4),
			colorSeq = ColorSequence.new(hex("#FFD27A"), hex("#FF3A0A")),
		})
		light(br, "#FF7A2A", 3, 18, true)
	end
	-- green rift high in the smoke
	for i = 0, 6 do
		part(model, {
			size = V(0.8, 6 - math.abs(i - 3), 0.4),
			cf = C(-6 + i * 2, 44 + math.sin(i * 1.7) * 2, -60) * A(0, 0, rad((i % 2 == 0) and 20 or -20)),
			color = "#63FF8A",
			material = Enum.Material.Neon,
			shadow = false,
		})
	end
	-- obsidian spires
	for i = 1, 9 do
		local x = -48 + i * 11
		local h = 10 + (i * 7) % 14
		part(model, { class = "WedgePart", size = V(4, h, 5), cf = C(x, h / 2, -28 - (i % 3) * 5) * A(0, rad(i * 40), 0), color = "#0E0A0A", material = Enum.Material.Basalt })
	end
	-- embers rising
	local air = part(model, { name = "Embers", size = V(100, 2, 30), cf = C(0, 0, -10), transparency = 1, shadow = false })
	emitter(air, {
		rate = 40,
		lifetime = NumberRange.new(3, 6),
		speed = NumberRange.new(1.5, 4),
		size = 0.18,
		colorSeq = ColorSequence.new(hex("#FFD27A"), hex("#FF3A0A")),
		spread = Vector2.new(25, 25),
		accel = V(0.6, 0.6, 0),
	})
	-- chains in the foreground
	for _, sx in { -1, 1 } do
		for k = 0, 12 do
			part(model, { size = V(0.5, 1.0, 0.5), cf = C(sx * 27, 30 - k * 1.0, 9), color = "#0A0808", material = Enum.Material.Metal })
		end
	end
end

-- The default Roblox baseplate: flat, gray, infinite and a little bit sad.
THEMES.baseplate = function(model, _stage, _ctx)
	-- faint stud grid
	for i = -25, 25 do
		part(model, { size = V(0.06, 0.02, 70), cf = C(i * 4, 0.01, -12), color = "#9A999C", material = Enum.Material.SmoothPlastic, shadow = false })
	end
	for k = -8, 8 do
		part(model, { size = V(220, 0.02, 0.06), cf = C(0, 0.01, -12 + k * 4), color = "#9A999C", material = Enum.Material.SmoothPlastic, shadow = false })
	end
	-- the spawn pad everybody has seen a million times
	part(model, { name = "SpawnPad", size = V(6, 1, 6), cf = C(0, 0.5, -14), color = "#A3A2A5", material = Enum.Material.SmoothPlastic })
	part(model, { size = V(4, 0.06, 4), cf = C(0, 1.03, -14), color = "#E8E8E8", material = Enum.Material.SmoothPlastic, shadow = false })
	-- leftover test bricks somebody forgot to delete
	local colors = { "#C4281C", "#0D69AC", "#F5CD30", "#4B974B", "#F2F3F3" }
	local stacks = { { -18, -10 }, { 16, -9 }, { -30, -20 }, { 28, -22 }, { 6, -30 } }
	for si, st in stacks do
		for h = 0, (si % 3) + 1 do
			part(model, {
				size = V(4, 1.2, 2),
				cf = C(st[1] + (h % 2) * 0.6, 0.6 + h * 1.2, st[2]) * A(0, rad(si * 17 + h * 9), 0),
				color = colors[(si + h) % #colors + 1],
				material = Enum.Material.SmoothPlastic,
			})
		end
	end
	-- a sign
	part(model, { size = V(0.4, 5, 0.4), cf = C(-9, 2.5, -8), color = "#6B4A2A", material = Enum.Material.Wood })
	local sign = part(model, { size = V(6, 2.6, 0.3), cf = C(-9, 5.6, -8), color = "#F2F3F3", material = Enum.Material.SmoothPlastic })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = sign
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = "my first game\n(work in progress)\n(since 2014)"
	t.TextColor3 = Color3.fromHex("#1B1B1F")
	t.TextScaled = true
	t.FontFace = Font.fromEnum(Enum.Font.Cartoon)
	t.Parent = gui
	-- floating dust motes in the sun
	local air = part(model, { name = "Motes", size = V(90, 14, 30), cf = C(0, 7, -12), transparency = 1, shadow = false })
	emitter(air, { rate = 8, lifetime = NumberRange.new(5, 9), speed = NumberRange.new(0.2, 0.4), size = 0.12, color = "#FFFFFF", spread = Vector2.new(180, 180) })
end

THEMES.proving = function(model, _stage, _ctx)
	for i = -20, 20 do
		part(model, { size = V(0.08, 0.04, 40), cf = C(i * 4, 0.03, -16), color = "#6A5A2A", material = Enum.Material.Neon, transparency = 0.6, shadow = false })
	end
	for k = 0, 8 do
		part(model, { size = V(170, 0.04, 0.08), cf = C(0, 0.03, -k * 4), color = "#6A5A2A", material = Enum.Material.Neon, transparency = 0.6, shadow = false })
	end
	for i = 1, 10 do
		local x = -50 + i * 10
		local h = 6 + (i % 4) * 3
		part(model, { size = V(3, h, 3), cf = C(x, h / 2 + 4 + (i % 3) * 2, -30 - (i % 2) * 8) * A(0, rad(i * 21), 0), color = "#2A2A30", material = Enum.Material.Slate })
	end
	local air = part(model, { name = "Motes", size = V(90, 16, 30), cf = C(0, 8, -14), transparency = 1, shadow = false })
	emitter(air, { rate = 14, lifetime = NumberRange.new(5, 9), speed = NumberRange.new(0.2, 0.5), size = 0.16, color = "#E8C66A", spread = Vector2.new(180, 180) })
end

-------------------------------------------------------------------------------

function StageBuilder.clear()
	if current then
		for _, inst in current.made do
			if inst and inst.Parent then
				inst:Destroy()
			end
		end
		if current.model then
			current.model:Destroy()
		end
		current = nil
	end
end

function StageBuilder.build(stageId: string)
	StageBuilder.clear()
	local stage = Stages.get(stageId)
	local model = Instance.new("Model")
	model.Name = "Stage_" .. stage.id
	local made = {}
	local ctx = { stage = stage }
	floor(model, stage, stage.theme)
	local bd = backdrop(model, stage)
	local builder = THEMES[stage.theme] or THEMES.proving
	builder(model, stage, ctx)
	model.Parent = workspace
	local fx = applyLighting(stage, stage.theme, made)
	current = {
		id = stageId,
		stage = stage,
		model = model,
		backdrop = bd,
		backdropBase = bd and bd.CFrame or nil,
		made = made,
		ctx = ctx,
		fx = fx,
	}
	return current
end

-- Per-frame animation of stage elements; camX gives backdrop parallax.
function StageBuilder.update(t: number, camX: number)
	local cur = current
	if not cur then
		return
	end
	if cur.backdrop and cur.backdropBase then
		cur.backdrop.CFrame = cur.backdropBase * C(camX * 0.55, 0, 0)
	end
	local ctx = cur.ctx
	if ctx.flags then
		for _, f in ctx.flags do
			f.part.CFrame = f.base * A(math.sin(t * 2.2 + f.phase) * 0.25, 0, math.sin(t * 1.7 + f.phase) * 0.12)
		end
	end
	if ctx.lava then
		local k = 0.5 + 0.5 * math.sin(t * 1.6)
		for i, p in ctx.lava do
			local kk = 0.5 + 0.5 * math.sin(t * 1.3 + i)
			p.Color = Color3.fromRGB(255, 70 + math.floor(50 * kk), 10 + math.floor(20 * k))
		end
	end
end

function StageBuilder.current()
	return current
end

return StageBuilder
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">VFX</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Combat visual effects: hit sparks, essence bursts, block sparks, shockwaves,
-- slash arcs, projectiles, teleports, ground dust, finisher shatters.
-- Everything is client-side and cleaned up with Debris.

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

local Veil = game:GetService("ReplicatedStorage"):WaitForChild("Veil")
local Assets = require(Veil.Assets)

local VFX = {}

local V = Vector3.new
local C = CFrame.new
local A = CFrame.Angles
local rad = math.rad

local ELEMENT_COLORS = {
	lightning = { Color3.fromHex("#E8F6FF"), Color3.fromHex("#58B4FF") },
	radiant = { Color3.fromHex("#FFFFFF"), Color3.fromHex("#3FE0C8") },
	nature = { Color3.fromHex("#E6FFD8"), Color3.fromHex("#5BFF6A") },
	shadow = { Color3.fromHex("#F2E6FF"), Color3.fromHex("#A86BFF") },
	ice = { Color3.fromHex("#FFFFFF"), Color3.fromHex("#8FE6FF") },
	fire = { Color3.fromHex("#FFF2C8"), Color3.fromHex("#FF7A1A") },
	ash = { Color3.fromHex("#FFE6E6"), Color3.fromHex("#FF3B4E") },
	soulfire = { Color3.fromHex("#E6FFE8"), Color3.fromHex("#63FF8A") },
	spirit = { Color3.fromHex("#FFFFFF"), Color3.fromHex("#9FEFFF") },
	storm = { Color3.fromHex("#E8F6FF"), Color3.fromHex("#58B4FF") },
	default = { Color3.fromHex("#FFF6E0"), Color3.fromHex("#FFB04A") },
}
VFX.ElementColors = ELEMENT_COLORS

local root: Folder? = nil
local function container(): Instance
	if root and root.Parent then
		return root
	end
	local f = Instance.new("Folder")
	f.Name = "VeilVFX"
	f.Parent = workspace
	root = f
	return f
end

function VFX.clear()
	if root then
		root:Destroy()
		root = nil
	end
end

local function colors(element: string?)
	return ELEMENT_COLORS[element or "default"] or ELEMENT_COLORS.default
end
VFX.colors = colors

local function anchorAt(pos: Vector3, life: number)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = V(0.2, 0.2, 0.2)
	p.CFrame = C(pos)
	p.Parent = container()
	Debris:AddItem(p, life)
	return p
end

local function burst(parent: Instance, count: number, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = props.texture or Assets.Particles.Spark
	e.Rate = 0
	e.Lifetime = props.lifetime or NumberRange.new(0.2, 0.45)
	e.Speed = props.speed or NumberRange.new(10, 22)
	e.SpreadAngle = props.spread or Vector2.new(180, 180)
	e.Size = props.size or NumberSequence.new(0.5, 0)
	e.Transparency = props.transparency or NumberSequence.new(0, 1)
	e.Color = props.color or ColorSequence.new(Color3.new(1, 1, 1))
	e.LightEmission = props.lightEmission or 1
	e.LightInfluence = 0
	e.Acceleration = props.accel or V(0, 0, 0)
	e.Drag = props.drag or 4
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = props.rotSpeed or NumberRange.new(-200, 200)
	e.EmissionDirection = props.dir or Enum.NormalId.Top
	e.Orientation = props.orientation or Enum.ParticleOrientation.FacingCamera
	e.ZOffset = props.zoffset or 1
	e.Parent = parent
	e:Emit(count)
	return e
end
VFX.burst = burst

local function flashBall(pos: Vector3, color: Color3, size: number, life: number)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = V(size * 0.3, size * 0.3, size * 0.3)
	p.CFrame = C(pos)
	p.Transparency = 0.05
	p.Parent = container()
	TweenService:Create(p, TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = V(size, size, size),
		Transparency = 1,
	}):Play()
	Debris:AddItem(p, life + 0.05)
	return p
end
VFX.flashBall = flashBall

local function ring(pos: Vector3, color: Color3, size: number, life: number, flat: boolean?)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = V(0.1, 1, 1)
	-- cylinder axis is X: face the camera (+Z) or lie flat on the ground
	local rot = flat and A(0, 0, rad(90)) or A(0, rad(90), 0)
	p.CFrame = C(pos) * rot
	p.Transparency = 0.2
	p.Parent = container()
	TweenService:Create(p, TweenInfo.new(life, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = V(0.05, size, size),
		Transparency = 1,
	}):Play()
	Debris:AddItem(p, life + 0.05)
	return p
end
VFX.ring = ring

-------------------------------------------------------------------------------
-- Impacts
-------------------------------------------------------------------------------

-- strength: light | medium | heavy | special | super
function VFX.hit(pos: Vector3, strength: string, element: string?, dir: number, essence: boolean?)
	local cols = colors(element)
	local heavy = strength == "heavy" or strength == "special" or strength == "super"
	local a = anchorAt(pos + V(0, 0, 0.8), 1.4)
	burst(a, heavy and 22 or 12, {
		color = ColorSequence.new(cols[1], cols[2]),
		speed = NumberRange.new(heavy and 16 or 10, heavy and 34 or 20),
		size = NumberSequence.new(heavy and 0.55 or 0.35, 0),
		lifetime = NumberRange.new(0.12, 0.32),
		orientation = Enum.ParticleOrientation.VelocityParallel,
	})
	burst(a, 1, {
		texture = Assets.Particles.ExplosionCore,
		color = ColorSequence.new(cols[1], cols[2]),
		speed = NumberRange.new(0, 0),
		size = NumberSequence.new(heavy and 4.5 or 2.6, heavy and 7 or 3.6),
		lifetime = NumberRange.new(0.12, 0.16),
		transparency = NumberSequence.new(0, 1),
	})
	if essence ~= false then
		-- stylised crimson "veil essence" spray
		burst(a, heavy and 16 or 8, {
			color = ColorSequence.new(Color3.fromHex("#B0101C"), Color3.fromHex("#4A0408")),
			speed = NumberRange.new(6, heavy and 18 or 11),
			spread = Vector2.new(40, 40),
			dir = dir > 0 and Enum.NormalId.Right or Enum.NormalId.Left,
			size = NumberSequence.new(heavy and 0.38 or 0.26, 0.05),
			lifetime = NumberRange.new(0.35, 0.7),
			accel = V(0, -60, 0),
			drag = 1,
			lightEmission = 0.1,
		})
	end
	flashBall(pos, cols[1], heavy and 3.2 or 1.8, heavy and 0.16 or 0.1)
	if heavy then
		ring(pos, cols[2], strength == "super" and 14 or 7, 0.3)
	end
	if element and element ~= "default" then
		VFX.elementBurst(pos, element, heavy)
	end
end

function VFX.block(pos: Vector3, dir: number)
	local a = anchorAt(pos + V(0, 0, 0.8), 1)
	burst(a, 14, {
		color = ColorSequence.new(Color3.fromHex("#FFFFFF"), Color3.fromHex("#7FC8FF")),
		speed = NumberRange.new(8, 18),
		spread = Vector2.new(60, 60),
		dir = dir > 0 and Enum.NormalId.Left or Enum.NormalId.Right,
		size = NumberSequence.new(0.3, 0),
		lifetime = NumberRange.new(0.12, 0.3),
		orientation = Enum.ParticleOrientation.VelocityParallel,
	})
	ring(pos, Color3.fromHex("#9AD8FF"), 3.4, 0.18)
end

function VFX.parry(pos: Vector3)
	ring(pos, Color3.fromHex("#FFFFFF"), 8, 0.35)
	flashBall(pos, Color3.fromHex("#FFF6C8"), 4, 0.2)
	local a = anchorAt(pos, 1)
	burst(a, 26, {
		color = ColorSequence.new(Color3.fromHex("#FFFFFF"), Color3.fromHex("#FFD27A")),
		speed = NumberRange.new(14, 30),
		size = NumberSequence.new(0.4, 0),
		orientation = Enum.ParticleOrientation.VelocityParallel,
	})
end

function VFX.elementBurst(pos: Vector3, element: string, big: boolean?)
	local cols = colors(element)
	local a = anchorAt(pos, 2)
	if element == "fire" or element == "soulfire" then
		burst(a, big and 16 or 8, {
			texture = Assets.Particles.Fire,
			color = ColorSequence.new(cols[1], cols[2]),
			speed = NumberRange.new(3, 8),
			size = NumberSequence.new(big and 2.4 or 1.5, 0),
			lifetime = NumberRange.new(0.3, 0.6),
			accel = V(0, 10, 0),
			lightEmission = 1,
		})
	elseif element == "ice" then
		for i = 1, big and 6 or 3 do
			local s = Instance.new("Part")
			s.Anchored = true
			s.CanCollide = false
			s.CanQuery = false
			s.CanTouch = false
			s.CastShadow = false
			s.Material = Enum.Material.Glass
			s.Transparency = 0.25
			s.Color = cols[2]
			s.Size = V(0.3, 1.2, 0.3)
			s.CFrame = C(pos) * A(math.random() * 6, math.random() * 6, math.random() * 6) * C(0, 0.6, 0)
			s.Parent = container()
			TweenService:Create(s, TweenInfo.new(0.45), { Transparency = 1, Size = V(0.05, 0.4, 0.05) }):Play()
			Debris:AddItem(s, 0.5)
			local _ = i
		end
	elseif element == "lightning" or element == "storm" then
		VFX.lightning(pos + V(-1.6, 1.4, 0), pos + V(1.6, -1.0, 0), cols[2], 0.14)
		VFX.lightning(pos + V(1.2, 1.8, 0), pos + V(-1.0, -1.2, 0), cols[1], 0.12)
	elseif element == "shadow" then
		burst(a, big and 14 or 8, {
			texture = Assets.Particles.Smoke,
			color = ColorSequence.new(Color3.fromHex("#3A1A5A"), Color3.fromHex("#0A0612")),
			speed = NumberRange.new(2, 6),
			size = NumberSequence.new(1.4, 3),
			lifetime = NumberRange.new(0.4, 0.8),
			transparency = NumberSequence.new(0.3, 1),
			lightEmission = 0,
		})
	elseif element == "nature" then
		burst(a, big and 18 or 10, {
			color = ColorSequence.new(Color3.fromHex("#B6FF9A"), Color3.fromHex("#2A6A1A")),
			speed = NumberRange.new(6, 14),
			size = NumberSequence.new(0.35, 0),
			lifetime = NumberRange.new(0.4, 0.8),
			accel = V(0, -20, 0),
		})
	else
		burst(a, big and 14 or 8, {
			color = ColorSequence.new(cols[1], cols[2]),
			speed = NumberRange.new(4, 12),
			size = NumberSequence.new(0.4, 0),
			lifetime = NumberRange.new(0.3, 0.6),
		})
	end
end

-- Jagged lightning bolt between two points.
function VFX.lightning(a: Vector3, b: Vector3, color: Color3, life: number)
	local segs = 6
	local prev = a
	for i = 1, segs do
		local t = i / segs
		local p = a:Lerp(b, t)
		if i < segs then
			p += V((math.random() - 0.5) * 0.9, (math.random() - 0.5) * 0.9, 0)
		end
		local mid = (prev + p) / 2
		local len = (p - prev).Magnitude
		local s = Instance.new("Part")
		s.Anchored = true
		s.CanCollide = false
		s.CanQuery = false
		s.CanTouch = false
		s.CastShadow = false
		s.Material = Enum.Material.Neon
		s.Color = color
		s.Size = V(0.12, 0.12, len)
		s.CFrame = CFrame.lookAt(mid, p)
		s.Parent = container()
		TweenService:Create(s, TweenInfo.new(life), { Transparency = 1 }):Play()
		Debris:AddItem(s, life + 0.05)
		prev = p
	end
end

function VFX.dust(pos: Vector3, big: boolean?)
	local a = anchorAt(pos + V(0, 0.3, 0), 2)
	burst(a, big and 14 or 6, {
		texture = Assets.Particles.Smoke,
		color = ColorSequence.new(Color3.fromHex("#B8AE9E")),
		speed = NumberRange.new(2, big and 7 or 4),
		spread = Vector2.new(80, 10),
		size = NumberSequence.new(big and 1.6 or 1, big and 4 or 2.4),
		lifetime = NumberRange.new(0.5, 1.0),
		transparency = NumberSequence.new(0.45, 1),
		lightEmission = 0,
		drag = 3,
	})
	if big then
		ring(pos + V(0, 0.1, 0), Color3.fromHex("#D8D0C0"), 6, 0.3, true)
	end
end

function VFX.teleport(pos: Vector3, color: Color3)
	local a = anchorAt(pos + V(0, 2.6, 0), 2)
	burst(a, 1, {
		texture = Assets.Particles.Implosion,
		color = ColorSequence.new(color),
		speed = NumberRange.new(0, 0),
		size = NumberSequence.new(7, 1),
		lifetime = NumberRange.new(0.25, 0.25),
	})
	burst(a, 16, {
		texture = Assets.Particles.Smoke,
		color = ColorSequence.new(color:Lerp(Color3.new(0, 0, 0), 0.6)),
		speed = NumberRange.new(1, 4),
		size = NumberSequence.new(1.6, 3.2),
		lifetime = NumberRange.new(0.5, 0.9),
		transparency = NumberSequence.new(0.3, 1),
		lightEmission = 0.2,
	})
	flashBall(pos + V(0, 2.6, 0), color, 4, 0.22)
end

function VFX.burstShockwave(pos: Vector3, color: Color3)
	ring(pos, color, 16, 0.45)
	ring(pos, Color3.new(1, 1, 1), 9, 0.3)
	flashBall(pos, color, 6, 0.3)
	local a = anchorAt(pos, 2)
	burst(a, 40, {
		color = ColorSequence.new(Color3.new(1, 1, 1), color),
		speed = NumberRange.new(20, 40),
		size = NumberSequence.new(0.5, 0),
		orientation = Enum.ParticleOrientation.VelocityParallel,
	})
end

function VFX.groundEruption(pos: Vector3, element: string, height: number)
	local cols = colors(element)
	for i = 1, 5 do
		local s = Instance.new("Part")
		s.Anchored = true
		s.CanCollide = false
		s.CanQuery = false
		s.CanTouch = false
		s.Material = element == "nature" and Enum.Material.Wood or Enum.Material.Neon
		s.Color = element == "nature" and Color3.fromHex("#4A3624") or cols[2]
		s.Size = V(0.4, 0.2, 0.4)
		local base = pos + V((i - 3) * 0.5, 0, (math.random() - 0.5) * 1.2)
		s.CFrame = C(base) * A(0, 0, rad((i - 3) * 9))
		s.Parent = container()
		TweenService:Create(s, TweenInfo.new(0.12, Enum.EasingStyle.Back), {
			Size = V(0.45, height * (0.6 + math.random() * 0.4), 0.45),
			CFrame = C(base + V(0, height * 0.4, 0)) * A(0, 0, rad((i - 3) * 9)),
		}):Play()
		task.delay(0.35, function()
			TweenService:Create(s, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		end)
		Debris:AddItem(s, 0.75)
	end
	VFX.dust(pos, true)
end

-------------------------------------------------------------------------------
-- Projectiles: build a visual and return an object with :update(pos, t) / :destroy()
-------------------------------------------------------------------------------

local function neon(size: Vector3, color: Color3, shape)
	local p = Instance.new("Part")
	if shape then
		p.Shape = shape
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = size
	return p
end

local function attachTrail(p: BasePart, color: Color3, width: number, life: number)
	local a0 = Instance.new("Attachment")
	a0.Position = V(0, width / 2, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = V(0, -width / 2, 0)
	a1.Parent = p
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Color = ColorSequence.new(Color3.new(1, 1, 1), color)
	tr.Transparency = NumberSequence.new(0.1, 1)
	tr.Lifetime = life
	tr.LightEmission = 1
	tr.FaceCamera = true
	tr.Parent = p
	return tr
end

local PROJ = {}

PROJ.lightning_bolt = function(m, cols)
	local core = neon(V(1.6, 0.35, 0.35), cols[1])
	core.Parent = m
	local glow = neon(V(2.0, 0.7, 0.7), cols[2])
	glow.Transparency = 0.5
	glow.Parent = m
	attachTrail(core, cols[2], 0.8, 0.18)
	local l = Instance.new("PointLight")
	l.Color = cols[2]
	l.Brightness = 3
	l.Range = 12
	l.Parent = core
	return function(cf, t)
		core.CFrame = cf * A(t * 7, 0, 0)
		glow.CFrame = cf * A(-t * 5, 0, 0)
	end
end
PROJ.halo_disc = function(m, cols)
	local d = neon(V(0.15, 1.6, 1.6), cols[2], Enum.PartType.Cylinder)
	d.Parent = m
	local inner = neon(V(0.18, 1.0, 1.0), cols[1], Enum.PartType.Cylinder)
	inner.Parent = m
	attachTrail(d, cols[2], 1.2, 0.2)
	return function(cf, t)
		local r = cf * A(0, rad(90), 0) * A(t * 14, 0, 0)
		d.CFrame = r
		inner.CFrame = r
	end
end
PROJ.thorns = function(m, cols)
	local parts = {}
	for i = 1, 4 do
		local s = Instance.new("Part")
		s.Anchored = true
		s.CanCollide = false
		s.CanQuery = false
		s.CanTouch = false
		s.Material = Enum.Material.Wood
		s.Color = Color3.fromHex("#4A3624")
		s.Size = V(0.35, 1.6, 0.35)
		s.Parent = m
		parts[i] = s
	end
	local g = neon(V(1.6, 0.1, 1.0), cols[2])
	g.Transparency = 0.4
	g.Parent = m
	return function(cf, t)
		for i, s in parts do
			local ph = (t * 10 + i * 1.7) % 3
			local h = math.clamp(ph, 0, 1.5)
			s.CFrame = cf * C((i - 2.5) * 0.4, -0.6 + h * 0.6, (i % 2 - 0.5) * 0.4) * A(0, 0, rad((i - 2.5) * 12))
		end
		g.CFrame = cf * C(0, -0.55, 0)
	end
end
PROJ.shadow_orb = function(m, cols)
	local o = Instance.new("Part")
	o.Shape = Enum.PartType.Ball
	o.Anchored = true
	o.CanCollide = false
	o.CanQuery = false
	o.CanTouch = false
	o.CastShadow = false
	o.Material = Enum.Material.ForceField
	o.Color = cols[2]
	o.Size = V(1.6, 1.6, 1.6)
	o.Parent = m
	local core = neon(V(0.7, 0.7, 0.7), Color3.fromHex("#0A0612"), Enum.PartType.Ball)
	core.Material = Enum.Material.SmoothPlastic
	core.Parent = m
	local e = Instance.new("ParticleEmitter")
	e.Texture = Assets.Particles.Smoke
	e.Rate = 30
	e.Lifetime = NumberRange.new(0.4, 0.7)
	e.Speed = NumberRange.new(0.5, 1)
	e.Size = NumberSequence.new(1, 2)
	e.Transparency = NumberSequence.new(0.4, 1)
	e.Color = ColorSequence.new(Color3.fromHex("#3A1A5A"))
	e.LightEmission = 0.4
	e.Parent = o
	return function(cf, t)
		local s = 1.5 + math.sin(t * 12) * 0.15
		o.Size = V(s, s, s)
		o.CFrame = cf
		core.CFrame = cf
	end
end
PROJ.ice_shard = function(m, cols)
	local s = Instance.new("WedgePart")
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.Material = Enum.Material.Glass
	s.Transparency = 0.15
	s.Color = cols[2]
	s.Size = V(0.6, 0.8, 1.8)
	s.Parent = m
	local core = neon(V(0.25, 0.3, 1.4), cols[1])
	core.Parent = m
	attachTrail(core, cols[2], 0.6, 0.2)
	return function(cf, t)
		s.CFrame = cf * A(0, rad(-90), 0) * A(0, 0, t * 6)
		core.CFrame = cf * A(0, rad(90), 0)
	end
end
PROJ.ice_wall = function(m, cols)
	local w = Instance.new("Part")
	w.Anchored = true
	w.CanCollide = false
	w.CanQuery = false
	w.CanTouch = false
	w.Material = Enum.Material.Glass
	w.Transparency = 0.2
	w.Color = cols[2]
	w.Size = V(1.2, 0.2, 2.4)
	w.Parent = m
	local spikes = {}
	for i = 1, 3 do
		local sp = Instance.new("WedgePart")
		sp.Anchored = true
		sp.CanCollide = false
		sp.CanQuery = false
		sp.CanTouch = false
		sp.Material = Enum.Material.Glass
		sp.Transparency = 0.25
		sp.Color = cols[1]
		sp.Size = V(0.5, 1.4, 0.8)
		sp.Parent = m
		spikes[i] = sp
	end
	return function(cf, t)
		local h = math.min(4.4, t * 40)
		w.Size = V(1.2, h, 2.4)
		w.CFrame = cf * C(0, -2.2 + h / 2, 0)
		for i, sp in spikes do
			sp.CFrame = cf * C((i - 2) * 0.35, -2.2 + h + 0.4, (i - 2) * 0.5) * A(0, rad(i * 60), 0)
		end
	end
end
PROJ.chakram = function(m, cols)
	local r = neon(V(0.15, 1.3, 1.3), cols[2], Enum.PartType.Cylinder)
	r.Parent = m
	local g = Instance.new("Part")
	g.Shape = Enum.PartType.Cylinder
	g.Anchored = true
	g.CanCollide = false
	g.CanQuery = false
	g.CanTouch = false
	g.Material = Enum.Material.Metal
	g.Color = Color3.fromHex("#E9C46A")
	g.Size = V(0.17, 1.0, 1.0)
	g.Parent = m
	attachTrail(r, cols[2], 1.0, 0.2)
	return function(cf, t)
		local c = cf * A(0, 0, rad(90)) * A(t * 30, 0, 0)
		r.CFrame = c
		g.CFrame = c
	end
end
PROJ.bolt = function(m, cols)
	local b = Instance.new("Part")
	b.Anchored = true
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	b.Material = Enum.Material.Metal
	b.Color = Color3.fromHex("#D8D8E0")
	b.Size = V(1.4, 0.1, 0.1)
	b.Parent = m
	local tip = neon(V(0.3, 0.2, 0.2), cols[2])
	tip.Parent = m
	attachTrail(b, cols[2], 0.25, 0.12)
	return function(cf)
		b.CFrame = cf
		tip.CFrame = cf * C(0.75, 0, 0)
	end
end
PROJ.hook = function(m, cols)
	local h = Instance.new("Part")
	h.Anchored = true
	h.CanCollide = false
	h.CanQuery = false
	h.CanTouch = false
	h.Material = Enum.Material.Metal
	h.Color = Color3.fromHex("#5A5A5A")
	h.Size = V(0.5, 0.7, 0.2)
	h.Parent = m
	local chain = neon(V(1, 0.08, 0.08), cols[2])
	chain.Material = Enum.Material.Metal
	chain.Color = Color3.fromHex("#3A3A3A")
	chain.Parent = m
	return function(cf, _t, origin)
		h.CFrame = cf
		if origin then
			local mid = (origin + cf.Position) / 2
			local len = (cf.Position - origin).Magnitude
			chain.Size = V(math.max(0.1, len), 0.08, 0.08)
			chain.CFrame = CFrame.lookAt(mid, cf.Position) * A(0, rad(90), 0)
		end
	end
end
PROJ.trap = function(m, cols)
	local base = Instance.new("Part")
	base.Anchored = true
	base.CanCollide = false
	base.CanQuery = false
	base.CanTouch = false
	base.Material = Enum.Material.Metal
	base.Color = Color3.fromHex("#3A3A3A")
	base.Size = V(1.4, 0.15, 1.0)
	base.Parent = m
	local teeth = neon(V(1.2, 0.2, 0.08), cols[2])
	teeth.Parent = m
	return function(cf, t)
		base.CFrame = cf * C(0, -0.25, 0)
		teeth.CFrame = cf * C(0, -0.1, 0)
		teeth.Transparency = 0.3 + 0.3 * math.sin(t * 8)
	end
end
PROJ.light_pillar = function(m, cols)
	local p = neon(V(1.8, 0.2, 1.8), cols[1])
	p.Transparency = 0.2
	p.Parent = m
	local outer = neon(V(2.6, 0.2, 2.6), cols[2])
	outer.Transparency = 0.6
	outer.Parent = m
	return function(cf, t)
		local h = math.min(8, t * 50)
		p.Size = V(1.6, h, 1.6)
		p.CFrame = cf * C(0, -3 + h / 2, 0)
		outer.Size = V(2.6, h, 2.6)
		outer.CFrame = cf * C(0, -3 + h / 2, 0)
	end
end
PROJ.fang_spikes = function(m, cols)
	local parts = {}
	for i = 1, 5 do
		local s = neon(V(0.3, 0.2, 0.3), cols[1])
		s.Material = Enum.Material.Glass
		s.Transparency = 0.2
		s.Parent = m
		parts[i] = s
	end
	return function(cf, t)
		local h = math.min(3.2, t * 30)
		for i, s in parts do
			s.Size = V(0.35, h * (0.6 + (i % 3) * 0.2), 0.35)
			s.CFrame = cf * C((i - 3) * 0.4, -1.6 + s.Size.Y / 2, (i % 2 - 0.5) * 0.5) * A(0, 0, rad((i - 3) * 10))
		end
	end
end
PROJ.soulfire = function(m, cols)
	local base = neon(V(1.8, 0.2, 1.2), cols[2])
	base.Transparency = 0.4
	base.Parent = m
	local e = Instance.new("ParticleEmitter")
	e.Texture = Assets.Particles.Fire
	e.Rate = 60
	e.Lifetime = NumberRange.new(0.3, 0.6)
	e.Speed = NumberRange.new(3, 6)
	e.Size = NumberSequence.new(1.8, 0.4)
	e.Color = ColorSequence.new(cols[1], cols[2])
	e.LightEmission = 1
	e.Parent = base
	local l = Instance.new("PointLight")
	l.Color = cols[2]
	l.Brightness = 3
	l.Range = 12
	l.Parent = base
	return function(cf)
		base.CFrame = cf * C(0, -1.1, 0)
	end
end
PROJ.seal = function(m, cols)
	local d = neon(V(0.12, 1.8, 1.8), cols[2], Enum.PartType.Cylinder)
	d.Transparency = 0.3
	d.Parent = m
	local inner = neon(V(0.14, 1.1, 1.1), cols[1], Enum.PartType.Cylinder)
	inner.Parent = m
	return function(cf, t)
		local r = cf * A(0, rad(90), 0) * A(t * 4, 0, 0)
		d.CFrame = r
		inner.CFrame = r * A(-t * 8, 0, 0)
	end
end
PROJ.wolf = function(m, cols)
	local body = Instance.new("Part")
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CanTouch = false
	body.Material = Enum.Material.ForceField
	body.Color = cols[2]
	body.Size = V(2.2, 1.1, 0.9)
	body.Parent = m
	local head = body:Clone()
	head.Size = V(0.9, 0.8, 0.7)
	head.Parent = m
	local legs = {}
	for i = 1, 4 do
		local l = body:Clone()
		l.Size = V(0.25, 0.9, 0.25)
		l.Parent = m
		legs[i] = l
	end
	return function(cf, t)
		local bob = math.abs(math.sin(t * 18)) * 0.25
		body.CFrame = cf * C(0, bob, 0)
		head.CFrame = cf * C(1.35, bob + 0.35, 0)
		for i, l in legs do
			local sx = i <= 2 and 0.8 or -0.8
			local sz = (i % 2 == 0) and 0.3 or -0.3
			l.CFrame = cf * C(sx, -0.75, sz) * A(0, 0, math.sin(t * 18 + i) * 0.6)
		end
	end
end
PROJ.lantern_bomb = function(m, cols)
	local cage = Instance.new("Part")
	cage.Anchored = true
	cage.CanCollide = false
	cage.CanQuery = false
	cage.CanTouch = false
	cage.Material = Enum.Material.Metal
	cage.Color = Color3.fromHex("#1A1C1E")
	cage.Size = V(0.7, 0.9, 0.7)
	cage.Transparency = 0.3
	cage.Parent = m
	local core = neon(V(0.45, 0.6, 0.45), cols[2])
	core.Parent = m
	local l = Instance.new("PointLight")
	l.Color = cols[2]
	l.Brightness = 4
	l.Range = 14
	l.Parent = core
	return function(cf, t)
		cage.CFrame = cf * A(0, t * 3, math.sin(t * 6) * 0.3)
		core.CFrame = cage.CFrame
	end
end
PROJ.ravens = function(m, cols)
	local birds = {}
	for i = 1, 6 do
		local b = Instance.new("Part")
		b.Anchored = true
		b.CanCollide = false
		b.CanQuery = false
		b.CanTouch = false
		b.Material = Enum.Material.SmoothPlastic
		b.Color = Color3.fromHex("#0E0B10")
		b.Size = V(0.6, 0.15, 0.9)
		b.Parent = m
		local eye = neon(V(0.08, 0.08, 0.08), cols[2])
		eye.Parent = m
		birds[i] = { b, eye }
	end
	return function(cf, t)
		for i, pair in birds do
			local o = C(math.sin(t * 9 + i) * 0.7, math.cos(t * 7 + i * 2) * 0.7, math.sin(t * 5 + i) * 0.5)
			local c = cf * o * A(0, 0, math.sin(t * 30 + i) * 0.6)
			pair[1].CFrame = c
			pair[2].CFrame = c * C(0.3, 0.05, 0)
		end
	end
end
PROJ.raven_dive = function(m, cols)
	local b = Instance.new("Part")
	b.Anchored = true
	b.CanCollide = false
	b.CanQuery = false
	b.CanTouch = false
	b.Material = Enum.Material.SmoothPlastic
	b.Color = Color3.fromHex("#0E0B10")
	b.Size = V(1.6, 0.25, 2.2)
	b.Parent = m
	attachTrail(b, cols[2], 0.6, 0.25)
	return function(cf, t)
		b.CFrame = cf * A(rad(70), 0, math.sin(t * 25) * 0.3)
	end
end

function VFX.projectile(kind: string, element: string?)
	local m = Instance.new("Model")
	m.Name = "Proj_" .. kind
	local cols = colors(element)
	local builder = PROJ[kind] or PROJ.lightning_bolt
	local update = builder(m, cols)
	m.Parent = container()
	local obj = { model = m, update = update, kind = kind, element = element }
	function obj:set(pos: Vector3, facing: number, t: number, origin: Vector3?)
		local cf = CFrame.new(pos) * (facing < 0 and A(0, math.pi, 0) or CFrame.identity)
		self.update(cf, t, origin)
	end
	function obj:destroy(pos: Vector3?)
		if pos then
			flashBall(pos, cols[2], 2.6, 0.15)
			local a = anchorAt(pos, 1)
			burst(a, 10, {
				color = ColorSequence.new(cols[1], cols[2]),
				speed = NumberRange.new(6, 14),
				size = NumberSequence.new(0.4, 0),
			})
		end
		self.model:Destroy()
	end
	return obj
end

-------------------------------------------------------------------------------
-- Finisher: shatter a rig into glowing shards
-------------------------------------------------------------------------------

function VFX.shatter(rig, color: Color3, style: string?)
	for _, p in rig.allParts do
		if p:IsA("BasePart") then
			p.Material = Enum.Material.Neon
			p.Color = p.Color:Lerp(color, 0.65)
			p.CanCollide = false
			p.Anchored = true
			local here = p.CFrame.Position
			local dir = (here - rig.model:GetPivot().Position)
			if dir.Magnitude < 0.01 then
				dir = V(0, 1, 0)
			end
			dir = dir.Unit
			local target = here + dir * (4 + math.random() * 6) + V(0, 2 + math.random() * 4, (math.random() - 0.5) * 4)
			if style == "nature" then
				target = here - V(0, 4, 0)
			elseif style == "ice" then
				p.Material = Enum.Material.Glass
			end
			TweenService:Create(p, TweenInfo.new(1.4 + math.random() * 0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				CFrame = CFrame.new(target) * A(math.random() * 6, math.random() * 6, math.random() * 6),
				Transparency = 1,
				Size = p.Size * 0.4,
			}):Play()
		end
	end
	local pos = rig.model:GetPivot().Position
	VFX.burstShockwave(pos + V(0, 1, 0), color)
	local a = anchorAt(pos + V(0, 1, 0), 4)
	burst(a, 80, {
		color = ColorSequence.new(Color3.new(1, 1, 1), color),
		speed = NumberRange.new(4, 18),
		size = NumberSequence.new(0.5, 0),
		lifetime = NumberRange.new(1, 2.5),
		accel = V(0, 3, 0),
		drag = 1.5,
	})
end

-------------------------------------------------------------------------------
-- Parody finisher: the classic Roblox death. Every part pops loose, flies apart
-- with real physics and clatters onto the floor, with a big "OOF".
-------------------------------------------------------------------------------

function VFX.oofBreak(rig, color: Color3)
	local pivot = rig.model:GetPivot().Position
	for _, p in rig.allParts do
		if p:IsA("BasePart") then
			local here = p.CFrame.Position
			local dir = here - pivot
			if dir.Magnitude < 0.05 then
				dir = V(math.random() - 0.5, 1, math.random() - 0.5)
			end
			dir = dir.Unit
			p.Anchored = false
			p.CanCollide = true
			p.CanQuery = false
			p.Massless = false
			p.AssemblyLinearVelocity = dir * (10 + math.random() * 14) + V(0, 14 + math.random() * 12, (math.random() - 0.5) * 10)
			p.AssemblyAngularVelocity = V((math.random() - 0.5) * 20, (math.random() - 0.5) * 20, (math.random() - 0.5) * 20)
		end
	end
	VFX.burstShockwave(pivot + V(0, 1.5, 0), color)
	-- the OOF
	local a = anchorAt(pivot + V(0, 5, 0), 3)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(420, 160)
	bb.LightInfluence = 0
	bb.AlwaysOnTop = true
	bb.Parent = a
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Text = "OOF"
	t.TextColor3 = Color3.fromHex("#FFF2C8")
	t.TextStrokeColor3 = Color3.fromHex("#B0141E")
	t.TextStrokeTransparency = 0
	t.FontFace = Font.fromEnum(Enum.Font.LuckiestGuy)
	t.TextScaled = true
	t.Parent = bb
	TweenService:Create(bb, TweenInfo.new(2.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { StudsOffset = V(0, 4, 0) }):Play()
	task.delay(1.4, function()
		if t.Parent then
			TweenService:Create(t, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
	-- a little confetti of studs
	burst(a, 40, {
		color = ColorSequence.new(Color3.fromHex("#F5CD30"), Color3.fromHex("#0D69AC")),
		speed = NumberRange.new(8, 20),
		size = NumberSequence.new(0.4, 0.1),
		lifetime = NumberRange.new(1, 2),
		accel = V(0, -30, 0),
		drag = 0.5,
		lightEmission = 0.3,
	})
end

return VFX
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="39">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--!nonstrict
-- In-fight HUD: health bars with damage trails, portraits, round pips, timer emblem,
-- meter bars, Echo gauge, combo counters, announcer, super/finisher banners and the
-- training readout.

local Veil = game:GetService("ReplicatedStorage"):WaitForChild("Veil")
local Config = require(Veil.Config)

local Theme = require(script.Parent.Theme)
local Portrait = require(script.Parent.Portrait)
local Input = require(script.Parent.Parent.Core.Input)
local Poses = require(script.Parent.Parent.Render.Poses)

local C = Theme.Colors
local F = Theme.Fonts
local new = Theme.new

local HUD = {}
HUD.__index = HUD

local BAR_W = 560
local BAR_H = 26

local function sideBlock(_self, root, side: number, fighter, echo)
	local left = side == 1
	local anchorX = left and 0 or 1
	local sx = left and 1 or -1
	local holder = Theme.frame(root, {
		Name = left and "P1" or "P2",
		Size = UDim2.fromOffset(BAR_W + 150, 140),
		Position = UDim2.new(anchorX, left and 34 or -34, 0, 22),
		AnchorPoint = Vector2.new(anchorX, 0),
	})

	-- portrait medallion
	local medal = Theme.frame(holder, {
		Size = UDim2.fromOffset(104, 104),
		Position = UDim2.new(left and 0 or 1, 0, 0, 0),
		AnchorPoint = Vector2.new(left and 0 or 1, 0),
		BackgroundColor3 = Color3.fromHex("#0C0D10"),
		BackgroundTransparency = 0.05,
	})
	Theme.corner(medal, 52)
	Theme.stroke(medal, C.gold, 2)
	local glow = new("UIGradient", {
		Color = ColorSequence.new(Color3.fromHex(fighter.accent):Lerp(Color3.new(0, 0, 0), 0.55), Color3.fromHex("#050506")),
		Rotation = 90,
	}, medal)
	local _ = glow
	local por = Portrait.create(medal, fighter.look, {
		framing = "head",
		style = Poses.STYLE_OF[fighter.stance] or "unarmed",
		facing = left and 1 or -1,
		Size = UDim2.new(1, -6, 1, -6),
		Position = UDim2.fromOffset(3, 3),
	})
	local mask = Theme.corner(por.frame, 50)
	local _m = mask

	-- health bar
	local barX = left and 120 or -120
	local barFrame = Theme.frame(holder, {
		Size = UDim2.fromOffset(BAR_W, BAR_H),
		Position = UDim2.new(left and 0 or 1, barX, 0, 18),
		AnchorPoint = Vector2.new(left and 0 or 1, 0),
		BackgroundColor3 = Color3.fromHex("#0A0A0C"),
		BackgroundTransparency = 0.1,
		ClipsDescendants = true,
	})
	Theme.stroke(barFrame, C.gold, 1.6)
	local trail = Theme.frame(barFrame, {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(left and 0 or 1, 0),
		AnchorPoint = Vector2.new(left and 0 or 1, 0),
		BackgroundColor3 = Color3.fromHex("#C8281E"),
		BackgroundTransparency = 0,
		ZIndex = 2,
	})
	local fill = Theme.frame(barFrame, {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(left and 0 or 1, 0),
		AnchorPoint = Vector2.new(left and 0 or 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		ZIndex = 3,
	})
	local fillGrad = Theme.gradient(fill, { Color3.fromHex("#F6EFDC"), Color3.fromHex("#C9A24A") }, left and 0 or 180)
	-- glossy highlight
	local gloss = Theme.frame(fill, {
		Size = UDim2.new(1, 0, 0.4, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.7,
	})
	local _g = gloss
	-- notches every 10%
	for i = 1, 9 do
		Theme.frame(barFrame, {
			Size = UDim2.new(0, 1, 1, 0),
			Position = UDim2.fromScale(i / 10, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.55,
			ZIndex = 4,
		})
	end
	local hpText = Theme.label(barFrame, "1000", {
		Size = UDim2.new(1, -12, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		TextXAlignment = left and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left,
		FontFace = F.labelBold,
		TextSize = 15,
		TextColor3 = C.ivory,
		ZIndex = 5,
	})
	Theme.textStroke(hpText, 1.5, 0.15)

	-- name plates
	local name = Theme.label(holder, fighter.name, {
		Size = UDim2.fromOffset(BAR_W, 40),
		Position = UDim2.new(left and 0 or 1, barX, 0, 46),
		AnchorPoint = Vector2.new(left and 0 or 1, 0),
		FontFace = F.display,
		TextSize = 34,
		TextColor3 = C.ivory,
		TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
	})
	Theme.textStroke(name, 2, 0.2)
	local echoName = Theme.label(holder, "\u{2726} " .. echo.name, {
		Size = UDim2.fromOffset(BAR_W, 22),
		Position = UDim2.new(left and 0 or 1, barX, 0, 84),
		AnchorPoint = Vector2.new(left and 0 or 1, 0),
		FontFace = F.label,
		TextSize = 15,
		TextColor3 = Color3.fromHex(echo.accent),
		TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
	})
	Theme.textStroke(echoName, 1.5, 0.3)

	-- round pips (near the timer)
	local pips = {}
	for i = 1, 2 do
		local d = Theme.diamond(holder, 14, Color3.fromHex("#1A1A1E"), {
			Position = UDim2.new(left and 1 or 0, sx * (-16 - (i - 1) * 24), 0, 62),
			ZIndex = 3,
		})
		Theme.stroke(d, C.gold, 1.4)
		pips[i] = d
	end

	-- bottom: meter + echo
	local bottom = Theme.frame(root, {
		Size = UDim2.fromOffset(470, 60),
		Position = UDim2.new(anchorX, left and 40 or -40, 1, -26),
		AnchorPoint = Vector2.new(anchorX, 1),
	})
	local segs = {}
	for i = 1, 3 do
		local seg = Theme.frame(bottom, {
			Size = UDim2.fromOffset(110, 14),
			Position = UDim2.new(left and 0 or 1, sx * (82 + (i - 1) * 118), 0, 30),
			AnchorPoint = Vector2.new(left and 0 or 1, 0),
			BackgroundColor3 = Color3.fromHex("#0A0A0C"),
			BackgroundTransparency = 0.15,
			ClipsDescendants = true,
		})
		Theme.stroke(seg, C.goldDim, 1.2)
		local f = Theme.frame(seg, {
			Size = UDim2.fromScale(0, 1),
			Position = UDim2.fromScale(left and 0 or 1, 0),
			AnchorPoint = Vector2.new(left and 0 or 1, 0),
			BackgroundColor3 = C.meter,
			BackgroundTransparency = 0,
		})
		Theme.gradient(f, { Color3.fromHex("#FFE7A0"), Color3.fromHex("#D08A1A") }, 90)
		segs[i] = { frame = seg, fill = f }
	end
	local meterLabel = Theme.label(bottom, "RAGE  0", {
		Size = UDim2.fromOffset(340, 22),
		Position = UDim2.new(left and 0 or 1, sx * 82, 0, 4),
		AnchorPoint = Vector2.new(left and 0 or 1, 0),
		FontFace = F.labelBold,
		TextSize = 15,
		TextColor3 = C.goldBright,
		TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
	})
	Theme.textStroke(meterLabel, 1.5, 0.3)
	-- echo gauge
	local echoBox = Theme.frame(bottom, {
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.new(left and 0 or 1, 0, 0, 0),
		AnchorPoint = Vector2.new(left and 0 or 1, 0),
		BackgroundColor3 = Color3.fromHex("#0A0A0C"),
		BackgroundTransparency = 0.1,
		ClipsDescendants = true,
	})
	Theme.corner(echoBox, 30)
	local echoStroke = Theme.stroke(echoBox, Color3.fromHex(echo.accent), 2)
	local echoFill = Theme.frame(echoBox, {
		Size = UDim2.fromScale(1, 0),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Color3.fromHex(echo.accent),
		BackgroundTransparency = 0.35,
	})
	local echoLetter = Theme.label(echoBox, string.sub(echo.name, 1, 1), {
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 30,
		TextColor3 = C.ivory,
		ZIndex = 3,
	})
	Theme.textStroke(echoLetter, 1.5, 0.2)

	-- combo counter
	local combo = Theme.frame(root, {
		Size = UDim2.fromOffset(300, 120),
		Position = UDim2.new(anchorX, left and 40 or -40, 0, 250),
		AnchorPoint = Vector2.new(anchorX, 0),
		Visible = false,
	})
	local comboHits = Theme.label(combo, "3 HITS", {
		Size = UDim2.new(1, 0, 0, 60),
		FontFace = F.display,
		TextSize = 56,
		TextColor3 = C.goldBright,
		TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
	})
	Theme.textStroke(comboHits, 3, 0.1)
	local comboDmg = Theme.label(combo, "24%", {
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 58),
		FontFace = F.labelBold,
		TextSize = 26,
		TextColor3 = C.ivory,
		TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
	})
	Theme.textStroke(comboDmg, 2, 0.2)

	return {
		holder = holder,
		portrait = por,
		fill = fill,
		fillGrad = fillGrad,
		trail = trail,
		hpText = hpText,
		pips = pips,
		segs = segs,
		meterLabel = meterLabel,
		echoFill = echoFill,
		echoStroke = echoStroke,
		echoBox = echoBox,
		combo = combo,
		comboHits = comboHits,
		comboDmg = comboDmg,
		trailValue = 1,
		trailDelay = 0,
		lastHp = 1,
		comboTimer = 0,
		echoAccent = Color3.fromHex(echo.accent),
		left = left,
	}
end

function HUD.new(parentRoot: Instance, p1Def, p1Echo, p2Def, p2Echo, opts)
	local self = setmetatable({}, HUD)
	opts = opts or {}
	local root = Theme.frame(parentRoot, { Name = "HUD", Size = UDim2.fromScale(1, 1), ZIndex = 2 })
	self.root = root

	-- top vignette for legibility
	local vig = Theme.frame(root, {
		Size = UDim2.new(1, 0, 0, 190),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0,
		ZIndex = 0,
	})
	Theme.gradient(vig, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, 90, NumberSequence.new(0.35, 1))
	local vigB = Theme.frame(root, {
		Size = UDim2.new(1, 0, 0, 150),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0,
		ZIndex = 0,
	})
	Theme.gradient(vigB, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, 90, NumberSequence.new(1, 0.45))

	self.sides = {
		sideBlock(self, root, 1, p1Def, p1Echo),
		sideBlock(self, root, 2, p2Def, p2Echo),
	}

	-- timer emblem
	local timer = Theme.frame(root, {
		Size = UDim2.fromOffset(110, 110),
		Position = UDim2.new(0.5, 0, 0, 12),
		AnchorPoint = Vector2.new(0.5, 0),
	})
	local plate = Theme.diamond(timer, 76, Color3.fromHex("#0C0D10"), { Position = UDim2.fromScale(0.5, 0.48) })
	plate.BackgroundTransparency = 0.05
	Theme.stroke(plate, C.gold, 2)
	local inner = Theme.diamond(timer, 64, Color3.fromHex("#14151A"), { Position = UDim2.fromScale(0.5, 0.48) })
	Theme.stroke(inner, C.goldDim, 1)
	local timerText = Theme.label(timer, "99", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, -6),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.numbers,
		TextSize = 50,
		TextColor3 = C.goldBright,
		ZIndex = 3,
	})
	Theme.textStroke(timerText, 2, 0.2)
	local roundText = Theme.label(timer, "ROUND 1", {
		Size = UDim2.new(1, 40, 0, 20),
		Position = UDim2.new(0, -20, 1, -8),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 13,
		TextColor3 = C.gold,
	})
	Theme.textStroke(roundText, 1.5, 0.3)
	self.timerText = timerText
	self.roundText = roundText
	self.timerFrame = timer
	if opts.training then
		timerText.Text = "\u{221E}"
		roundText.Text = "PRACTICE"
	end

	-- announcer
	local ann = Theme.frame(root, { Size = UDim2.new(1, 0, 0, 240), Position = UDim2.fromScale(0, 0.36), AnchorPoint = Vector2.new(0, 0.5) })
	local band = Theme.frame(ann, {
		Size = UDim2.new(1, 0, 0, 150),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		Visible = false,
	})
	Theme.gradient(band, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, 0, NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.25, 0.3),
		NumberSequenceKeypoint.new(0.75, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	}))
	local annText = Theme.label(ann, "", {
		Size = UDim2.new(1, 0, 0, 130),
		Position = UDim2.fromScale(0.5, 0.45),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 120,
		TextColor3 = C.ivory,
		TextTransparency = 1,
		ZIndex = 5,
	})
	local annStroke = Theme.textStroke(annText, 4, 0.1)
	local annSub = Theme.label(ann, "", {
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.fromScale(0.5, 0.82),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 26,
		TextColor3 = C.goldBright,
		TextTransparency = 1,
		ZIndex = 5,
	})
	Theme.textStroke(annSub, 2, 0.2)
	local ruleTop = Theme.rule(ann, { Size = UDim2.fromOffset(700, 1), Position = UDim2.new(0.5, 0, 0.5, -76), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false })
	local ruleBot = Theme.rule(ann, { Size = UDim2.fromOffset(700, 1), Position = UDim2.new(0.5, 0, 0.5, 76), AnchorPoint = Vector2.new(0.5, 0.5), Visible = false })
	self.ann = { root = ann, band = band, text = annText, sub = annSub, stroke = annStroke, ruleTop = ruleTop, ruleBot = ruleBot, token = 0 }

	-- super banner
	local banner = Theme.frame(root, {
		Size = UDim2.new(1.4, 0, 0, 110),
		Position = UDim2.fromScale(0.5, 0.62),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = -6,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.25,
		Visible = false,
		ZIndex = 6,
	})
	local bannerGrad = Theme.gradient(banner, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, 0)
	local bannerText = Theme.label(banner, "", {
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 72,
		TextColor3 = C.ivory,
		ZIndex = 7,
	})
	Theme.textStroke(bannerText, 3, 0.1)
	local bannerEdgeT = Theme.frame(banner, { Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = C.gold, BackgroundTransparency = 0, ZIndex = 7 })
	local bannerEdgeB = Theme.frame(banner, { Size = UDim2.new(1, 0, 0, 3), Position = UDim2.fromScale(0, 1), AnchorPoint = Vector2.new(0, 1), BackgroundColor3 = C.gold, BackgroundTransparency = 0, ZIndex = 7 })
	self.banner = { frame = banner, text = bannerText, grad = bannerGrad, edgeT = bannerEdgeT, edgeB = bannerEdgeB }

	-- finisher prompt
	local fin = Theme.frame(root, {
		Size = UDim2.fromOffset(900, 150),
		Position = UDim2.fromScale(0.5, 0.2),
		AnchorPoint = Vector2.new(0.5, 0),
		Visible = false,
		ZIndex = 6,
	})
	local finText = Theme.label(fin, "DELETE THEM", {
		Size = UDim2.new(1, 0, 0, 90),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 78,
		TextColor3 = C.crimsonBright,
		ZIndex = 7,
	})
	Theme.textStroke(finText, 3, 0.05)
	local finHint = Theme.label(fin, "", {
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, 92),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 24,
		TextColor3 = C.ivory,
		ZIndex = 7,
	})
	Theme.textStroke(finHint, 2, 0.2)
	self.finisher = { frame = fin, text = finText, hint = finHint }

	-- screen flash
	self.flashFrame = Theme.frame(root, {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
	})

	-- low health vignette
	self.lowVig = Theme.frame(root, {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.crimson,
		BackgroundTransparency = 1,
		ZIndex = 0,
	})
	Theme.gradient(self.lowVig, { C.crimson, C.crimson }, 0, NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(0.18, 1),
		NumberSequenceKeypoint.new(0.82, 1),
		NumberSequenceKeypoint.new(1, 0.55),
	}))

	-- training readout
	if opts.training then
		local tr = Theme.panel(root, {
			Size = UDim2.fromOffset(330, 150),
			Position = UDim2.new(1, -36, 0, 190),
			AnchorPoint = Vector2.new(1, 0),
		})
		local lines = {}
		for i = 1, 5 do
			lines[i] = Theme.label(tr, "", {
				Size = UDim2.new(1, -24, 0, 24),
				Position = UDim2.fromOffset(12, 8 + (i - 1) * 27),
				FontFace = F.label,
				TextSize = 16,
				TextColor3 = i == 1 and C.goldBright or C.text,
			})
		end
		self.training = { frame = tr, lines = lines }
	end

	return self
end

-------------------------------------------------------------------------------

function HUD:flash(color: Color3?, strength: number?)
	local f = self.flashFrame
	f.BackgroundColor3 = color or Color3.new(1, 1, 1)
	f.BackgroundTransparency = 1 - (strength or 0.6)
	Theme.tween(f, 0.35, { BackgroundTransparency = 1 })
end

function HUD:announce(text: string, sub: string?, opts)
	opts = opts or {}
	local a = self.ann
	a.token += 1
	local token = a.token
	a.text.Text = text
	a.sub.Text = sub or ""
	a.text.TextColor3 = opts.color or C.ivory
	a.text.TextSize = opts.size or 120
	a.band.Visible = opts.band ~= false
	a.ruleTop.Visible = opts.band ~= false
	a.ruleBot.Visible = opts.band ~= false
	a.text.TextTransparency = 0
	a.sub.TextTransparency = sub and 0 or 1
	a.stroke.Transparency = 0.1
	local scale = a.text:FindFirstChildOfClass("UIScale") or new("UIScale", {}, a.text)
	scale.Scale = opts.punch and 1.6 or 1.15
	Theme.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	a.band.BackgroundTransparency = 0.35
	local hold = opts.hold or 1.2
	task.delay(hold, function()
		if a.token ~= token or self.destroyed then
			return
		end
		Theme.tween(a.text, 0.35, { TextTransparency = 1 })
		Theme.tween(a.sub, 0.35, { TextTransparency = 1 })
		Theme.tween(a.stroke, 0.35, { Transparency = 1 })
		Theme.tween(a.band, 0.35, { BackgroundTransparency = 1 })
		task.delay(0.36, function()
			if a.token == token and not self.destroyed then
				a.band.Visible = false
				a.ruleTop.Visible = false
				a.ruleBot.Visible = false
			end
		end)
	end)
end

function HUD:superBanner(text: string, side: number, color: Color3)
	local b = self.banner
	b.text.Text = text
	b.frame.Visible = true
	b.grad.Color = ColorSequence.new(color:Lerp(Color3.new(0, 0, 0), 0.4), Color3.new(0, 0, 0))
	b.grad.Rotation = side == 1 and 0 or 180
	b.frame.Position = UDim2.fromScale(side == 1 and -0.4 or 1.4, 0.62)
	Theme.tween(b.frame, 0.28, { Position = UDim2.fromScale(0.5, 0.62) }, Enum.EasingStyle.Quart)
	task.delay(1.6, function()
		if self.destroyed then
			return
		end
		Theme.tween(b.frame, 0.25, { Position = UDim2.fromScale(side == 1 and 1.4 or -0.4, 0.62) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		task.delay(0.26, function()
			if not self.destroyed then
				b.frame.Visible = false
			end
		end)
	end)
end

function HUD:showFinisherPrompt(show: boolean)
	local f = self.finisher
	f.frame.Visible = show
	if show then
		f.hint.Text = "HOLD " .. Input.glyph("down") .. "  +  " .. Input.glyph("S")
		f.text.TextTransparency = 0
	end
end

function HUD:combo(side: number, hits: number, pct: number)
	local s = self.sides[side]
	if hits < 2 then
		return
	end
	s.combo.Visible = true
	s.comboHits.Text = tostring(hits) .. " HITS"
	s.comboDmg.Text = tostring(math.floor(pct + 0.5)) .. "%  DAMAGE"
	s.comboTimer = 1.3
	local sc = s.comboHits:FindFirstChildOfClass("UIScale") or new("UIScale", {}, s.comboHits)
	sc.Scale = 1.35
	Theme.tween(sc, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	s.comboHits.TextTransparency = 0
	s.comboDmg.TextTransparency = 0
end

function HUD:setRoundPips(w1: number, w2: number)
	for side, w in { w1, w2 } do
		for i, d in self.sides[side].pips do
			d.BackgroundColor3 = (i <= w) and C.goldBright or Color3.fromHex("#1A1A1E")
		end
	end
end

-- Called every render frame with the live match.
function HUD:update(match, dt: number)
	for i, f in match.fighters do
		local s = self.sides[i]
		local hp = math.clamp(f.hp / f.maxHp, 0, 1)
		s.fill.Size = UDim2.fromScale(hp, 1)
		s.hpText.Text = tostring(math.max(0, math.floor(f.hp)))
		if hp < s.lastHp then
			s.trailDelay = 0.55
		end
		s.lastHp = hp
		if s.trailDelay > 0 then
			s.trailDelay -= dt
		else
			s.trailValue = math.max(hp, s.trailValue - dt * 0.55)
		end
		if s.trailValue < hp then
			s.trailValue = hp
		end
		s.trail.Size = UDim2.fromScale(s.trailValue, 1)
		if hp < 0.3 then
			local pulse = 0.5 + 0.5 * math.sin(os.clock() * 8)
			s.fillGrad.Color = ColorSequence.new(Color3.fromHex("#FF8A6A"):Lerp(Color3.fromHex("#E04A3A"), pulse), Color3.fromHex("#8A1A12"))
		else
			s.fillGrad.Color = ColorSequence.new(Color3.fromHex("#F6EFDC"), Color3.fromHex("#C9A24A"))
		end
		-- meter
		local m = f.meter
		for k, seg in s.segs do
			local v = math.clamp((m - (k - 1) * Config.MeterBar) / Config.MeterBar, 0, 1)
			seg.fill.Size = UDim2.fromScale(v, 1)
			seg.frame:FindFirstChildOfClass("UIStroke").Color = (v >= 1) and C.goldBright or C.goldDim
		end
		s.meterLabel.Text = string.format("RAGE  %d", math.floor(m / Config.MeterBar))
		-- echo gauge
		local ready = f.echoCD <= 0
		local e = 1 - math.clamp(f.echoCD / Config.EchoCooldown, 0, 1)
		s.echoFill.Size = UDim2.fromScale(1, e)
		s.echoStroke.Transparency = ready and (0.2 * (0.5 + 0.5 * math.sin(os.clock() * 6))) or 0.6
		-- combo timeout
		if s.comboTimer > 0 then
			s.comboTimer -= dt
			if s.comboTimer <= 0.4 then
				local k = math.clamp(s.comboTimer / 0.4, 0, 1)
				s.comboHits.TextTransparency = 1 - k
				s.comboDmg.TextTransparency = 1 - k
			end
			if s.comboTimer <= 0 then
				s.combo.Visible = false
			end
		end
	end
	-- timer
	if not match.training then
		local secs = math.ceil(match.timer / Config.TickRate)
		self.timerText.Text = tostring(secs)
		self.timerText.TextColor3 = secs <= 10 and C.crimsonBright or C.goldBright
		self.roundText.Text = "ROUND " .. tostring(match.round)
	end
	self:setRoundPips(match.fighters[1].roundWins, match.fighters[2].roundWins)
	-- low health vignette for the human player
	local p1 = match.fighters[1]
	local low = (p1.hp / p1.maxHp) < 0.25 and match.phase == "fight"
	self.lowVig.BackgroundTransparency = low and (0.55 + 0.25 * math.sin(os.clock() * 5)) or 1
end

function HUD:trainingInfo(lines: { string })
	if not self.training then
		return
	end
	for i, l in self.training.lines do
		l.Text = lines[i] or ""
	end
end

function HUD:setVisible(v: boolean)
	self.root.Visible = v
end

function HUD:destroy()
	self.destroyed = true
	self.root:Destroy()
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">MobileControls</string>
              <string name="Source"><![CDATA[--!nonstrict
-- On-screen touch controls: floating thumbstick on the left, a diamond of attack
-- buttons on the right with Block, Echo, Super/Breaker and Throw, plus Pause.
-- Multi-touch safe: each finger is tracked by its InputObject.

local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local Input = require(script.Parent.Parent.Core.Input)

local C = Theme.Colors
local F = Theme.Fonts

local MobileControls = {}
MobileControls.__index = MobileControls

local function circleButton(parent: Instance, label: string, size: number, pos: UDim2, color: Color3, sub: string?)
	local b = Instance.new("TextButton")
	b.Name = label
	b.AutoButtonColor = false
	b.Text = ""
	b.Size = UDim2.fromOffset(size, size)
	b.Position = pos
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.BackgroundColor3 = Color3.fromHex("#0C0D10")
	b.BackgroundTransparency = 0.3
	b.ZIndex = 30
	b.Parent = parent
	Theme.corner(b, size // 2)
	local st = Theme.stroke(b, color, 2.5, 0.1)
	local t = Theme.label(b, label, {
		Size = UDim2.fromScale(1, sub and 0.62 or 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = math.floor(math.min(size * 0.34, size * 1.25 / math.max(1, #label))),
		TextColor3 = C.ivory,
		ZIndex = 31,
	})
	Theme.textStroke(t, 1.5, 0.2)
	if sub then
		Theme.label(b, sub, {
			Size = UDim2.new(1, 0, 0.3, 0),
			Position = UDim2.fromScale(0, 0.58),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = F.labelBold,
			TextSize = math.max(11, math.floor(size * 0.13)),
			TextColor3 = color,
			ZIndex = 31,
		})
	end
	return b, st
end

function MobileControls.new(root: Instance, opts)
	local self = setmetatable({}, MobileControls)
	opts = opts or {}
	local scale = opts.scale or 1
	local gui = Theme.frame(root, { Name = "Touch", Size = UDim2.fromScale(1, 1), ZIndex = 29 })
	self.gui = gui
	self.touches = {}
	self.connections = {}
	self.onPause = opts.onPause

	-- thumbstick
	local base = Theme.frame(gui, {
		Size = UDim2.fromOffset(230 * scale, 230 * scale),
		Position = UDim2.new(0, 210 * scale, 1, -245 * scale),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromHex("#0C0D10"),
		BackgroundTransparency = 0.55,
		ZIndex = 30,
	})
	Theme.corner(base, 115 * scale)
	Theme.stroke(base, C.goldDim, 2, 0.2)
	for i = 0, 3 do
		Theme.diamond(base, 10 * scale, C.gold, {
			Position = UDim2.fromScale(0.5 + math.cos(i * math.pi / 2) * 0.42, 0.5 + math.sin(i * math.pi / 2) * 0.42),
			BackgroundTransparency = 0.4,
			ZIndex = 31,
		})
	end
	local knob = Theme.frame(base, {
		Size = UDim2.fromOffset(96 * scale, 96 * scale),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.fromHex("#2A2B32"),
		BackgroundTransparency = 0.1,
		ZIndex = 32,
	})
	Theme.corner(knob, 48 * scale)
	Theme.stroke(knob, C.gold, 2)
	self.base = base
	self.knob = knob
	self.homePos = base.Position

	-- action cluster (bottom-right)
	local cx, cy = -230 * scale, -250 * scale
	local s = 112 * scale
	local gap = 92 * scale
	local buttons = {
		{ id = "L", label = "L", sub = "LIGHT", pos = UDim2.new(1, cx - gap, 1, cy), color = Color3.fromHex("#E8E2D4") },
		{ id = "H", label = "H", sub = "HEAVY", pos = UDim2.new(1, cx, 1, cy - gap), color = Color3.fromHex("#E8B24A") },
		{ id = "K", label = "K", sub = "KICK", pos = UDim2.new(1, cx, 1, cy + gap), color = Color3.fromHex("#C9A24A") },
		{ id = "S", label = "SP", sub = "SPECIAL", pos = UDim2.new(1, cx + gap, 1, cy), color = Color3.fromHex("#7FE3FF") },
	}
	self.buttons = {}
	for _, def in buttons do
		local b, st = circleButton(gui, def.label, s, def.pos, def.color, def.sub)
		self:bind(b, def.id, st, def.color)
	end
	local blk, blkSt = circleButton(gui, "BLOCK", 128 * scale, UDim2.new(1, cx - gap * 2.5, 1, cy + gap * 0.65), Color3.fromHex("#9AD8FF"))
	self:bind(blk, "B", blkSt, Color3.fromHex("#9AD8FF"))
	local echo, echoSt = circleButton(gui, "FRIEND", 92 * scale, UDim2.new(1, cx - gap * 1.9, 1, cy - gap * 1.25), Color3.fromHex("#7FE3FF"))
	self:bind(echo, "E", echoSt, Color3.fromHex("#7FE3FF"))
	local sup, supSt = circleButton(gui, "SUPER", 92 * scale, UDim2.new(1, cx + gap * 1.05, 1, cy - gap * 1.45), Color3.fromHex("#FF6A4A"))
	self:bind(sup, "X", supSt, Color3.fromHex("#FF6A4A"))
	self.superButton = sup
	local thr, thrSt = circleButton(gui, "THROW", 84 * scale, UDim2.new(1, cx - gap * 0.95, 1, cy - gap * 1.95), Color3.fromHex("#C9A24A"))
	self:bind(thr, "THROW", thrSt, Color3.fromHex("#C9A24A"))

	-- pause
	local pause = Instance.new("TextButton")
	pause.AutoButtonColor = false
	pause.Text = "II"
	pause.FontFace = F.labelBold
	pause.TextSize = 26
	pause.TextColor3 = C.ivory
	pause.Size = UDim2.fromOffset(64, 64)
	pause.Position = UDim2.new(0.5, 0, 0, 150)
	pause.AnchorPoint = Vector2.new(0.5, 0)
	pause.BackgroundColor3 = Color3.fromHex("#0C0D10")
	pause.BackgroundTransparency = 0.3
	pause.ZIndex = 30
	pause.Parent = gui
	Theme.corner(pause, 32)
	Theme.stroke(pause, C.goldDim, 2)
	table.insert(self.connections, pause.Activated:Connect(function()
		if self.onPause then
			self.onPause()
		end
	end))

	-- stick handling: any touch that starts on the left 45% of the screen drives the stick
	table.insert(self.connections, UserInputService.TouchStarted:Connect(function(io, processed)
		if self.stickTouch or not gui.Visible then
			return
		end
		local vp = workspace.CurrentCamera.ViewportSize
		if io.Position.X < vp.X * 0.45 and io.Position.Y > vp.Y * 0.3 then
			self.stickTouch = io
			self.stickOrigin = Vector2.new(io.Position.X, io.Position.Y)
			local _ = processed
		end
	end))
	table.insert(self.connections, UserInputService.TouchMoved:Connect(function(io)
		if io ~= self.stickTouch then
			return
		end
		local d = Vector2.new(io.Position.X, io.Position.Y) - self.stickOrigin
		local radius = base.AbsoluteSize.X * 0.42
		local v = d / math.max(1, radius)
		if v.Magnitude > 1 then
			v = v.Unit
		end
		Input.setStick(v)
		knob.Position = UDim2.fromScale(0.5 + v.X * 0.42, 0.5 + v.Y * 0.42)
	end))
	table.insert(self.connections, UserInputService.TouchEnded:Connect(function(io)
		if io == self.stickTouch then
			self.stickTouch = nil
			Input.setStick(Vector2.zero)
			knob.Position = UDim2.fromScale(0.5, 0.5)
		end
		local id = self.touches[io]
		if id then
			self.touches[io] = nil
			-- release only if no other finger still holds the same button
			local still = false
			for _, other in self.touches do
				if other == id then
					still = true
				end
			end
			if not still then
				Input.setTouch(id, false)
				local entry = self.buttons[id]
				if entry then
					entry.button.BackgroundTransparency = 0.3
					entry.stroke.Thickness = 2.5
				end
			end
		end
	end))
	return self
end

function MobileControls:bind(button: GuiButton, id: string, stroke: UIStroke, color: Color3)
	self.buttons[id] = { button = button, stroke = stroke, color = color }
	table.insert(self.connections, button.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			self.touches[io] = id
			Input.setTouch(id, true)
			button.BackgroundTransparency = 0.05
			stroke.Thickness = 4
			if io.UserInputType == Enum.UserInputType.MouseButton1 then
				task.delay(0.08, function()
					self.touches[io] = nil
					Input.setTouch(id, false)
					button.BackgroundTransparency = 0.3
					stroke.Thickness = 2.5
				end)
			end
		end
	end))
end

-- Light up the super button when 2 bars are available; relabel to BREAK in a combo.
function MobileControls:update(fighter, superCost: number, breakerCost: number)
	local entry = self.buttons.X
	if not entry then
		return
	end
	local inCombo = (fighter.state == "hitstun" or fighter.state == "juggle") and fighter.comboHits >= 2
	local label = entry.button:FindFirstChildOfClass("TextLabel")
	if inCombo then
		if label then
			label.Text = "RAGE"
		end
		entry.stroke.Transparency = fighter.meter >= breakerCost and 0 or 0.7
	else
		if label then
			label.Text = "SUPER"
		end
		entry.stroke.Transparency = fighter.meter >= superCost and 0 or 0.7
	end
	local echo = self.buttons.E
	if echo then
		echo.stroke.Transparency = fighter.echoCD <= 0 and 0 or 0.7
	end
end

function MobileControls:setVisible(v: boolean)
	self.gui.Visible = v
	if not v then
		Input.clearTouch()
	end
end

function MobileControls:destroy()
	for _, c in self.connections do
		c:Disconnect()
	end
	Input.clearTouch()
	self.gui:Destroy()
end

return MobileControls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Portrait</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Live 3D portraits rendered in ViewportFrames (HUD medallions, select grid, versus).

local Render = script.Parent.Parent.Render
local Rig = require(Render.Rig)
local Poses = require(Render.Poses)

local Portrait = {}

-- framing: "head" | "bust" | "full"
function Portrait.create(parent: Instance, look, props)
	props = props or {}
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = props.Size or UDim2.fromScale(1, 1)
	vp.Position = props.Position or UDim2.new()
	vp.AnchorPoint = props.AnchorPoint or Vector2.zero
	vp.Ambient = props.Ambient or Color3.fromRGB(120, 115, 110)
	vp.LightColor = props.LightColor or Color3.fromRGB(255, 240, 220)
	vp.LightDirection = props.LightDirection or Vector3.new(-0.6, -0.5, -1)
	vp.ZIndex = props.ZIndex or 1
	vp.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = props.fov or 30
	cam.Parent = vp
	vp.CurrentCamera = cam

	local rig = Rig.build(look, { world = world, spectral = props.spectral })
	rig.model.Parent = world
	local style = props.style or "unarmed"
	local pose = props.pose or Poses.stance(style)
	local facing = props.facing or 1
	local yaw = math.rad(props.yaw or 30) * facing
	local rootCF = CFrame.new(0, 0, 0) * CFrame.Angles(0, -math.pi / 2 * facing + yaw, 0)
	Rig.apply(rig, rootCF, pose, { time = 0 })

	local framing = props.framing or "head"
	local s = rig.scale
	local headPos = Rig.bonePosition(rig, "Head")
	local target, dist
	if framing == "head" then
		target = headPos + Vector3.new(0, 0.1 * s, 0)
		dist = 4.6 * s
	elseif framing == "bust" then
		target = headPos - Vector3.new(0, 1.0 * s, 0)
		dist = 8.5 * s
	else
		target = Vector3.new(0, 2.8 * s, 0)
		dist = 15 * s
	end
	-- camera in front of the face (rig faces along its LookVector)
	local fwd = (rootCF.LookVector * Vector3.new(1, 0, 1)).Unit
	local side = props.camSide or 0.35
	local right = fwd:Cross(Vector3.yAxis)
	local camPos = target + (fwd + right * side * facing).Unit * dist + Vector3.new(0, 0.25 * s, 0)
	cam.CFrame = CFrame.lookAt(camPos, target)

	local obj = { frame = vp, rig = rig, camera = cam, world = world, rootCF = rootCF, style = style }
	function obj:setPose(p, t)
		Rig.apply(self.rig, self.rootCF, p, { time = t or 0 })
	end
	function obj:destroy()
		vp:Destroy()
	end
	return obj
end

return Portrait
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Screens</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Menu screens. Each screen function builds its UI, yields until the player decides,
-- cleans up and returns the result, so the game flow reads top-to-bottom.
-- All screens work with keyboard, gamepad, mouse and touch.

local RunService = game:GetService("RunService")

local Veil = game:GetService("ReplicatedStorage"):WaitForChild("Veil")
local Config = require(Veil.Config)
local Assets = require(Veil.Assets)
local Fighters = require(Veil.Data.Fighters)
local Echoes = require(Veil.Data.Echoes)
local Stages = require(Veil.Data.Stages)
local MoveKit = require(Veil.Data.MoveKit)

local Client = script.Parent.Parent
local Theme = require(script.Parent.Theme)
local Portrait = require(script.Parent.Portrait)
local Input = require(Client.Core.Input)
local Audio = require(Client.Core.Audio)
local Poses = require(Client.Render.Poses)

local C = Theme.Colors
local F = Theme.Fonts
local new = Theme.new

local Screens = {}

-------------------------------------------------------------------------------
-- helpers
-------------------------------------------------------------------------------

local function waiter()
	local ev = Instance.new("BindableEvent")
	local done = false
	local value = nil
	return {
		resolve = function(v)
			if done then
				return
			end
			done = true
			value = v
			ev:Fire()
		end,
		wait = function()
			if not done then
				ev.Event:Wait()
			end
			ev:Destroy()
			return value
		end,
		done = function()
			return done
		end,
	}
end

local function connections()
	local list = {}
	return {
		add = function(c)
			table.insert(list, c)
			return c
		end,
		clear = function()
			for _, c in list do
				c:Disconnect()
			end
			table.clear(list)
		end,
	}
end

local function screenFrame(root: Instance, name: string)
	return Theme.frame(root, { Name = name, Size = UDim2.fromScale(1, 1), ZIndex = 10 })
end

-- Full-screen key art background with a darkening gradient and drifting embers.
local function backdrop(parent: Instance, darkness: number?, tint: Color3?)
	local bg = Theme.frame(parent, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BackgroundTransparency = 0, ZIndex = 10 })
	local art = Theme.image(bg, Assets.image("KeyArt"), {
		Size = UDim2.fromScale(1.08, 1.08),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ImageTransparency = darkness or 0.35,
		ZIndex = 10,
	})
	if tint then
		art.ImageColor3 = tint
	end
	Theme.tween(art, 30, { Size = UDim2.fromScale(1.16, 1.16) }, Enum.EasingStyle.Linear)
	local shade = Theme.frame(bg, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 11 })
	Theme.gradient(shade, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, 0, NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(0.45, 0.55),
		NumberSequenceKeypoint.new(1, 0.25),
	}))
	-- embers
	local embers = Theme.frame(bg, { Size = UDim2.fromScale(1, 1), ZIndex = 12, ClipsDescendants = true })
	local alive = true
	local function present(): boolean
		local ok, parent = pcall(function()
			return embers.Parent
		end)
		return ok and parent ~= nil
	end
	task.spawn(function()
		while alive and present() do
			local e = Theme.frame(embers, {
				Size = UDim2.fromOffset(math.random(2, 5), math.random(2, 5)),
				Position = UDim2.new(math.random(), 0, 1, 10),
				BackgroundColor3 = math.random() < 0.7 and Color3.fromHex("#FFB04A") or Color3.fromHex("#7DFF8C"),
				BackgroundTransparency = 0.1,
				ZIndex = 12,
			})
			Theme.corner(e, 3)
			local life = 5 + math.random() * 5
			Theme.tween(e, life, {
				Position = UDim2.new(e.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, -0.05, 0),
				BackgroundTransparency = 1,
			}, Enum.EasingStyle.Sine)
			task.delay(life, function()
				e:Destroy()
			end)
			task.wait(0.12)
		end
	end)
	bg.Destroying:Connect(function()
		alive = false
	end)
	return bg, art
end

local function title(parent: Instance, text: string, sub: string?, props)
	local holder = Theme.frame(parent, {
		Size = UDim2.new(1, 0, 0, 120),
		Position = UDim2.new(0, 0, 0, 34),
		ZIndex = 15,
	})
	if props then
		for k, v in props do
			(holder :: any)[k] = v
		end
	end
	local t = Theme.label(holder, text, {
		Size = UDim2.new(1, 0, 0, 70),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 62,
		TextColor3 = C.ivory,
		ZIndex = 16,
	})
	Theme.textStroke(t, 2, 0.3)
	Theme.rule(holder, { Size = UDim2.fromOffset(620, 1), Position = UDim2.new(0.5, 0, 0, 78), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 16 })
	Theme.diamond(holder, 9, C.gold, { Position = UDim2.new(0.5, 0, 0, 78), ZIndex = 17 })
	if sub then
		Theme.label(holder, sub, {
			Size = UDim2.new(1, 0, 0, 30),
			Position = UDim2.fromOffset(0, 88),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = F.label,
			TextSize = 18,
			TextColor3 = C.gold,
			ZIndex = 16,
		})
	end
	return holder, t
end

local function hintBar(parent: Instance, hints: { { string } })
	local bar = Theme.frame(parent, {
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.new(0, 0, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		ZIndex = 18,
	})
	local function refresh()
		for _, ch in bar:GetChildren() do
			if ch:IsA("TextLabel") then
				ch:Destroy()
			end
		end
		local parts = {}
		local pending = ""
		for _, h in hints do
			-- an empty label groups this key with the next hint: "[A] [D]  BROWSE"
			pending ..= "[" .. Input.glyph(h[1]) .. "] "
			if h[2] ~= "" then
				table.insert(parts, pending .. " " .. h[2])
				pending = ""
			end
		end
		Theme.label(bar, table.concat(parts, "        "), {
			Size = UDim2.new(1, -60, 1, 0),
			Position = UDim2.fromOffset(30, 0),
			TextXAlignment = Enum.TextXAlignment.Right,
			FontFace = F.label,
			TextSize = 16,
			TextColor3 = C.textDim,
			ZIndex = 19,
		})
	end
	refresh()
	local conn = Input.modeChanged.Event:Connect(refresh)
	bar.Destroying:Connect(function()
		conn:Disconnect()
	end)
	return bar
end

-- A big serif text button used in vertical menus.
local function menuItem(parent: Instance, text: string, y: number, size: number?)
	local b = new("TextButton", {
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromOffset(520, (size or 46) + 14),
		Position = UDim2.fromOffset(0, y),
		ZIndex = 16,
	}, parent)
	local marker = Theme.diamond(b, 12, C.gold, { Position = UDim2.new(0, 10, 0.5, 0), Visible = false, ZIndex = 17 })
	local l = Theme.label(b, text, {
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.fromOffset(34, 0),
		FontFace = F.display,
		TextSize = size or 46,
		TextColor3 = C.textDim,
		ZIndex = 17,
	})
	Theme.textStroke(l, 1.5, 0.4)
	local line = Theme.rule(b, { Size = UDim2.fromOffset(360, 1), Position = UDim2.new(0, 34, 1, -4), Visible = false, ZIndex = 17 })
	return { button = b, label = l, marker = marker, line = line }
end

local function setItemSelected(item, sel: boolean)
	item.marker.Visible = sel
	item.line.Visible = sel
	Theme.tween(item.label, 0.15, { TextColor3 = sel and C.goldBright or C.textDim })
	Theme.tween(item.label, 0.15, { Position = UDim2.fromOffset(sel and 44 or 34, 0) })
end

-- Generic vertical list navigation. Returns index or nil on back.
local function runList(items, opts)
	opts = opts or {}
	local w = waiter()
	local conns = connections()
	local sel = opts.start or 1
	local function choose(i: number, silent: boolean?)
		if items[sel] then
			setItemSelected(items[sel], false)
		end
		sel = ((i - 1) % #items) + 1
		setItemSelected(items[sel], true)
		if not silent then
			Audio.ui("ui_move")
		end
		if opts.onSelect then
			opts.onSelect(sel)
		end
	end
	choose(sel, true)
	for i, it in items do
		conns.add(it.button.MouseEnter:Connect(function()
			if sel ~= i then
				choose(i)
			end
		end))
		conns.add(it.button.Activated:Connect(function()
			choose(i, true)
			Audio.ui("ui_confirm")
			w.resolve(i)
		end))
	end
	conns.add(Input.nav.Event:Connect(function(action)
		if w.done() then
			return
		end
		if action == "up" then
			choose(sel - 1)
		elseif action == "down" then
			choose(sel + 1)
		elseif action == "confirm" then
			Audio.ui("ui_confirm")
			w.resolve(sel)
		elseif action == "back" and opts.allowBack ~= false then
			Audio.ui("ui_back")
			w.resolve(nil)
		elseif opts.onAction then
			opts.onAction(action, sel)
		end
	end))
	local r = w.wait()
	conns.clear()
	return r
end

local function fadeIn(frame: Instance)
	local cover = Theme.frame(frame, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 60 })
	Theme.tween(cover, 0.45, { BackgroundTransparency = 1 })
	task.delay(0.5, function()
		cover:Destroy()
	end)
end

function Screens.fadeToBlack(root: Instance, time: number?)
	local cover = Theme.frame(root, { Name = "Fade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 90 })
	Theme.tween(cover, time or 0.4, { BackgroundTransparency = 0 })
	task.wait(time or 0.4)
	return cover
end

function Screens.fadeFromBlack(cover: Instance?, time: number?)
	if not cover then
		return
	end
	Theme.tween(cover, time or 0.5, { BackgroundTransparency = 1 })
	task.delay((time or 0.5) + 0.05, function()
		cover:Destroy()
	end)
end

function Screens.loading(root: Instance, text: string?)
	local f = screenFrame(root, "Loading")
	f.ZIndex = 80
	local bg = Theme.frame(f, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 80 })
	local _ = bg
	local emblem = Theme.image(f, Assets.image("Emblem"), {
		Size = UDim2.fromOffset(120, 120),
		Position = UDim2.new(1, -110, 1, -110),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 81,
	})
	local spin = RunService.RenderStepped:Connect(function(dt)
		emblem.Rotation += dt * 60
	end)
	Theme.label(f, text or "JOINING SERVER...", {
		Size = UDim2.fromOffset(600, 40),
		Position = UDim2.new(1, -190, 1, -110),
		AnchorPoint = Vector2.new(1, 0.5),
		TextXAlignment = Enum.TextXAlignment.Right,
		FontFace = F.display,
		TextSize = 30,
		TextColor3 = C.gold,
		ZIndex = 81,
	})
	return function()
		spin:Disconnect()
		Theme.tween(bg, 0.4, { BackgroundTransparency = 1 })
		task.delay(0.42, function()
			f:Destroy()
		end)
	end
end

-------------------------------------------------------------------------------
-- Title
-------------------------------------------------------------------------------

function Screens.title(root: Instance)
	local f = screenFrame(root, "Title")
	backdrop(f, 0.05)
	Audio.music("music_menu")
	local emblem = Theme.image(f, Assets.image("Emblem"), {
		Size = UDim2.fromOffset(230, 230),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ScaleType = Enum.ScaleType.Fit,
		ImageTransparency = 1,
		ZIndex = 20,
	})
	local logo = Theme.label(f, Config.GameTitle, {
		Size = UDim2.new(1, 0, 0, 140),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 150,
		TextColor3 = C.ivory,
		TextTransparency = 1,
		ZIndex = 20,
	})
	local logoStroke = Theme.textStroke(logo, 3, 1)
	Theme.gradient(logo, { Color3.fromHex("#FFF6DE"), Color3.fromHex("#C9A24A") }, 90)
	local sub = Theme.label(f, Config.GameSubtitle, {
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0.5, 0, 0.5, 92),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 24,
		TextColor3 = C.gold,
		TextTransparency = 1,
		ZIndex = 20,
	})
	local rule = Theme.rule(f, { Size = UDim2.fromOffset(0, 1), Position = UDim2.new(0.5, 0, 0.5, 66), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 20 })
	local press = Theme.label(f, "", {
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0.5, 0, 0.82, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 24,
		TextColor3 = C.ivory,
		TextTransparency = 1,
		ZIndex = 20,
	})
	Theme.textStroke(press, 2, 0.3)
	press.Text = Input.mode == "touch" and "TAP TO JOIN (WE'LL WAIT)" or (Input.mode == "gamepad" and "PRESS ANY BUTTON (WE'LL WAIT)" or "PRESS ANY KEY (WE'LL WAIT)")
	Theme.label(f, "v" .. Config.Version .. "   \u{00B7}   A Roblox fighting game parody", {
		Size = UDim2.fromOffset(600, 24),
		Position = UDim2.new(0, 24, 1, -16),
		AnchorPoint = Vector2.new(0, 1),
		FontFace = F.label,
		TextSize = 14,
		TextColor3 = C.textDim,
		ZIndex = 20,
	})
	fadeIn(f)
	task.delay(0.3, function()
		Theme.tween(emblem, 1.4, { ImageTransparency = 0 })
		Theme.tween(rule, 1.2, { Size = UDim2.fromOffset(760, 1) })
	end)
	task.delay(0.8, function()
		Theme.tween(logo, 1.2, { TextTransparency = 0 })
		Theme.tween(logoStroke, 1.2, { Transparency = 0.2 })
	end)
	task.delay(1.4, function()
		Theme.tween(sub, 1.0, { TextTransparency = 0 })
	end)
	local pulse = 0
	local conn = RunService.RenderStepped:Connect(function(dt)
		pulse += dt
		if pulse > 2 then
			press.TextTransparency = 0.25 + 0.6 * (0.5 + 0.5 * math.sin(pulse * 3))
		end
		emblem.Rotation = math.sin(pulse * 0.4) * 3
	end)
	task.wait(1.6)
	local w = waiter()
	local c1 = Input.anyPressed.Event:Connect(function()
		w.resolve(true)
	end)
	local c2 = Input.nav.Event:Connect(function()
		w.resolve(true)
	end)
	w.wait()
	c1:Disconnect()
	c2:Disconnect()
	conn:Disconnect()
	Audio.ui("ui_confirm")
	Theme.tween(press, 0.1, { TextTransparency = 0 })
	local cover = Screens.fadeToBlack(root, 0.5)
	f:Destroy()
	Screens.fadeFromBlack(cover, 0.5)
end

-------------------------------------------------------------------------------
-- Main menu
-------------------------------------------------------------------------------

local MAIN_ITEMS = {
	{ id = "story", text = "STORY", desc = "Chapter I \u{2014} The Great Server Reset. The Admin typed ;shutdown. Only a Noob can stop him." },
	{ id = "ascent", text = "TOWER", desc = "Climb a tower of seven tryhards and dethrone the Admin. Every fighter gets an ending. Most of them are dumb." },
	{ id = "versus", text = "VERSUS", desc = "Pick a fighter, a friend, a server and a victim. The CPU has been practicing." },
	{ id = "practice", text = "PRACTICE", desc = "Beat up a dummy that can't fight back. Or can it? (It can. Press F.)" },
	{ id = "movelist", text = "MOVE LIST", desc = "Every combo, special, super and finisher. Reading is a skill too." },
	{ id = "settings", text = "SETTINGS", desc = "Volume, subtitles, camera shake, CPU difficulty and touch controls." },
}

function Screens.mainMenu(root: Instance, profile)
	local f = screenFrame(root, "MainMenu")
	backdrop(f, 0.45)
	Audio.music("music_menu")
	-- right-hand 3D showcase
	local show = Theme.frame(f, {
		Size = UDim2.fromOffset(700, 860),
		Position = UDim2.new(1, -40, 1, -20),
		AnchorPoint = Vector2.new(1, 1),
		ZIndex = 14,
	})
	local showcase = nil
	local idx = math.random(1, #Fighters.list)
	local function showFighter()
		if showcase then
			local old = showcase
			Theme.tween(old.frame, 0.4, { ImageTransparency = 1 })
			task.delay(0.42, function()
				old:destroy()
			end)
		end
		local def = Fighters.list[idx]
		local style = Poses.STYLE_OF[def.stance] or "unarmed"
		showcase = Portrait.create(show, def.look, {
			framing = "full",
			style = style,
			pose = Poses.WIN[style],
			facing = -1,
			yaw = 40,
			fov = 34,
			camSide = 0.2,
			ZIndex = 14,
		})
		showcase.frame.ImageTransparency = 1
		Theme.tween(showcase.frame, 0.6, { ImageTransparency = 0 })
		showcase.name = def.name
	end
	showFighter()
	local showName = Theme.label(f, "", {
		Size = UDim2.fromOffset(720, 40),
		Position = UDim2.new(1, -60, 1, -60),
		AnchorPoint = Vector2.new(1, 1),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextScaled = true,
		FontFace = F.display,
		TextSize = 30,
		TextColor3 = C.goldBright,
		ZIndex = 16,
	})
	Theme.textStroke(showName, 2, 0.3)
	showName.Text = Fighters.list[idx].name .. "  \u{2014}  " .. string.upper(Fighters.list[idx].title)
	local rotT = 0
	local rot = RunService.RenderStepped:Connect(function(dt)
		rotT += dt
		if rotT > 7 then
			rotT = 0
			idx = idx % #Fighters.list + 1
			showFighter()
			showName.Text = Fighters.list[idx].name .. "  \u{2014}  " .. string.upper(Fighters.list[idx].title)
		end
		if showcase then
			local style = showcase.style
			local p = table.clone(Poses.WIN[style] or Poses.WIN.unarmed)
			local b = math.sin(os.clock() * 2) * 2
			p.UT = { (p.UT and p.UT[1] or 0) + b, p.UT and p.UT[2] or 0, 0 }
			showcase:setPose(p, os.clock())
		end
	end)

	-- logo
	local logo = Theme.label(f, Config.GameTitle, {
		Size = UDim2.fromOffset(740, 90),
		Position = UDim2.fromOffset(90, 70),
		FontFace = F.display,
		TextSize = 74,
		TextColor3 = C.ivory,
		ZIndex = 16,
	})
	Theme.gradient(logo, { Color3.fromHex("#FFF6DE"), Color3.fromHex("#C9A24A") }, 90)
	Theme.textStroke(logo, 2, 0.3)
	Theme.rule(f, { Size = UDim2.fromOffset(520, 1), Position = UDim2.fromOffset(90, 162), ZIndex = 16 })
	Theme.image(f, Assets.image("Emblem"), {
		Size = UDim2.fromOffset(70, 70),
		Position = UDim2.fromOffset(16, 82),
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 16,
	})

	local list = Theme.frame(f, { Size = UDim2.fromOffset(560, 520), Position = UDim2.fromOffset(80, 210), ZIndex = 15 })
	local items = {}
	for i, it in MAIN_ITEMS do
		items[i] = menuItem(list, it.text, (i - 1) * 72, 50)
	end
	local desc = Theme.label(f, "", {
		Size = UDim2.fromOffset(640, 60),
		Position = UDim2.fromOffset(110, 680),
		FontFace = F.serif,
		TextSize = 24,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.text,
		ZIndex = 16,
	})
	if profile then
		Theme.label(f, string.format("WINS %d    \u{00B7}    TOWERS %d    \u{00B7}    STORY %s", profile.wins or 0, profile.ascents or 0, profile.storyDone and "COMPLETE" or "IN PROGRESS"), {
			Size = UDim2.fromOffset(640, 24),
			Position = UDim2.fromOffset(110, 770),
			FontFace = F.label,
			TextSize = 15,
			TextColor3 = C.gold,
			ZIndex = 16,
		})
	end
	hintBar(f, { { "confirm", "SELECT" } })
	fadeIn(f)
	local r = runList(items, {
		start = Screens.lastMain or 1,
		allowBack = false,
		onSelect = function(i)
			desc.Text = MAIN_ITEMS[i].desc
		end,
	})
	Screens.lastMain = r
	rot:Disconnect()
	f:Destroy()
	return MAIN_ITEMS[r].id
end

-------------------------------------------------------------------------------
-- Character select (+ Echo select)
-------------------------------------------------------------------------------

-- opts: { title, step = "fighter"|"echo", side = 1|2, preview = {fighter, echo}?, excludeRandom }
local function fighterPicker(root: Instance, opts)
	local f = screenFrame(root, "Select")
	local bg = backdrop(f, 0.75)
	local _ = bg
	title(f, opts.title or "CHOOSE YOUR FIGHTER", opts.subtitle)
	local list = Fighters.list
	local count = #list + 1 -- + random
	local tiles = {}
	local grid = Theme.frame(f, {
		Size = UDim2.fromOffset(count * 118, 140),
		Position = UDim2.new(0.5, 0, 1, -64),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 15,
	})
	for i = 1, count do
		local def = list[i]
		local tile = new("TextButton", {
			AutoButtonColor = false,
			Text = "",
			Size = UDim2.fromOffset(108, 128),
			Position = UDim2.fromOffset((i - 1) * 118, 0),
			BackgroundColor3 = Color3.fromHex("#0C0D10"),
			BackgroundTransparency = 0.1,
			ZIndex = 16,
		}, grid)
		local stroke = Theme.stroke(tile, C.goldDim, 1.5)
		Theme.gradient(tile, { def and Color3.fromHex(def.accent):Lerp(Color3.new(0, 0, 0), 0.7) or Color3.fromHex("#222222"), Color3.fromHex("#050506") }, 90)
		if def then
			Portrait.create(tile, def.look, {
				framing = "head",
				style = Poses.STYLE_OF[def.stance] or "unarmed",
				Size = UDim2.new(1, -4, 1, -26),
				Position = UDim2.fromOffset(2, 2),
				ZIndex = 17,
			})
		else
			Theme.label(tile, "?", {
				Size = UDim2.new(1, 0, 1, -24),
				TextXAlignment = Enum.TextXAlignment.Center,
				FontFace = F.display,
				TextSize = 70,
				TextColor3 = C.gold,
				ZIndex = 17,
			})
		end
		Theme.label(tile, def and def.short or "RANDOM", {
			Size = UDim2.new(1, 0, 0, 22),
			Position = UDim2.new(0, 0, 1, -22),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = F.labelBold,
			TextSize = 13,
			TextColor3 = C.text,
			BackgroundTransparency = 0.3,
			BackgroundColor3 = Color3.new(0, 0, 0),
			ZIndex = 18,
		})
		tiles[i] = { button = tile, stroke = stroke, def = def }
	end

	-- big preview
	local side = opts.side or 1
	local pv = Theme.frame(f, {
		Size = UDim2.fromOffset(620, 640),
		Position = side == 1 and UDim2.new(0, 40, 0, 120) or UDim2.new(1, -40, 0, 120),
		AnchorPoint = Vector2.new(side == 1 and 0 or 1, 0),
		ZIndex = 14,
	})
	local nameL = Theme.label(f, "", {
		Size = UDim2.fromOffset(700, 70),
		Position = side == 1 and UDim2.new(0, 70, 0, 560) or UDim2.new(1, -70, 0, 560),
		AnchorPoint = Vector2.new(side == 1 and 0 or 1, 0),
		TextXAlignment = side == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		FontFace = F.display,
		TextSize = 64,
		TextColor3 = C.ivory,
		ZIndex = 16,
	})
	Theme.textStroke(nameL, 2, 0.2)
	local titleL = Theme.label(f, "", {
		Size = UDim2.fromOffset(700, 30),
		Position = side == 1 and UDim2.new(0, 72, 0, 628) or UDim2.new(1, -72, 0, 628),
		AnchorPoint = Vector2.new(side == 1 and 0 or 1, 0),
		TextXAlignment = side == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		FontFace = F.labelBold,
		TextSize = 18,
		TextColor3 = C.gold,
		ZIndex = 16,
	})
	-- info panel opposite the preview
	local info = Theme.panel(f, {
		Size = UDim2.fromOffset(520, 300),
		Position = side == 1 and UDim2.new(1, -50, 0, 170) or UDim2.new(0, 50, 0, 170),
		AnchorPoint = Vector2.new(side == 1 and 1 or 0, 0),
		ZIndex = 15,
	})
	local infoText = Theme.label(info, "", {
		Size = UDim2.new(1, -40, 1, -30),
		Position = UDim2.fromOffset(20, 15),
		FontFace = F.serif,
		TextSize = 22,
		TextWrapped = true,
		RichText = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.text,
		ZIndex = 16,
	})

	-- the other side's locked-in pick
	if opts.other then
		local od = Fighters.get(opts.other.fighter)
		local ostyle = Poses.STYLE_OF[od.stance] or "unarmed"
		local opv = Portrait.create(f, od.look, {
			framing = "full",
			style = ostyle,
			pose = Poses.WIN[ostyle],
			facing = side == 1 and -1 or 1,
			yaw = 35,
			Size = UDim2.fromOffset(420, 520),
			Position = side == 1 and UDim2.new(1, -60, 0, 120) or UDim2.new(0, 60, 0, 120),
			AnchorPoint = Vector2.new(side == 1 and 1 or 0, 0),
			ZIndex = 13,
		})
		opv.frame.ImageTransparency = 0.35
		info.Position = side == 1 and UDim2.new(1, -50, 0, 640) or UDim2.new(0, 50, 0, 640)
		info.Size = UDim2.fromOffset(520, 100)
		infoText.TextSize = 18
	end

	local preview = nil
	local sel = opts.start or 1
	local function updatePreview()
		for i, t in tiles do
			t.stroke.Color = (i == sel) and C.goldBright or C.goldDim
			t.stroke.Thickness = (i == sel) and 3 or 1.5
			t.button.Size = (i == sel) and UDim2.fromOffset(108, 136) or UDim2.fromOffset(108, 128)
			t.button.Position = UDim2.fromOffset((i - 1) * 118, (i == sel) and -8 or 0)
		end
		local def = tiles[sel].def
		if preview then
			preview:destroy()
			preview = nil
		end
		if def then
			local style = Poses.STYLE_OF[def.stance] or "unarmed"
			preview = Portrait.create(pv, def.look, {
				framing = "full",
				style = style,
				facing = side == 1 and 1 or -1,
				yaw = 35,
				fov = 32,
				ZIndex = 14,
			})
			preview.def = def
			nameL.Text = def.name
			titleL.Text = string.upper(def.title) .. "   \u{00B7}   " .. string.upper(def.archetype)
			if opts.other then
				infoText.Text = def.bio
			else
				infoText.Text = string.format(
					"<font color='#C9A24A'>REALM</font>  %s\n<font color='#C9A24A'>SUPER</font>  %s\n<font color='#C9A24A'>FINISHER</font>  %s\n\n%s",
					def.realm,
					def.superName,
					def.finisher.name,
					def.bio
				)
			end
		else
			nameL.Text = "RANDOM"
			titleL.Text = "LET THE ALGORITHM DECIDE"
			infoText.Text = "A random fighter will be chosen."
		end
	end
	updatePreview()
	local spinConn = RunService.RenderStepped:Connect(function()
		if preview then
			local p = Poses.idle(preview.style, os.clock())
			preview:setPose(p, os.clock())
		end
	end)
	hintBar(f, { { "left", "" }, { "right", "BROWSE" }, { "confirm", "SELECT" }, { "back", "BACK" } })
	fadeIn(f)

	local w = waiter()
	local conns = connections()
	local function move(d: number)
		sel = ((sel - 1 + d) % count) + 1
		Audio.ui("ui_move")
		updatePreview()
	end
	for i, t in tiles do
		conns.add(t.button.MouseEnter:Connect(function()
			if Input.mode ~= "touch" and sel ~= i then
				sel = i
				Audio.ui("ui_move")
				updatePreview()
			end
		end))
		conns.add(t.button.Activated:Connect(function()
			if sel == i then
				w.resolve(i)
			else
				sel = i
				Audio.ui("ui_move")
				updatePreview()
			end
		end))
	end
	conns.add(Input.nav.Event:Connect(function(a)
		if a == "left" or a == "up" then
			move(-1)
		elseif a == "right" or a == "down" then
			move(1)
		elseif a == "confirm" then
			w.resolve(sel)
		elseif a == "back" then
			w.resolve(nil)
		end
	end))
	local r = w.wait()
	conns.clear()
	spinConn:Disconnect()
	if r then
		Audio.ui("ui_lock")
		local def = tiles[r].def
		if not def then
			def = list[math.random(1, #list)]
		end
		nameL.Text = def.name
		Theme.tween(nameL, 0.1, { TextColor3 = C.goldBright })
		task.wait(0.35)
		f:Destroy()
		return def.id
	end
	Audio.ui("ui_back")
	f:Destroy()
	return nil
end

local function echoPicker(root: Instance, fighterId: string, side: number?)
	local f = screenFrame(root, "EchoSelect")
	backdrop(f, 0.78)
	title(f, "CALL A FRIEND", "YOUR ONE (1) FRIEND WHO SHOWS UP MID-FIGHT")
	local def = Fighters.get(fighterId)
	local style = Poses.STYLE_OF[def.stance] or "unarmed"
	Portrait.create(f, def.look, {
		framing = "full",
		style = style,
		pose = Poses.stance(style),
		facing = 1,
		yaw = 35,
		Size = UDim2.fromOffset(420, 560),
		Position = UDim2.new(0, 30, 0, 150),
		ZIndex = 13,
	})
	local row = Theme.frame(f, {
		Size = UDim2.fromOffset(4 * 230, 360),
		Position = UDim2.new(0.5, 120, 0, 190),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 15,
	})
	local items = {}
	for i, e in Echoes.list do
		local card = new("TextButton", {
			AutoButtonColor = false,
			Text = "",
			Size = UDim2.fromOffset(210, 340),
			Position = UDim2.fromOffset((i - 1) * 230, 0),
			BackgroundColor3 = Color3.fromHex("#0C0D10"),
			BackgroundTransparency = 0.15,
			ZIndex = 16,
		}, row)
		local stroke = Theme.stroke(card, C.goldDim, 1.5)
		Theme.gradient(card, { Color3.fromHex(e.accent):Lerp(Color3.new(0, 0, 0), 0.75), Color3.fromHex("#050506") }, 90)
		Portrait.create(card, e.look, {
			framing = "bust",
			style = "unarmed",
			spectral = Color3.fromHex(e.accent),
			Size = UDim2.new(1, 0, 0, 220),
			ZIndex = 17,
		})
		Theme.label(card, e.name, {
			Size = UDim2.new(1, -16, 0, 50),
			Position = UDim2.fromOffset(8, 222),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = true,
			FontFace = F.display,
			TextSize = 24,
			TextColor3 = C.ivory,
			ZIndex = 17,
		})
		Theme.label(card, string.upper(e.title), {
			Size = UDim2.new(1, -16, 0, 24),
			Position = UDim2.fromOffset(8, 274),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = F.labelBold,
			TextSize = 12,
			TextColor3 = Color3.fromHex(e.accent),
			ZIndex = 17,
		})
		items[i] = { button = card, stroke = stroke, echo = e }
	end
	local info = Theme.panel(f, {
		Size = UDim2.fromOffset(920, 150),
		Position = UDim2.new(0.5, 120, 0, 580),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 15,
	})
	local infoText = Theme.label(info, "", {
		Size = UDim2.new(1, -40, 1, -24),
		Position = UDim2.fromOffset(20, 12),
		FontFace = F.serif,
		TextSize = 21,
		RichText = true,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 16,
	})
	local sel = 1
	local function refresh()
		for i, it in items do
			it.stroke.Color = i == sel and C.goldBright or C.goldDim
			it.stroke.Thickness = i == sel and 3 or 1.5
			it.button.Position = UDim2.fromOffset((i - 1) * 230, i == sel and -10 or 0)
		end
		local e = items[sel].echo
		infoText.Text = string.format(
			"%s\n<font color='#C9A24A'>%s</font>  %s      <font color='#C9A24A'>%s</font>  %s",
			e.bio,
			"[" .. Input.glyph("E") .. "]",
			e.neutral.name,
			"[" .. Input.glyph("down") .. " + " .. Input.glyph("E") .. "]",
			e.down.name
		)
	end
	refresh()
	hintBar(f, { { "left", "" }, { "right", "BROWSE" }, { "confirm", "BRING THEM" }, { "back", "BACK" } })
	fadeIn(f)
	local w = waiter()
	local conns = connections()
	for i, it in items do
		conns.add(it.button.MouseEnter:Connect(function()
			if Input.mode ~= "touch" and sel ~= i then
				sel = i
				Audio.ui("ui_move")
				refresh()
			end
		end))
		conns.add(it.button.Activated:Connect(function()
			if sel == i then
				w.resolve(i)
			else
				sel = i
				refresh()
			end
		end))
	end
	conns.add(Input.nav.Event:Connect(function(a)
		if a == "left" or a == "up" then
			sel = (sel - 2) % #items + 1
			Audio.ui("ui_move")
			refresh()
		elseif a == "right" or a == "down" then
			sel = sel % #items + 1
			Audio.ui("ui_move")
			refresh()
		elseif a == "confirm" then
			w.resolve(sel)
		elseif a == "back" then
			w.resolve(nil)
		end
	end))
	local r = w.wait()
	conns.clear()
	local _ = side
	f:Destroy()
	if r then
		Audio.ui("ui_lock")
		Audio.play("echo_summon", { group = "ui", volume = 0.6 })
		return items[r].echo.id
	end
	Audio.ui("ui_back")
	return nil
end

-- Full selection flow: fighter -> echo (-> opponent). Returns { fighter, echo, opp, oppEcho } or nil.
function Screens.characterSelect(root: Instance, opts)
	opts = opts or {}
	Audio.music("music_select")
	local step = 1
	local result = {}
	while true do
		if step == 1 then
			local id = fighterPicker(root, { title = opts.title or "CHOOSE YOUR FIGHTER", subtitle = opts.subtitle, side = 1, start = opts.startIndex })
			if not id then
				return nil
			end
			result.fighter = id
			step = 2
		elseif step == 2 then
			local e = echoPicker(root, result.fighter, 1)
			if not e then
				step = 1
			else
				result.echo = e
				step = opts.pickOpponent and 3 or 4
			end
		elseif step == 3 then
			local id = fighterPicker(root, {
				title = "CHOOSE YOUR OPPONENT",
				subtitle = "THE CPU WILL FIGHT AS THIS CHALLENGER",
				side = 2,
				other = { fighter = result.fighter },
			})
			if not id then
				step = 2
			else
				result.opp = id
				local echoes = Echoes.list
				result.oppEcho = echoes[math.random(1, #echoes)].id
				step = 4
			end
		else
			return result
		end
	end
end

-------------------------------------------------------------------------------
-- Stage + difficulty select
-------------------------------------------------------------------------------

function Screens.stageSelect(root: Instance, defaultDifficulty: number?)
	local f = screenFrame(root, "StageSelect")
	backdrop(f, 0.85)
	title(f, "PICK A SERVER")
	local stages = {}
	for _, id in Stages.selectable do
		table.insert(stages, Stages.get(id))
	end
	local hero = Theme.frame(f, {
		Size = UDim2.fromOffset(1000, 470),
		Position = UDim2.new(0.5, 0, 0, 160),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromHex("#050506"),
		BackgroundTransparency = 0,
		ClipsDescendants = true,
		ZIndex = 14,
	})
	Theme.stroke(hero, C.gold, 2)
	local heroImg = Theme.image(hero, "", { Size = UDim2.fromScale(1, 1), ZIndex = 14 })
	local heroShade = Theme.frame(hero, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 15 })
	Theme.gradient(heroShade, { Color3.new(0, 0, 0), Color3.new(0, 0, 0) }, 90, NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.55, 0.8),
		NumberSequenceKeypoint.new(1, 0.1),
	}))
	local heroName = Theme.label(hero, "", {
		Size = UDim2.new(1, -60, 0, 70),
		Position = UDim2.new(0, 30, 1, -120),
		FontFace = F.display,
		TextSize = 60,
		TextColor3 = C.ivory,
		ZIndex = 16,
	})
	Theme.textStroke(heroName, 2, 0.2)
	local heroDesc = Theme.label(hero, "", {
		Size = UDim2.new(1, -60, 0, 40),
		Position = UDim2.new(0, 32, 1, -52),
		FontFace = F.serif,
		TextSize = 22,
		TextColor3 = C.text,
		ZIndex = 16,
	})
	local strip = Theme.frame(f, {
		Size = UDim2.fromOffset((#stages + 1) * 196, 110),
		Position = UDim2.new(0.5, 0, 0, 650),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 15,
	})
	local cards = {}
	for i = 1, #stages + 1 do
		local s = stages[i]
		local card = new("TextButton", {
			AutoButtonColor = false,
			Text = "",
			Size = UDim2.fromOffset(184, 104),
			Position = UDim2.fromOffset((i - 1) * 196, 0),
			BackgroundColor3 = Color3.fromHex("#0C0D10"),
			BackgroundTransparency = 0,
			ClipsDescendants = true,
			ZIndex = 16,
		}, strip)
		local stroke = Theme.stroke(card, C.goldDim, 1.5)
		if s then
			local img = Assets.image(s.backdrop)
			if img ~= "" then
				Theme.image(card, img, { Size = UDim2.fromScale(1, 1), ZIndex = 16 })
			else
				Theme.gradient(card, { Color3.fromHex(s.accent):Lerp(Color3.new(0, 0, 0), 0.5), Color3.fromHex("#050506") }, 90)
			end
		end
		Theme.label(card, s and s.name or "RANDOM", {
			Size = UDim2.new(1, -8, 0, 24),
			Position = UDim2.new(0, 4, 1, -24),
			TextXAlignment = Enum.TextXAlignment.Center,
			FontFace = F.labelBold,
			TextSize = 12,
			TextScaled = false,
			TextColor3 = C.ivory,
			BackgroundTransparency = 0.25,
			BackgroundColor3 = Color3.new(0, 0, 0),
			ZIndex = 17,
		})
		cards[i] = { button = card, stroke = stroke, stage = s }
	end
	-- difficulty selector
	local diff = defaultDifficulty or 2
	local diffL = Theme.label(f, "", {
		Size = UDim2.fromOffset(700, 34),
		Position = UDim2.new(0.5, 0, 0, 772),
		AnchorPoint = Vector2.new(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 22,
		TextColor3 = C.goldBright,
		ZIndex = 16,
	})
	local diffLeft = new("TextButton", { Text = "\u{25C0}", FontFace = F.labelBold, TextSize = 24, TextColor3 = C.gold, BackgroundTransparency = 1, Size = UDim2.fromOffset(50, 34), Position = UDim2.new(0.5, -300, 0, 772), ZIndex = 17 }, f)
	local diffRight = new("TextButton", { Text = "\u{25B6}", FontFace = F.labelBold, TextSize = 24, TextColor3 = C.gold, BackgroundTransparency = 1, Size = UDim2.fromOffset(50, 34), Position = UDim2.new(0.5, 250, 0, 772), ZIndex = 17 }, f)
	local function refreshDiff()
		diffL.Text = "CPU DIFFICULTY:  " .. Config.Difficulty[diff].name .. "   [" .. Input.glyph("tabL") .. " / " .. Input.glyph("tabR") .. "]"
	end
	refreshDiff()
	local sel = 1
	local function refresh()
		for i, c in cards do
			c.stroke.Color = i == sel and C.goldBright or C.goldDim
			c.stroke.Thickness = i == sel and 3 or 1.5
		end
		local s = cards[sel].stage
		if s then
			heroImg.Image = Assets.image(s.backdrop)
			heroImg.BackgroundColor3 = Color3.fromHex(s.fogColor)
			heroImg.BackgroundTransparency = heroImg.Image == "" and 0 or 1
			heroName.Text = s.name
			heroDesc.Text = s.desc
		else
			heroImg.Image = Assets.image("KeyArt")
			heroImg.BackgroundTransparency = 1
			heroName.Text = "RANDOM SERVER"
			heroDesc.Text = "Server hopping. The noble way."
		end
	end
	refresh()
	hintBar(f, { { "left", "" }, { "right", "BROWSE" }, { "tabL", "" }, { "tabR", "DIFFICULTY" }, { "confirm", "FIGHT" }, { "back", "BACK" } })
	fadeIn(f)
	local w = waiter()
	local conns = connections()
	for i, c in cards do
		conns.add(c.button.Activated:Connect(function()
			if sel == i then
				w.resolve(i)
			else
				sel = i
				Audio.ui("ui_move")
				refresh()
			end
		end))
		conns.add(c.button.MouseEnter:Connect(function()
			if Input.mode ~= "touch" and sel ~= i then
				sel = i
				Audio.ui("ui_move")
				refresh()
			end
		end))
	end
	conns.add(diffLeft.Activated:Connect(function()
		diff = math.max(1, diff - 1)
		Audio.ui("ui_move")
		refreshDiff()
	end))
	conns.add(diffRight.Activated:Connect(function()
		diff = math.min(#Config.Difficulty, diff + 1)
		Audio.ui("ui_move")
		refreshDiff()
	end))
	conns.add(Input.nav.Event:Connect(function(a)
		if a == "left" or a == "up" then
			sel = (sel - 2) % #cards + 1
			Audio.ui("ui_move")
			refresh()
		elseif a == "right" or a == "down" then
			sel = sel % #cards + 1
			Audio.ui("ui_move")
			refresh()
		elseif a == "tabL" then
			diff = math.max(1, diff - 1)
			Audio.ui("ui_move")
			refreshDiff()
		elseif a == "tabR" then
			diff = math.min(#Config.Difficulty, diff + 1)
			Audio.ui("ui_move")
			refreshDiff()
		elseif a == "confirm" then
			w.resolve(sel)
		elseif a == "back" then
			w.resolve(nil)
		end
	end))
	local r = w.wait()
	conns.clear()
	f:Destroy()
	if not r then
		Audio.ui("ui_back")
		return nil
	end
	Audio.ui("ui_lock")
	local s = cards[r].stage
	if not s then
		s = stages[math.random(1, #stages)]
	end
	return s.id, diff
end

-------------------------------------------------------------------------------
-- Versus splash
-------------------------------------------------------------------------------

function Screens.versus(root: Instance, p1, p2, stageId: string, subtitle: string?)
	local f = screenFrame(root, "Versus")
	local d1 = Fighters.get(p1.fighter)
	local d2 = Fighters.get(p2.fighter)
	local e1 = Echoes.get(p1.echo)
	local e2 = Echoes.get(p2.echo)
	local bg = Theme.frame(f, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.bg, BackgroundTransparency = 0, ZIndex = 10 })
	local _ = bg
	for side, def in { d1, d2 } do
		local half = Theme.frame(f, {
			Size = UDim2.fromScale(0.62, 1.4),
			Position = UDim2.fromScale(side == 1 and -0.12 or 1.12, 0.5),
			AnchorPoint = Vector2.new(side == 1 and 0 or 1, 0.5),
			Rotation = 8,
			BackgroundColor3 = Color3.fromHex(def.accent),
			BackgroundTransparency = 0,
			ClipsDescendants = true,
			ZIndex = 11,
		})
		Theme.gradient(half, { Color3.fromHex(def.accent):Lerp(Color3.new(0, 0, 0), 0.55), Color3.new(0, 0, 0) }, side == 1 and 0 or 180)
		Theme.tween(half, 0.5, { Position = UDim2.fromScale(side == 1 and -0.08 or 1.08, 0.5) }, Enum.EasingStyle.Quart)
		local style = Poses.STYLE_OF[def.stance] or "unarmed"
		local por = Portrait.create(f, def.look, {
			framing = "full",
			style = style,
			pose = Poses.WIN[style],
			facing = side == 1 and 1 or -1,
			yaw = 30,
			fov = 30,
			Size = UDim2.fromOffset(620, 860),
			Position = side == 1 and UDim2.new(0, -20, 1, 0) or UDim2.new(1, 20, 1, 0),
			AnchorPoint = Vector2.new(side == 1 and 0 or 1, 1),
			ZIndex = 12,
		})
		por.frame.Position = side == 1 and UDim2.new(0, -320, 1, 0) or UDim2.new(1, 320, 1, 0)
		Theme.tween(por.frame, 0.6, { Position = side == 1 and UDim2.new(0, -20, 1, 0) or UDim2.new(1, 20, 1, 0) }, Enum.EasingStyle.Quart)
		local nm = Theme.label(f, def.name, {
			Size = UDim2.fromOffset(700, 80),
			Position = side == 1 and UDim2.new(0, 60, 1, -170) or UDim2.new(1, -60, 1, -170),
			AnchorPoint = Vector2.new(side == 1 and 0 or 1, 0),
			TextXAlignment = side == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
			FontFace = F.display,
			TextSize = 76,
			TextColor3 = C.ivory,
			ZIndex = 14,
		})
		Theme.textStroke(nm, 3, 0.1)
		Theme.label(f, "\u{2726} " .. (side == 1 and e1 or e2).name, {
			Size = UDim2.fromOffset(700, 30),
			Position = side == 1 and UDim2.new(0, 64, 1, -92) or UDim2.new(1, -64, 1, -92),
			AnchorPoint = Vector2.new(side == 1 and 0 or 1, 0),
			TextXAlignment = side == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
			FontFace = F.labelBold,
			TextSize = 20,
			TextColor3 = Color3.fromHex((side == 1 and e1 or e2).accent),
			ZIndex = 14,
		})
	end
	local vs = Theme.label(f, "VS", {
		Size = UDim2.fromOffset(400, 220),
		Position = UDim2.fromScale(0.5, 0.45),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 210,
		TextColor3 = C.goldBright,
		TextTransparency = 1,
		ZIndex = 15,
	})
	Theme.gradient(vs, { Color3.fromHex("#FFF6DE"), Color3.fromHex("#B07A1A") }, 90)
	Theme.textStroke(vs, 4, 0.1)
	local sc = new("UIScale", { Scale = 2.4 }, vs)
	task.delay(0.35, function()
		Theme.tween(vs, 0.2, { TextTransparency = 0 })
		Theme.tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
		Audio.play("ui_versus", { group = "ui", volume = 0.9 })
	end)
	local st = Stages.get(stageId)
	Theme.label(f, string.upper(subtitle or st.name), {
		Size = UDim2.fromOffset(800, 30),
		Position = UDim2.new(0.5, 0, 0, 40),
		AnchorPoint = Vector2.new(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 22,
		TextColor3 = C.gold,
		ZIndex = 15,
	})
	task.wait(3.0)
	local cover = Screens.fadeToBlack(root, 0.35)
	f:Destroy()
	return cover
end

-------------------------------------------------------------------------------
-- Ascent ladder / chapter card / ending
-------------------------------------------------------------------------------

function Screens.ladder(root: Instance, ladder, index: number, playerId: string)
	local f = screenFrame(root, "Ladder")
	backdrop(f, 0.8)
	title(f, "THE TOWER", string.format("TRYHARD %d OF %d", index, #ladder))
	local tower = Theme.frame(f, {
		Size = UDim2.fromOffset(300, #ladder * 98),
		Position = UDim2.new(0.5, 280, 0.55, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 15,
	})
	for i = #ladder, 1, -1 do
		local def = Fighters.get(ladder[i].fighter)
		local y = (#ladder - i) * 98
		local cell = Theme.frame(tower, {
			Size = UDim2.fromOffset(300, 88),
			Position = UDim2.fromOffset(0, y),
			BackgroundColor3 = Color3.fromHex("#0C0D10"),
			BackgroundTransparency = i < index and 0.6 or 0.15,
			ZIndex = 16,
		})
		Theme.stroke(cell, i == index and C.goldBright or C.goldDim, i == index and 3 or 1.2)
		Portrait.create(cell, def.look, {
			framing = "head",
			style = Poses.STYLE_OF[def.stance] or "unarmed",
			Size = UDim2.fromOffset(84, 84),
			Position = UDim2.fromOffset(2, 2),
			ZIndex = 17,
		})
		Theme.label(cell, def.name, {
			Size = UDim2.new(1, -100, 1, 0),
			Position = UDim2.fromOffset(96, 0),
			FontFace = F.display,
			TextSize = i == #ladder and 26 or 28,
			TextColor3 = i < index and C.textDim or (i == index and C.goldBright or C.ivory),
			ZIndex = 17,
		})
		if i < index then
			Theme.label(cell, "\u{2715}", {
				Size = UDim2.fromScale(1, 1),
				TextXAlignment = Enum.TextXAlignment.Right,
				FontFace = F.display,
				TextSize = 50,
				TextColor3 = C.crimson,
				ZIndex = 18,
			})
		end
	end
	local pdef = Fighters.get(playerId)
	local style = Poses.STYLE_OF[pdef.stance] or "unarmed"
	Portrait.create(f, pdef.look, {
		framing = "full",
		style = style,
		pose = Poses.stance(style),
		facing = 1,
		yaw = 30,
		Size = UDim2.fromOffset(520, 700),
		Position = UDim2.new(0.5, -250, 1, -30),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 14,
	})
	hintBar(f, { { "confirm", "BEGIN" }, { "back", "ABANDON" } })
	fadeIn(f)
	local w = waiter()
	local c = Input.nav.Event:Connect(function(a)
		if a == "confirm" then
			w.resolve("go")
		elseif a == "back" then
			w.resolve("quit")
		end
	end)
	local c2 = Input.anyPressed.Event:Connect(function()
		if Input.mode == "touch" then
			w.resolve("go")
		end
	end)
	local auto = task.delay(6, function()
		w.resolve("go")
	end)
	local r = w.wait()
	c:Disconnect()
	c2:Disconnect()
	pcall(task.cancel, auto)
	Audio.ui(r == "go" and "ui_confirm" or "ui_back")
	f:Destroy()
	return r
end

function Screens.card(root: Instance, heading: string, name: string, body: string, opts)
	opts = opts or {}
	local f = screenFrame(root, "Card")
	backdrop(f, opts.darkness or 0.6)
	local h = Theme.label(f, heading, {
		Size = UDim2.new(1, 0, 0, 40),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 26,
		TextColor3 = C.gold,
		TextTransparency = 1,
		ZIndex = 16,
	})
	local n = Theme.label(f, name, {
		Size = UDim2.new(1, 0, 0, 100),
		Position = UDim2.new(0.5, 0, 0.3, 64),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 92,
		TextColor3 = C.ivory,
		TextTransparency = 1,
		ZIndex = 16,
	})
	Theme.textStroke(n, 2, 0.3)
	Theme.rule(f, { Size = UDim2.fromOffset(700, 1), Position = UDim2.new(0.5, 0, 0.3, 122), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 16 })
	local b = Theme.label(f, body, {
		Size = UDim2.fromOffset(1100, 300),
		Position = UDim2.new(0.5, 0, 0.3, 150),
		AnchorPoint = Vector2.new(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		FontFace = F.serif,
		TextSize = 30,
		TextColor3 = C.text,
		TextTransparency = 1,
		ZIndex = 16,
	})
	Theme.textStroke(b, 1.5, 0.4)
	hintBar(f, { { "confirm", opts.confirmText or "CONTINUE" } })
	fadeIn(f)
	Theme.tween(h, 1, { TextTransparency = 0 })
	task.delay(0.4, function()
		Theme.tween(n, 1.2, { TextTransparency = 0 })
	end)
	task.delay(1.0, function()
		Theme.tween(b, 1.2, { TextTransparency = 0 })
	end)
	task.wait(1.2)
	local w = waiter()
	local c = Input.nav.Event:Connect(function(a)
		if a == "confirm" or a == "back" then
			w.resolve(a)
		end
	end)
	local c2 = Input.anyPressed.Event:Connect(function()
		if Input.mode == "touch" then
			w.resolve("confirm")
		end
	end)
	local r = w.wait()
	c:Disconnect()
	c2:Disconnect()
	Audio.ui("ui_confirm")
	local cover = Screens.fadeToBlack(root, 0.4)
	f:Destroy()
	Screens.fadeFromBlack(cover, 0.4)
	return r
end

function Screens.ending(root: Instance, fighterId: string)
	local def = Fighters.get(fighterId)
	Audio.music("music_victory")
	for i, para in def.ending do
		Screens.card(root, i == 1 and "TOWER CLEARED" or "", i == 1 and def.name or "", para, { darkness = 0.7 })
	end
end

-------------------------------------------------------------------------------
-- Pause
-------------------------------------------------------------------------------

function Screens.pause(root: Instance, opts)
	opts = opts or {}
	local f = screenFrame(root, "Pause")
	f.ZIndex = 70
	local dim = Theme.frame(f, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, ZIndex = 70 })
	local _ = dim
	local panel = Theme.panel(f, {
		Size = UDim2.fromOffset(560, 560),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 71,
	})
	panel.ZIndex = 71
	Theme.label(panel, "PAUSED", {
		Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromOffset(0, 16),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 60,
		TextColor3 = C.ivory,
		ZIndex = 72,
	})
	Theme.rule(panel, { Size = UDim2.fromOffset(400, 1), Position = UDim2.new(0.5, 0, 0, 100), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 72 })
	local entries = { { "resume", "RESUME" }, { "restart", "RESTART MATCH" }, { "movelist", "MOVE LIST" }, { "settings", "SETTINGS" }, { "quit", "QUIT TO MENU" } }
	if opts.noRestart then
		table.remove(entries, 2)
	end
	local list = Theme.frame(panel, { Size = UDim2.fromOffset(500, 400), Position = UDim2.fromOffset(40, 120), ZIndex = 72 })
	local items = {}
	for i, e in entries do
		local it = menuItem(list, e[2], (i - 1) * 66, 38)
		it.button.ZIndex = 73
		it.label.ZIndex = 74
		items[i] = it
	end
	local r = runList(items, { allowBack = true })
	f:Destroy()
	if not r then
		return "resume"
	end
	return entries[r][1]
end

-------------------------------------------------------------------------------
-- Results
-------------------------------------------------------------------------------

function Screens.results(root: Instance, result, opts)
	opts = opts or {}
	local f = screenFrame(root, "Results")
	backdrop(f, 0.8)
	local wDef = Fighters.get(result.winner == 1 and result.p1.fighter or result.p2.fighter)
	local won = result.winner == 1
	local style = Poses.STYLE_OF[wDef.stance] or "unarmed"
	Portrait.create(f, wDef.look, {
		framing = "full",
		style = style,
		pose = Poses.WIN[style],
		facing = 1,
		yaw = 30,
		Size = UDim2.fromOffset(560, 780),
		Position = UDim2.new(0, 20, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		ZIndex = 13,
	})
	local head = Theme.label(f, won and "BIG W" or "TAKE THE L", {
		Size = UDim2.fromOffset(800, 110),
		Position = UDim2.new(0, 600, 0, 60),
		FontFace = F.display,
		TextSize = 110,
		TextColor3 = won and C.goldBright or C.crimsonBright,
		ZIndex = 16,
	})
	Theme.textStroke(head, 3, 0.2)
	Theme.label(f, wDef.name .. " WINS", {
		Size = UDim2.fromOffset(800, 40),
		Position = UDim2.new(0, 606, 0, 168),
		FontFace = F.labelBold,
		TextSize = 26,
		TextColor3 = C.ivory,
		ZIndex = 16,
	})
	local quote = wDef.victory[1]
	Theme.label(f, "\u{201C}" .. quote .. "\u{201D}", {
		Size = UDim2.fromOffset(820, 40),
		Position = UDim2.new(0, 606, 0, 210),
		FontFace = F.serif,
		TextSize = 26,
		TextColor3 = C.text,
		ZIndex = 16,
	})
	-- stats table
	local stats = Theme.panel(f, { Size = UDim2.fromOffset(820, 340), Position = UDim2.new(0, 600, 0, 270), ZIndex = 15 })
	local rows = {
		{ "DAMAGE DEALT", "damage" },
		{ "HITS LANDED", "hits" },
		{ "BEST COMBO", "maxCombo" },
		{ "SPECIALS", "specials" },
		{ "SUPERS", "supers" },
		{ "ECHO SUMMONS", "echoes" },
		{ "THROWS", "throws" },
		{ "BLOCKS", "blocks" },
	}
	local d1 = Fighters.get(result.p1.fighter)
	local d2 = Fighters.get(result.p2.fighter)
	Theme.label(stats, d1.short, { Size = UDim2.fromOffset(200, 34), Position = UDim2.fromOffset(380, 10), TextXAlignment = Enum.TextXAlignment.Center, FontFace = F.labelBold, TextSize = 18, TextColor3 = Color3.fromHex(d1.accent), ZIndex = 16 })
	Theme.label(stats, d2.short, { Size = UDim2.fromOffset(200, 34), Position = UDim2.fromOffset(600, 10), TextXAlignment = Enum.TextXAlignment.Center, FontFace = F.labelBold, TextSize = 18, TextColor3 = Color3.fromHex(d2.accent), ZIndex = 16 })
	for i, row in rows do
		local y = 44 + (i - 1) * 35
		Theme.label(stats, row[1], { Size = UDim2.fromOffset(340, 30), Position = UDim2.fromOffset(30, y), FontFace = F.label, TextSize = 17, TextColor3 = C.textDim, ZIndex = 16 })
		for side = 1, 2 do
			local v = result.stats[side][row[2]] or 0
			Theme.label(stats, tostring(math.floor(v)), {
				Size = UDim2.fromOffset(200, 30),
				Position = UDim2.fromOffset(side == 1 and 380 or 600, y),
				TextXAlignment = Enum.TextXAlignment.Center,
				FontFace = F.labelBold,
				TextSize = 19,
				TextColor3 = C.ivory,
				ZIndex = 16,
			})
		end
	end
	local entries = opts.entries or { { "rematch", "REMATCH" }, { "select", "CHARACTER SELECT" }, { "menu", "MAIN MENU" } }
	local list = Theme.frame(f, { Size = UDim2.fromOffset(600, 230), Position = UDim2.new(0, 600, 0, 630), ZIndex = 15 })
	local items = {}
	for i, e in entries do
		items[i] = menuItem(list, e[2], (i - 1) * 58, 36)
	end
	fadeIn(f)
	local r = runList(items, { allowBack = false })
	f:Destroy()
	return entries[r][1]
end

-------------------------------------------------------------------------------
-- Move list
-------------------------------------------------------------------------------

function Screens.moveList(root: Instance, startFighter: string?)
	local f = screenFrame(root, "MoveList")
	f.ZIndex = 75
	backdrop(f, 0.88)
	local idx = 1
	if startFighter then
		for i, d in Fighters.list do
			if d.id == startFighter then
				idx = i
			end
		end
	end
	local header = Theme.label(f, "", {
		Size = UDim2.new(1, 0, 0, 70),
		Position = UDim2.fromOffset(0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 60,
		TextColor3 = C.ivory,
		ZIndex = 16,
	})
	local sub = Theme.label(f, "", {
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 100),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 18,
		TextColor3 = C.gold,
		ZIndex = 16,
	})
	local scroll = new("ScrollingFrame", {
		Size = UDim2.fromOffset(1300, 640),
		Position = UDim2.new(0.5, 0, 0, 150),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromHex("#08090C"),
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.gold,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 16,
	}, f)
	Theme.stroke(scroll, C.goldDim, 1.2)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, scroll)
	new("UIPadding", { PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 20), PaddingTop = UDim.new(0, 12) }, scroll)
	local function section(text: string, order: number)
		Theme.label(scroll, text, {
			Size = UDim2.new(1, 0, 0, 42),
			FontFace = F.display,
			TextSize = 30,
			TextColor3 = C.goldBright,
			LayoutOrder = order,
			ZIndex = 17,
		})
	end
	local function row(name: string, input: string, desc: string, order: number)
		local r = Theme.frame(scroll, { Size = UDim2.new(1, 0, 0, 52), LayoutOrder = order, ZIndex = 17, BackgroundColor3 = Color3.fromHex("#14151A"), BackgroundTransparency = 0.4 })
		Theme.label(r, name, { Size = UDim2.fromOffset(360, 28), Position = UDim2.fromOffset(12, 2), FontFace = F.serif, TextSize = 24, TextColor3 = C.ivory, ZIndex = 18 })
		Theme.label(r, input, { Size = UDim2.fromOffset(300, 28), Position = UDim2.fromOffset(380, 2), FontFace = F.labelBold, TextSize = 18, TextColor3 = C.gold, ZIndex = 18 })
		Theme.label(r, desc, { Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 28), FontFace = F.label, TextSize = 14, TextColor3 = C.textDim, ZIndex = 18 })
	end
	local function build()
		for _, ch in scroll:GetChildren() do
			if ch:IsA("GuiObject") then
				ch:Destroy()
			end
		end
		local def = Fighters.list[idx]
		header.Text = def.name
		sub.Text = string.upper(def.title) .. "   \u{00B7}   " .. string.upper(def.archetype)
		local order = 0
		local function nextOrder()
			order += 1
			return order
		end
		section("SPECIALS", nextOrder())
		for _, id in { "SN", "SF", "SB", "SD", "SA" } do
			local m = def.moves[id]
			if m then
				row(m.name, m.input, MoveKit.describe(m), nextOrder())
			end
		end
		section("SUPER  \u{00B7}  2 RAGE BARS", nextOrder())
		row(def.superName, "SUPER  (" .. Input.glyph("X") .. ")", "Cinematic super. Invulnerable on startup. " .. MoveKit.describe(def.moves.SUPER), nextOrder())
		section("FINISHER", nextOrder())
		row(def.finisher.name, "HOLD \u{2193} + SPECIAL at DELETE THEM", def.finisher.desc, nextOrder())
		section("STRINGS & NORMALS", nextOrder())
		for _, id in { "L", "L2", "L3", "H", "H2", "K", "K2", "FH", "BK", "DL", "DH", "DK", "JL", "JH", "JK", "THROW" } do
			local m = def.moves[id]
			if m then
				row(m.name, m.input, MoveKit.describe(m), nextOrder())
			end
		end
		section("SYSTEM", nextOrder())
		row("Call a Friend", "FRIEND  /  \u{2193} + FRIEND", "Your friend runs in and helps. Cooldown " .. tostring(math.floor(Config.EchoCooldown / 60)) .. "s.", nextOrder())
		row("Rage Quit", "SUPER while being comboed", "Costs 1 Rage bar. Bursts you out of a combo.", nextOrder())
		row("Dash / Backdash", "\u{2192}\u{2192}  /  \u{2190}\u{2190}", "Double-tap a direction. Backdash is briefly invulnerable.", nextOrder())
		row("Throw Escape", "BLOCK + LIGHT when grabbed", "Break a throw on reaction.", nextOrder())
		scroll.CanvasPosition = Vector2.zero
	end
	build()
	hintBar(f, { { "left", "" }, { "right", "FIGHTER" }, { "up", "" }, { "down", "SCROLL" }, { "back", "BACK" } })
	local w = waiter()
	local conns = connections()
	conns.add(Input.nav.Event:Connect(function(a)
		if a == "left" or a == "tabL" then
			idx = (idx - 2) % #Fighters.list + 1
			Audio.ui("ui_move")
			build()
		elseif a == "right" or a == "tabR" then
			idx = idx % #Fighters.list + 1
			Audio.ui("ui_move")
			build()
		elseif a == "down" then
			scroll.CanvasPosition += Vector2.new(0, 120)
		elseif a == "up" then
			scroll.CanvasPosition = Vector2.new(0, math.max(0, scroll.CanvasPosition.Y - 120))
		elseif a == "back" or a == "confirm" then
			w.resolve(true)
		end
	end))
	-- touch arrows / back
	local prev = new("TextButton", { Text = "\u{25C0}", FontFace = F.labelBold, TextSize = 40, TextColor3 = C.gold, BackgroundTransparency = 1, Size = UDim2.fromOffset(80, 80), Position = UDim2.new(0.5, -480, 0, 30), ZIndex = 17 }, f)
	local nxt = new("TextButton", { Text = "\u{25B6}", FontFace = F.labelBold, TextSize = 40, TextColor3 = C.gold, BackgroundTransparency = 1, Size = UDim2.fromOffset(80, 80), Position = UDim2.new(0.5, 400, 0, 30), ZIndex = 17 }, f)
	local back = new("TextButton", { Text = "BACK", FontFace = F.labelBold, TextSize = 22, TextColor3 = C.ivory, BackgroundColor3 = Color3.fromHex("#14151A"), BackgroundTransparency = 0.2, Size = UDim2.fromOffset(140, 50), Position = UDim2.fromOffset(30, 30), ZIndex = 17 }, f)
	Theme.stroke(back, C.goldDim, 1.5)
	conns.add(prev.Activated:Connect(function()
		idx = (idx - 2) % #Fighters.list + 1
		build()
	end))
	conns.add(nxt.Activated:Connect(function()
		idx = idx % #Fighters.list + 1
		build()
	end))
	conns.add(back.Activated:Connect(function()
		w.resolve(true)
	end))
	fadeIn(f)
	w.wait()
	conns.clear()
	Audio.ui("ui_back")
	f:Destroy()
end

-------------------------------------------------------------------------------
-- Settings
-------------------------------------------------------------------------------

function Screens.settings(root: Instance, settings)
	local f = screenFrame(root, "Settings")
	f.ZIndex = 75
	backdrop(f, 0.85)
	title(f, "SETTINGS")
	local defs = {
		{ key = "music", label = "MUSIC VOLUME", kind = "slider" },
		{ key = "sfx", label = "EFFECTS VOLUME", kind = "slider" },
		{ key = "voice", label = "VOICE VOLUME", kind = "slider" },
		{ key = "subtitles", label = "SUBTITLES", kind = "toggle" },
		{ key = "shake", label = "CAMERA SHAKE", kind = "toggle" },
		{ key = "difficulty", label = "DEFAULT CPU DIFFICULTY", kind = "choice", choices = { 1, 2, 3, 4 } },
		{ key = "touch", label = "TOUCH CONTROLS", kind = "choice", choices = { "auto", "on", "off" } },
	}
	local list = Theme.frame(f, { Size = UDim2.fromOffset(1000, 600), Position = UDim2.new(0.5, 0, 0, 180), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 15 })
	local items = {}
	local function valueText(d)
		local v = settings[d.key]
		if d.kind == "slider" then
			local n = math.floor((v or 0) * 10 + 0.5)
			return string.rep("\u{25A0}", n) .. string.rep("\u{25A1}", 10 - n)
		elseif d.kind == "toggle" then
			return v and "ON" or "OFF"
		elseif d.key == "difficulty" then
			return Config.Difficulty[v or 2].name
		end
		return string.upper(tostring(v))
	end
	local valueLabels = {}
	for i, d in defs do
		local it = menuItem(list, d.label, (i - 1) * 74, 32)
		it.button.Size = UDim2.fromOffset(1000, 60)
		valueLabels[i] = Theme.label(it.button, valueText(d), {
			Size = UDim2.fromOffset(360, 60),
			Position = UDim2.new(1, -360, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Right,
			FontFace = F.labelBold,
			TextSize = 22,
			TextColor3 = C.goldBright,
			ZIndex = 17,
		})
		items[i] = it
	end
	local function change(i: number, dir: number)
		local d = defs[i]
		if d.kind == "slider" then
			settings[d.key] = math.clamp((settings[d.key] or 0.5) + dir * 0.1, 0, 1)
		elseif d.kind == "toggle" then
			settings[d.key] = not settings[d.key]
		else
			local idx = table.find(d.choices, settings[d.key]) or 1
			idx = (idx - 1 + dir) % #d.choices + 1
			settings[d.key] = d.choices[idx]
		end
		valueLabels[i].Text = valueText(d)
		Audio.setVolumes(settings)
		Audio.ui("ui_move")
	end
	hintBar(f, { { "left", "" }, { "right", "ADJUST" }, { "back", "SAVE & BACK" } })
	fadeIn(f)
	local lastSel = 1
	while true do
		local r = runList(items, {
			start = lastSel,
			allowBack = true,
			onAction = function(action, sel)
				if action == "left" then
					change(sel, -1)
				elseif action == "right" then
					change(sel, 1)
				end
			end,
		})
		if not r then
			break
		end
		lastSel = r
		change(r, 1)
	end
	f:Destroy()
	return settings
end

return Screens
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Subtitles</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Subtitles for story scenes, intros and victory quotes.

local Theme = require(script.Parent.Theme)

local C = Theme.Colors
local F = Theme.Fonts

local Subtitles = {}
Subtitles.enabled = true

local holder, speakerLabel, lineLabel, token = nil, nil, nil, 0

function Subtitles.mount(root: Instance)
	holder = Theme.frame(root, {
		Name = "Subtitles",
		Size = UDim2.new(0, 1200, 0, 110),
		Position = UDim2.new(0.5, 0, 1, -40),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 40,
		Visible = false,
	})
	speakerLabel = Theme.label(holder, "", {
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.labelBold,
		TextSize = 22,
		TextColor3 = C.goldBright,
		ZIndex = 41,
	})
	Theme.textStroke(speakerLabel, 2, 0.15)
	lineLabel = Theme.label(holder, "", {
		Size = UDim2.new(1, 0, 0, 76),
		Position = UDim2.fromOffset(0, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		FontFace = F.serif,
		TextSize = 32,
		TextWrapped = true,
		TextColor3 = C.ivory,
		ZIndex = 41,
	})
	Theme.textStroke(lineLabel, 2.5, 0.1)
end

function Subtitles.show(speaker: string?, text: string, duration: number, color: Color3?)
	if not holder or not Subtitles.enabled then
		return
	end
	token += 1
	local my = token
	holder.Visible = true
	speakerLabel.Text = speaker or ""
	speakerLabel.TextColor3 = color or C.goldBright
	lineLabel.Text = text
	speakerLabel.TextTransparency = 1
	lineLabel.TextTransparency = 1
	Theme.tween(speakerLabel, 0.2, { TextTransparency = 0 })
	Theme.tween(lineLabel, 0.2, { TextTransparency = 0 })
	task.delay(duration, function()
		if token == my then
			Theme.tween(speakerLabel, 0.25, { TextTransparency = 1 })
			Theme.tween(lineLabel, 0.25, { TextTransparency = 1 })
			task.delay(0.26, function()
				if token == my then
					holder.Visible = false
				end
			end)
		end
	end)
end

function Subtitles.hide()
	token += 1
	if holder then
		holder.Visible = false
	end
end

return Subtitles
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Visual language for the OOF FIGHTERS 1 interface: black glass panels, thin engraved
-- gold lines, high-contrast serif display type. All layout is authored at a 1600x900
-- design resolution and scaled with a UIScale, so it fits PC, console and phones.

local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.DesignW = 1600
Theme.DesignH = 900

Theme.Colors = {
	bg = Color3.fromHex("#08090C"),
	panel = Color3.fromHex("#101116"),
	panelHi = Color3.fromHex("#1A1B22"),
	gold = Color3.fromHex("#C9A24A"),
	goldBright = Color3.fromHex("#F0D58A"),
	goldDim = Color3.fromHex("#6E5A2C"),
	ivory = Color3.fromHex("#ECE6D8"),
	text = Color3.fromHex("#E8E2D4"),
	textDim = Color3.fromHex("#8F887A"),
	crimson = Color3.fromHex("#B0141E"),
	crimsonBright = Color3.fromHex("#FF3B3B"),
	jade = Color3.fromHex("#5BFF6A"),
	shadow = Color3.fromHex("#000000"),
	health = Color3.fromHex("#E9DFC6"),
	healthLow = Color3.fromHex("#E04A3A"),
	meter = Color3.fromHex("#E8B24A"),
	echo = Color3.fromHex("#7FE3FF"),
}

Theme.Fonts = {
	display = Font.fromEnum(Enum.Font.Bodoni),
	serif = Font.fromEnum(Enum.Font.Merriweather),
	label = Font.fromEnum(Enum.Font.GothamMedium),
	labelBold = Font.fromEnum(Enum.Font.GothamBold),
	numbers = Font.fromEnum(Enum.Font.Bodoni),
}

local C = Theme.Colors

function Theme.tween(inst: Instance, time: number, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function apply(inst: Instance, props)
	if props then
		for k, v in props do
			if k ~= "children" then
				(inst :: any)[k] = v
			end
		end
	end
	return inst
end

function Theme.new(className: string, props, parent: Instance?)
	local inst = Instance.new(className)
	apply(inst, props)
	if parent then
		inst.Parent = parent
	end
	return inst
end
local new = Theme.new

function Theme.frame(parent: Instance, props)
	local f = new("Frame", {
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, parent)
	apply(f, props)
	return f
end

function Theme.label(parent: Instance, text: string, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = C.text,
		FontFace = Theme.Fonts.label,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		RichText = false,
	}, parent)
	apply(l, props)
	return l
end

function Theme.image(parent: Instance, image: string, props)
	local i = new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = image,
		ScaleType = Enum.ScaleType.Crop,
	}, parent)
	apply(i, props)
	return i
end

function Theme.stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = color or C.gold,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

function Theme.textStroke(parent: Instance, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0.3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
	}, parent)
end

function Theme.corner(parent: Instance, radius: number?)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 4) }, parent)
end

function Theme.gradient(parent: Instance, colors, rotation: number?, transparency)
	local g = new("UIGradient", {
		Color = typeof(colors) == "ColorSequence" and colors or ColorSequence.new(colors[1], colors[2]),
		Rotation = rotation or 0,
	}, parent)
	if transparency then
		g.Transparency = transparency
	end
	return g
end

-- Black glass panel with a thin gold border and an inner highlight line.
function Theme.panel(parent: Instance, props)
	local f = Theme.frame(parent, {
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.18,
	})
	apply(f, props)
	Theme.stroke(f, C.goldDim, 1.2, 0.1)
	Theme.gradient(f, { Color3.fromHex("#1C1D24"), Color3.fromHex("#07080B") }, 90)
	return f
end

-- Horizontal engraved gold rule with fading ends.
function Theme.rule(parent: Instance, props)
	local r = Theme.frame(parent, {
		BackgroundColor3 = C.gold,
		BackgroundTransparency = 0,
		Size = UDim2.new(0, 400, 0, 1),
	})
	apply(r, props)
	Theme.gradient(r, { C.gold, C.gold }, 0, NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.1),
		NumberSequenceKeypoint.new(0.8, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	}))
	return r
end

-- Small rotated diamond ornament.
function Theme.diamond(parent: Instance, size: number, color: Color3?, props)
	local d = Theme.frame(parent, {
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color or C.gold,
		BackgroundTransparency = 0,
		Rotation = 45,
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	apply(d, props)
	return d
end

-- Full-screen root container scaled from the design resolution.
function Theme.root(screenGui: ScreenGui)
	local root = Theme.frame(screenGui, {
		Name = "Root",
		Size = UDim2.fromOffset(Theme.DesignW, Theme.DesignH),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
	})
	local scale = new("UIScale", {}, root)
	local function refit()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(Theme.DesignW, Theme.DesignH)
		local s = math.min(vp.X / Theme.DesignW, vp.Y / Theme.DesignH)
		scale.Scale = math.max(0.3, s)
		-- widen the root to cover ultrawide / tall screens so edge-anchored UI hugs the edges
		root.Size = UDim2.fromOffset(vp.X / scale.Scale, vp.Y / scale.Scale)
	end
	refit()
	local cam = workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(refit)
	end
	return root, scale
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="46">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>