		look = {
			scale = 1.1,
			width = 1.0,
			skin = "#2A2A30",
			torso = "#15171C",
			torsoMat = "Fabric",
			arms = "#15171C",
			armsMat = "Fabric",
			legs = "#101216",
			legsMat = "Fabric",
			hands = "#0E0F12",
			feet = "#0E0F12",
			accent = "#7FE3FF",
			trim = "#4A4F5A",
			glow = "#9FEFFF",
			face = "none",
			hair = "none",
			hairColor = "#000000",
			headwear = "deep_hood",
			mask = "none",
			eyes = "#9FEFFF",
			extras = { "long_coat", "soul_chains" },
			weapon = "lantern",
		},
		neutral = E({
			id = "warden_n",
			name = "Glowstick Grenade",
			input = "ECHO",
			anim = "cast_forward",
			spawn = "behind",
			startup = 14,
			active = 1,
			recovery = 30,
			damage = 0,
			projectile = {
				kind = "lantern_bomb",
				offset = { x = 1.0, y = 4.2 },
