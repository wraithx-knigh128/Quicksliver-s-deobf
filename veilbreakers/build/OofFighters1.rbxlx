}

local Echoes = {}
Echoes.list = list
Echoes.byId = {} :: { [string]: Echo }
for _, e in list do
	Echoes.byId[e.id] = e
end

function Echoes.get(id: string): Echo
	local e = Echoes.byId[id]
	assert(e, "unknown echo " .. tostring(id))
	return e
end

return Echoes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Fighters</string>
            <string name="Source"><![CDATA[--!nonstrict
-- The OOF FIGHTERS 1 roster: eight Roblox-parody fighters, each with standing / crouching /
-- air normals, target-combo strings, four specials (neutral, forward, back, down),
-- a meter super, a throw and a post-match finisher.
--
-- Hitbox convention: box.x is the forward offset of the box centre from the fighter's
-- centre line, box.y the height of the centre above the fighter's feet (studs).

local MoveKit = require(script.Parent.MoveKit)
local M = MoveKit.move

export type Look = {
	scale: number,
	width: number,
	skin: string,
	torso: string,
	torsoMat: string,
	arms: string,
	armsMat: string,
	legs: string,
	legsMat: string,
	hands: string,
	feet: string,
	accent: string,
	trim: string,
	glow: string,
	face: string, -- "plain" | "scarred" | "none"
	hair: string,
	hairColor: string,
	headwear: string,
	mask: string,
	eyes: string?,
	extras: { string },
	weapon: string,
}

export type Fighter = {
	id: string,
	name: string,
	short: string,
	title: string,
	realm: string,
	archetype: string,
	bio: string,
	accent: string,
	health: number,
	walkMult: number,
	weight: number,
	stance: string,
	look: Look,
	moves: { [string]: MoveKit.Move },
	order: { string },
	superName: string,
	finisher: { name: string, desc: string, style: string },
	ai: {
		range: number,
		zoning: number,
		projectile: string?,
		antiAir: string,
		approach: string?,
		pokes: { string },
		mixups: { string },
		punish: { string },
		combos: { { string } },
		juggle: { string },
	},
	intro: { string },
	victory: { string },
	ending: { string },
	voice: string, -- "male" | "female" | "deep" | "hollow"
}

-------------------------------------------------------------------------------
-- Shared normal templates
-------------------------------------------------------------------------------

