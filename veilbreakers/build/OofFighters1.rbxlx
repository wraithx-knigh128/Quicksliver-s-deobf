local Fighters = {}
Fighters.list = list
Fighters.byId = {} :: { [string]: Fighter }
for i, f in list do
	Fighters.byId[f.id] = f
	;(f :: any).index = i
end

Fighters.selectable = {} :: { string }
for _, f in list do
	table.insert(Fighters.selectable, f.id)
end

function Fighters.get(id: string): Fighter
	local f = Fighters.byId[id]
	assert(f, "unknown fighter " .. tostring(id))
	return f
end

return Fighters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">MoveKit</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Helpers for authoring move data compactly. Every move ends up as a plain table
-- the combat engine reads directly (no Roblox types, so it runs headless in tests).

export type Box = { x: number, y: number, w: number, h: number }

export type Projectile = {
	kind: string, -- visual id used by the renderer
	spawnFrame: number?, -- frame of the move that spawns it (defaults to startup)
	offset: { x: number, y: number }?,
	vx: number,
	vy: number?,
	gravity: number?,
	life: number,
	box: { w: number, h: number },
	damage: number,
	guard: string?,
	onHit: number?,
	onBlock: number?,
	launch: { vx: number, vy: number }?,
	knockdown: boolean?,
	hits: number?,
	hitEvery: number?,
	returns: boolean?, -- boomerang: reverses after half its life
	ground: boolean?, -- travels along the floor
	stationary: boolean?,
	pull: number?, -- pulls the victim toward the owner on hit
	absorbs: boolean?, -- destroys enemy projectiles it touches
	strength: string?,
	element: string?,
	spawnAt: string?, -- "self" | "opponent" | "ahead"
	ahead: number?,
	delay: number?,
}

export type Move = {
	id: string,
	name: string,
	input: string,
	kind: string,
	anim: string,
	startup: number,
	active: number,
	recovery: number,
	damage: number,
	guard: string,
	onHit: number,
	onBlock: number,
	push: number,
	blockPush: number,
	box: Box?,
	strength: string,
	launch: { vx: number, vy: number }?,
	knockdown: boolean?,
	hits: number?,
	hitEvery: number?,
	chain: { [string]: string }?,
	chainFrom: number?, -- earliest frame (from move start) a chain input is accepted
	specialCancel: boolean?,
	meter: number?,
	motion: { { from: number, to: number, vx: number, vy: number? } }?,
	invuln: { number }?,
	armor: { number }?,
	projectile: Projectile?,
	teleport: { frame: number, mode: string, dist: number? }?,
	grab: boolean?,
	parry: { from: number, to: number, counter: string }?,
	air: boolean?,
	landRecovery: number?,
	cost: number?,
	sfx: string?,
	hitSfx: string?,
	vfx: string?,
	element: string?,
	trail: boolean?,
	jumpArc: { vx: number, vy: number, frame: number }?,
	hitsBehind: boolean?,
	lowProfile: boolean?,
	crouching: boolean?,
	cinematic: string?,
	frameData: string?,
	desc: string?,
}

local MoveKit = {}

local STRENGTH_BY_KIND = {
	normal = "medium",
	special = "special",
	super = "super",
	throw = "heavy",
	air = "medium",
}

-- Fill defaults so the engine never has to nil-check common fields.
function MoveKit.move(t: { [string]: any }): Move
	local m: { [string]: any } = table.clone(t)
	m.kind = m.kind or "normal"
	m.name = m.name or m.id
	m.input = m.input or ""
	m.anim = m.anim or "jab"
	m.startup = m.startup or 8
	m.active = m.active or 3
	m.recovery = m.recovery or 12
	m.damage = m.damage or 40
	m.guard = m.guard or "mid"
	m.onHit = m.onHit or 2
	m.onBlock = m.onBlock or -2
	m.push = m.push or 0.22
	m.blockPush = m.blockPush or (m.push * 1.15)
	if not m.strength then
		if m.kind == "normal" or m.kind == "air" then
			if m.damage < 36 then
				m.strength = "light"
			elseif m.damage < 58 then
				m.strength = "medium"
			else
				m.strength = "heavy"
			end
		else
			m.strength = STRENGTH_BY_KIND[m.kind] or "medium"
		end
	end
	if m.kind == "air" then
		m.air = true
		m.landRecovery = m.landRecovery or 3
	end
	return (m :: any) :: Move
end

-- Readable frame-data summary for the move list screen.
function MoveKit.describe(m: Move): string
	local function signed(n: number): string
		if n > 0 then
			return "+" .. tostring(n)
		end
		return tostring(n)
	end
	local guard = string.upper(m.guard)
	if m.grab then
		guard = "GRAB"
	end
	local hitAdv = signed(m.onHit)
	if m.launch then
		hitAdv = "LAUNCH"
	elseif m.knockdown then
		hitAdv = "KD"
	end
	return string.format(
		"%s  |  DMG %d  |  START %d  |  ON HIT %s  |  ON BLOCK %s",
		guard,
		m.damage,
		m.startup,
		hitAdv,
		signed(m.onBlock)
	)
end

return MoveKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Stages</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Arena metadata. Geometry, props, lighting and particles are built by the client's
-- StageBuilder from the `theme` id; everything tunable lives here.

export type Stage = {
	id: string,
	name: string,
	realm: string,
	desc: string,
	theme: string,
	music: string,
	ambience: string,
	backdrop: string,
	accent: string,
	fogColor: string,
	ambient: string,
	clockTime: number,
	floorColor: string,
	floorMaterial: string,
	selectable: boolean,
}

local list: { Stage } = {
	{
		id = "hollowroot",
		name = "THE SPOOKY OBBY FOREST",
		realm = "Horror Game Lobby",
		desc = "A haunted forest from a horror game that never got finished. The trees have glowing eyes. Nobody added collisions.",
		theme = "forest",
		music = "music_battle_b",
		ambience = "amb_forest",
		backdrop = "Backdrop_hollowroot",
		accent = "#5BFF6A",
		fogColor = "#1C2A22",
		ambient = "#2A3A30",
		clockTime = 0.3,
		floorColor = "#2A2620",
		floorMaterial = "Mud",
		selectable = true,
	},
	{
		id = "skyreach",
		name = "ANIME DOJO SIMULATOR",
		realm = "Anime Fighting Sim",
		desc = "A snowy mountain dojo where everyone shouts their attack names. Rebirth required to enter.",
		theme = "monastery",
		music = "music_battle_a",
		ambience = "amb_wind",
		backdrop = "Backdrop_skyreach",
		accent = "#FFB25A",
		fogColor = "#6A5A6E",
		ambient = "#4A3E48",
		clockTime = 17.9,
		floorColor = "#D8D4CE",
		floorMaterial = "Snow",
		selectable = true,
	},
	{
		id = "cathedral",
		name = "FLOODED CHURCH ESCAPE",
		realm = "Flood Escape Map",
		desc = "The water is rising, the choir is still singing, and nobody pressed the button.",
		theme = "cathedral",
		music = "music_battle_b",
		ambience = "amb_cathedral",
		backdrop = "Backdrop_cathedral",
		accent = "#A86BFF",
		fogColor = "#151A2A",
		ambient = "#2A2A44",
		clockTime = 0.0,
		floorColor = "#2A2C33",
		floorMaterial = "Slate",
		selectable = true,
	},
	{
		id = "emberthrone",
		name = "THE ADMIN'S LAVA THRONE",
		realm = "The Floor Is Lava",
		desc = "The Admin's private throne room. The floor is lava. He typed that in on purpose.",
		theme = "volcano",
		music = "music_boss",
		ambience = "amb_lava",
		backdrop = "Backdrop_emberthrone",
		accent = "#FF5A2E",
		fogColor = "#2A0E08",
		ambient = "#4A2418",
		clockTime = 0.0,
		floorColor = "#1C1714",
		floorMaterial = "Basalt",
		selectable = true,
	},
	{
		id = "baseplate",
		name = "THE BASEPLATE",
		realm = "Every Game Ever (At First)",
		desc = "Gray. Flat. Infinite. Where every great game began, and where most of them were abandoned.",
		theme = "baseplate",
		music = "music_battle_a",
		ambience = "amb_wind",
		backdrop = "Backdrop_baseplate",
		accent = "#A3A2A5",
		fogColor = "#B9D7F2",
		ambient = "#8A8C92",
		clockTime = 14.0,
		floorColor = "#A3A2A5",
		floorMaterial = "SmoothPlastic",
		selectable = true,
	},
	{
		id = "proving",
		name = "THE TRAINING ROOM",
		realm = "Studio Test Mode",
		desc = "A quiet practice room that only exists when you press Play Solo.",
		theme = "proving",
		music = "music_select",
		ambience = "",
		backdrop = "Backdrop_proving",
		accent = "#C9A24A",
		fogColor = "#101114",
		ambient = "#3A3A40",
		clockTime = 0.0,
		floorColor = "#1A1B1F",
		floorMaterial = "Slate",
		selectable = false,
	},
}

local Stages = {}
Stages.list = list
Stages.byId = {} :: { [string]: Stage }
Stages.selectable = {} :: { string }
for _, s in list do
	Stages.byId[s.id] = s
	if s.selectable then
		table.insert(Stages.selectable, s.id)
	end
end

function Stages.get(id: string): Stage
	local s = Stages.byId[id]
	assert(s, "unknown stage " .. tostring(id))
	return s
end

return Stages
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Story</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Story Mode: "Chapter I - The Great Server Reset".
-- A chapter is a list of beats: cinematic scenes (in-engine, letterboxed, subtitled)
-- and fights. Camera shots are authored as presets relative to the actors so the
-- CutscenePlayer can frame them on any stage.

export type Line = { speaker: string, text: string, voice: string? }

export type Shot = {
	cam: string, -- wide | two | close | over | sky | low | pan
	a: number?,
	b: number?,
	duration: number?,
	lines: { Line }?,
	caption: string?,
	events: { { [string]: any } }?,
}

export type Scene = {
	type: string, -- "scene" | "fight"
	stage: string,
	actors: { { id: string, x: number, facing: number, anim: string?, hidden: boolean? } }?,
	shots: { Shot }?,
	-- fight fields
	player: string?,
	playerEcho: string?,
	opponent: string?,
	opponentEcho: string?,
	difficulty: number?,
	boss: boolean?,
	title: string?,
}

local Story = {}

Story.chapters = {
	{
		id = "ch1",
		number = "CHAPTER I",
		name = "THE GREAT SERVER RESET",
		synopsis = "The Admin has typed ;shutdown. Every tycoon, every obby, every 400-Robux pair of wings is about to be deleted. Only a Noob stands in his way. This is fine.",
		beats = {
			{
				type = "scene",
				stage = "skyreach",
				actors = {
					{ id = "noob", x = -2.5, facing = 1, anim = "stance" },
					{ id = "bacon", x = 2.5, facing = -1, anim = "stance" },
					{ id = "guest", x = 0, facing = -1, anim = "stance", hidden = true },
				},
				shots = {
					{
						cam = "sky",
						duration = 4.5,
						caption = "ANIME DOJO SIMULATOR  \u{2014}  SERVER UPTIME: 847 DAYS",
					},
					{
						cam = "two",
						a = 1,
						b = 2,
						lines = {
							{ speaker = "bacon", text = "Your guard drops every time you check your phone, Noob." },
							{ speaker = "noob", text = "I'm not checking my phone. I'm AFK. I fight better AFK." },
							{ speaker = "bacon", text = "The chat's been weird all day. People keep typing 'it's happening'." },
							{ speaker = "noob", text = "Probably another free Robux scam. ...Probably." },
						},
					},
					{
						cam = "sky",
						duration = 3.4,
						events = { { t = 0.4, type = "vfx", kind = "rift" }, { t = 0.4, type = "sfx", key = "lightning_crack" } },
						lines = { { speaker = "bacon", text = "Uh. Why is the sky... buffering?" } },
					},
					{
						cam = "wide",
						events = {
							{ t = 0.2, type = "show", actor = 3 },
							{ t = 0.2, type = "vfx", kind = "teleport", actor = 3 },
							{ t = 0.2, type = "sfx", key = "teleport" },
						},
						lines = { { speaker = "system", text = "Guest 666 has joined the game." } },
					},
					{
						cam = "close",
						a = 1,
						lines = { { speaker = "noob", text = "Guests were removed years ago. How are you even here?" } },
					},
					{
						cam = "close",
						a = 3,
						lines = {
							{ speaker = "guest", text = "The Admin sends his regards. He's shutting the server down. And he wants your sword." },
						},
					},
					{
						cam = "over",
						a = 1,
						b = 3,
						lines = {
							{ speaker = "noob", text = "It's a free gear. He can literally just get one." },
							{ speaker = "guest", text = "He wants YOURS." },
						},
					},
				},
			},
			{
				type = "fight",
				title = "THE NOOB  VS  GUEST 666",
				stage = "skyreach",
				player = "noob",
				playerEcho = "grandpa",
				opponent = "guest",
				opponentEcho = "pigeon",
				difficulty = 1,
			},
			{
				type = "scene",
				stage = "skyreach",
				actors = {
					{ id = "noob", x = -2.2, facing = 1, anim = "stance" },
					{ id = "guest", x = 2.2, facing = -1, anim = "dazed" },
					{ id = "bacon", x = -5.5, facing = 1, anim = "stance" },
				},
				shots = {
					{
						cam = "close",
						a = 2,
						lines = { { speaker = "system", text = "Guest 666 has left the game." } },
						events = {
							{ t = 1.6, type = "vfx", kind = "teleport", actor = 2 },
							{ t = 1.6, type = "hide", actor = 2 },
							{ t = 1.6, type = "sfx", key = "teleport" },
						},
						duration = 3.0,
					},
					{
						cam = "two",
						a = 3,
						b = 1,
						lines = {
							{ speaker = "bacon", text = "It glitched into the forest map. The one nobody finished building." },
							{ speaker = "bacon", text = "If the Admin shuts the server down, I lose my wings. My four hundred Robux wings." },
							{ speaker = "noob", text = "Then we stop him before the timer hits zero. Let's go." },
						},
					},
				},
			},
			{
				type = "scene",
				stage = "hollowroot",
				actors = {
					{ id = "bacon", x = -2.4, facing = 1, anim = "stance" },
					{ id = "noob", x = -5.2, facing = 1, anim = "stance" },
					{ id = "studzilla", x = 3.0, facing = -1, anim = "stance", hidden = true },
				},
				shots = {
					{ cam = "sky", duration = 4.2, caption = "THE SPOOKY OBBY FOREST  \u{2014}  COLLISIONS: OFF" },
					{
						cam = "wide",
						events = {
							{ t = 0.3, type = "show", actor = 3 },
							{ t = 0.3, type = "vfx", kind = "roots", actor = 3 },
							{ t = 0.3, type = "sfx", key = "ground_slam" },
							{ t = 0.4, type = "shake", amount = 0.6 },
						},
						lines = { { speaker = "studzilla", text = "WHO. DARES. ENTER. MY. UNFINISHED. MAP." } },
					},
					{
						cam = "close",
						a = 1,
						lines = { { speaker = "bacon", text = "Whoa, big guy! We're not here to grief your build!" } },
					},
					{
						cam = "low",
						a = 3,
						lines = { { speaker = "studzilla", text = "EVERYONE. SAYS. THAT. THEN. THEY. DELETE. MY. BRICKS." } },
					},
					{
						cam = "two",
						a = 2,
						b = 1,
						lines = {
							{ speaker = "bacon", text = "Stand back, Noob. I speak fluent block." },
						},
					},
				},
			},
			{
				type = "fight",
				title = "BACON HAIR  VS  STUDZILLA",
				stage = "hollowroot",
				player = "bacon",
				playerEcho = "dana",
				opponent = "studzilla",
				opponentEcho = "nightguard",
				difficulty = 2,
			},
			{
				type = "scene",
				stage = "hollowroot",
				actors = {
					{ id = "bacon", x = -2.4, facing = 1, anim = "stance" },
					{ id = "studzilla", x = 2.6, facing = -1, anim = "kneel" },
					{ id = "noob", x = -5.2, facing = 1, anim = "stance" },
				},
				shots = {
					{
						cam = "close",
						a = 2,
						lines = {
							{ speaker = "studzilla", text = "...YOU. DID. NOT. DELETE. ME. RESPECT." },
							{ speaker = "studzilla", text = "THE ADMIN. ANCHORED. MY FRIENDS. THEN. HE. DELETED. THEM. ALL." },
						},
					},
					{
						cam = "two",
						a = 1,
						b = 2,
						lines = {
							{ speaker = "bacon", text = "That monster. Who deletes builds?!" },
							{ speaker = "studzilla", text = "PATH. TO. ADMIN. THROUGH. FLOOD. MAP. I. COME. WITH. YOU." },
						},
					},
				},
			},
			{
				type = "scene",
				stage = "cathedral",
				actors = {
					{ id = "studzilla", x = -2.6, facing = 1, anim = "stance" },
					{ id = "camper", x = 3.2, facing = -1, anim = "stance", hidden = true },
					{ id = "noob", x = -6.0, facing = 1, anim = "stance" },
				},
				shots = {
					{ cam = "sky", duration = 4.2, caption = "FLOODED CHURCH ESCAPE  \u{2014}  THE WATER IS RISING (AGAIN)" },
					{
						cam = "wide",
						events = {
							{ t = 0.5, type = "sfx", key = "crossbow" },
							{ t = 0.7, type = "vfx", kind = "bolt_impact", actor = 1 },
							{ t = 0.9, type = "show", actor = 2 },
							{ t = 0.9, type = "vfx", kind = "smoke", actor = 2 },
						},
						lines = {
							{ speaker = "camper", text = "Don't mind me. Just a bush. A completely normal bush with a crossbow." },
						},
					},
					{
						cam = "close",
						a = 2,
						lines = { { speaker = "camper", text = "The Admin promised me VIP if I camp this spot. I've been here six days." } },
					},
					{
						cam = "low",
						a = 1,
						lines = { { speaker = "studzilla", text = "NOOB. GO. AHEAD. I. WILL. UN-BUSH. HER." } },
					},
				},
			},
			{
				type = "fight",
				title = "STUDZILLA  VS  THE CAMPER",
				stage = "cathedral",
				player = "studzilla",
				playerEcho = "nightguard",
				opponent = "camper",
				opponentEcho = "pigeon",
				difficulty = 2,
			},
			{
				type = "scene",
				stage = "cathedral",
				actors = {
					{ id = "studzilla", x = -2.4, facing = 1, anim = "stance" },
					{ id = "camper", x = 2.6, facing = -1, anim = "kneel" },
				},
				shots = {
					{
						cam = "close",
						a = 2,
						lines = {
							{ speaker = "camper", text = "...Okay, okay. The VIP was fake anyway. He literally said 'trust me bro'." },
							{ speaker = "camper", text = "His throne's past the lava. The floor is lava. He typed it. Like, actually." },
						},
					},
					{
						cam = "two",
						a = 1,
						b = 2,
						lines = { { speaker = "studzilla", text = "WE. CAMP. TOGETHER. NOW. FRIEND." } },
					},
				},
			},
			{
				type = "scene",
				stage = "emberthrone",
				actors = {
					{ id = "noob", x = -3.4, facing = 1, anim = "stance" },
					{ id = "admin", x = 3.6, facing = -1, anim = "stance" },
				},
				shots = {
					{ cam = "sky", duration = 4.4, caption = "THE ADMIN'S LAVA THRONE  \u{2014}  SERVER SHUTDOWN IN 99 SECONDS" },
					{
						cam = "low",
						a = 2,
						lines = {
							{
								speaker = "admin",
								text = "A Noob. A Bacon Hair. A bush. And... is that a pile of bricks? I've seen better lobbies on a Tuesday.",
							},
						},
					},
					{
						cam = "close",
						a = 1,
						lines = { { speaker = "noob", text = "Cancel the shutdown. Some of us have tycoons running." } },
					},
					{
						cam = "over",
						a = 1,
						b = 2,
						lines = {
							{ speaker = "admin", text = "I have admin. You have a default avatar. Do the math." },
							{ speaker = "noob", text = "Never been good at math. Pretty good at this though." },
						},
					},
				},
			},
			{
				type = "fight",
				title = "THE NOOB  VS  THE ADMIN",
				stage = "emberthrone",
				player = "noob",
				playerEcho = "grandpa",
				opponent = "admin",
				opponentEcho = "nightguard",
				difficulty = 3,
				boss = true,
			},
			{
				type = "scene",
				stage = "emberthrone",
				actors = {
					{ id = "noob", x = -2.4, facing = 1, anim = "stance" },
					{ id = "admin", x = 2.4, facing = -1, anim = "kneel" },
					{ id = "bacon", x = -6.0, facing = 1, anim = "stance" },
				},
				shots = {
					{
						cam = "close",
						a = 2,
						lines = { { speaker = "admin", text = "No... my commands... why isn't ;kill WORKING?!" } },
						events = { { t = 0.5, type = "vfx", kind = "souls", actor = 2 } },
					},
					{
						cam = "two",
						a = 3,
						b = 1,
						lines = {
							{ speaker = "bacon", text = "His admin's expiring! It was a free trial! Noob, NOW!" },
							{ speaker = "noob", text = "Hey Admin. ;unadmin." },
						},
					},
					{
						cam = "sky",
						duration = 4.0,
						events = {
							{ t = 0.4, type = "vfx", kind = "flash" },
							{ t = 0.4, type = "sfx", key = "lightning_crack" },
							{ t = 0.4, type = "shake", amount = 1.0 },
							{ t = 0.6, type = "hide", actor = 2 },
						},
						caption = "SHUTDOWN CANCELLED.  SERVER SAVED.  FOR NOW.",
					},
					{
						cam = "wide",
						duration = 5.0,
						lines = {
							{ speaker = "system", text = "Guest 666 has joined the game." },
							{ speaker = "guest", text = "...see you in Chapter 2." },
						},
					},
				},
			},
		},
	},
}

Story.speakerNames = {
	noob = "THE NOOB",
	bacon = "BACON HAIR",
	studzilla = "STUDZILLA",
	guest = "GUEST 666",
	frosty = "FROSTY",
	emote = "EMOTE QUEEN",
	camper = "THE CAMPER",
	admin = "THE ADMIN",
	grandpa = "GRANDPA STUDS",
	dana = "DOG WALKER DANA",
	nightguard = "THE NIGHT GUARD",
	pigeon = "PIGEON LADY",
	system = "[SYSTEM]",
}

-- Seconds a subtitle stays on screen.
function Story.lineDuration(text: string): number
	return math.clamp(1.4 + #text * 0.055, 2.2, 7.5)
end

return Story
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="17">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="18">
      <Properties>
        <string name="Name">VeilServer</string>
      </Properties>
      <Item class="Script" referent="19">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
-- OOF FIGHTERS 1 server bootstrap.
-- The fights themselves run on each player's client (single-player vs CPU), so the
-- server only owns profile persistence: settings + lifetime stats in a DataStore.
-- All remote input is validated and rate-limited; DataStore failures degrade to
-- in-memory profiles without erroring.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

Players.CharacterAutoLoads = false

local STORE_NAME = "OofFightersProfile_v1"
local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	end
end

local remotes = Instance.new("Folder")
remotes.Name = "VeilRemotes"
remotes.Parent = ReplicatedStorage

local getProfile = Instance.new("RemoteFunction")
getProfile.Name = "GetProfile"
getProfile.Parent = remotes

local saveProfile = Instance.new("RemoteEvent")
saveProfile.Name = "SaveProfile"
saveProfile.Parent = remotes

local DEFAULT = {
	version = 1,
	settings = {
		music = 0.6,
		sfx = 0.8,
		voice = 0.85,
		subtitles = true,
		shake = true,
		difficulty = 2,
		touch = "auto",
	},
	stats = {
		wins = 0,
		losses = 0,
		ascents = 0,
		finishers = 0,
		storyDone = false,
	},
}

local profiles: { [Player]: any } = {}
local dirty: { [Player]: boolean } = {}
local lastSave: { [Player]: number } = {}
local loaded: { [Player]: boolean } = {}

local function deepCopy(t)
	local out = {}
	for k, v in t do
		out[k] = type(v) == "table" and deepCopy(v) or v
	end
	return out
end

-- Merge stored data over defaults, keeping only known keys with the right types.
local function sanitize(data)
	local p = deepCopy(DEFAULT)
	if type(data) ~= "table" then
		return p
	end
	for _, section in { "settings", "stats" } do
		local src = data[section]
		if type(src) == "table" then
			for k, def in DEFAULT[section] do
				local v = src[k]
				if type(v) == type(def) then
					if type(v) == "number" then
						if v ~= v or v == math.huge or v == -math.huge then
							continue
						end
						if section == "settings" then
							if k == "difficulty" then
								v = math.clamp(math.floor(v), 1, 4)
							else
								v = math.clamp(v, 0, 1)
							end
						else
							v = math.clamp(math.floor(v), 0, 1e7)
						end
					elseif type(v) == "string" then
						if k == "touch" and v ~= "auto" and v ~= "on" and v ~= "off" then
							continue
						end
					end
					p[section][k] = v
				end
			end
		end
	end
	return p
end

local function load(player: Player)
	local data = nil
	if store then
		-- Studio without API access fails fast: try once, never stall the session.
		local attempts = RunService:IsStudio() and 1 or 3
		for attempt = 1, attempts do
			local ok, result = pcall(function()
				return store:GetAsync("p_" .. player.UserId)
			end)
			if ok then
				data = result
				break
			end
			if attempt < attempts then
				task.wait(attempt)
			end
		end
	end
	profiles[player] = sanitize(data)
	loaded[player] = true
end

local function save(player: Player)
	local p = profiles[player]
	if not p or not store or not dirty[player] then
		return
	end
	dirty[player] = false
	local snapshot = deepCopy(p)
	local attempts = RunService:IsStudio() and 1 or 3
	for attempt = 1, attempts do
		local ok = pcall(function()
			store:UpdateAsync("p_" .. player.UserId, function()
				return snapshot
			end)
		end)
		if ok then
			return
		end
		if attempt < attempts then
			task.wait(attempt)
		end
	end
	dirty[player] = true
end

Players.PlayerAdded:Connect(function(player)
	load(player)
end)
for _, player in Players:GetPlayers() do
	task.spawn(load, player)
end

Players.PlayerRemoving:Connect(function(player)
	save(player)
	profiles[player] = nil
	dirty[player] = nil
	lastSave[player] = nil
	loaded[player] = nil
end)

game:BindToClose(function()
	for _, player in Players:GetPlayers() do
		task.spawn(save, player)
	end
	task.wait(2)
end)

getProfile.OnServerInvoke = function(player: Player)
	local waited = 0
	while not loaded[player] and waited < 10 do
		task.wait(0.2)
		waited += 0.2
	end
	return deepCopy(profiles[player] or DEFAULT)
end

-- Client reports settings + stat deltas. Stats are only allowed to grow by small
-- amounts per request so a tampered client can't inflate them arbitrarily.
saveProfile.OnServerEvent:Connect(function(player: Player, payload)
	if type(payload) ~= "table" then
		return
	end
	local now = os.clock()
	if lastSave[player] and now - lastSave[player] < 1 then
		return
	end
	lastSave[player] = now
	local p = profiles[player]
	if not p then
		return
	end
	if type(payload.settings) == "table" then
		local merged = sanitize({ settings = payload.settings, stats = p.stats })
		p.settings = merged.settings
	end
	if type(payload.delta) == "table" then
		local d = payload.delta
		local function bump(key: string, maxStep: number)
			local v = d[key]
			if type(v) == "number" and v == v and v >= 0 and v <= maxStep then
				p.stats[key] += math.floor(v)
			end
		end
		bump("wins", 1)
		bump("losses", 1)
		bump("ascents", 1)
		bump("finishers", 1)
		if d.storyDone == true then
			p.stats.storyDone = true
		end
	end
	dirty[player] = true
end)

-- periodic autosave
task.spawn(function()
	while true do
		task.wait(90)
		for _, player in Players:GetPlayers() do
			task.spawn(save, player)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="20">
