            <string name="Name">Core</string>
          </Properties>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Music, ambience, SFX and voice playback with volume groups and crossfades.
-- Sound ids come from Assets.Sounds (uploaded pack) with built-in fallbacks.
-- Missing ids are skipped silently so the game never errors on absent audio.

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Veil = game:GetService("ReplicatedStorage"):WaitForChild("Veil")
local Assets = require(Veil.Assets)

local Audio = {}

local groups = {}
local function group(name: string, volume: number): SoundGroup
	if groups[name] then
		return groups[name]
	end
	local g = Instance.new("SoundGroup")
	g.Name = "Veil" .. name
	g.Volume = volume
	g.Parent = SoundService
	groups[name] = g
	return g
end

local music = group("Music", 0.55)
local sfx = group("SFX", 0.8)
local ambience = group("Ambience", 0.45)
local voice = group("Voice", 0.85)
local ui = group("UI", 0.7)

local currentMusic: Sound? = nil
local currentMusicKey: string? = nil
local currentAmb: Sound? = nil
local currentAmbKey: string? = nil

local pools = {}

local function makeSound(id: string, g: SoundGroup, looped: boolean?, region): Sound
	local s = Instance.new("Sound")
	s.SoundId = id
	s.SoundGroup = g
	s.Looped = looped == true
	if region then
		-- play a slice of an audio atlas
		s.PlaybackRegionsEnabled = true
		local range = NumberRange.new(region.start, region.start + region.length)
		s.PlaybackRegion = range
		if looped then
			s.LoopRegion = range
		end
	end
	s.Parent = g
	return s
end

function Audio.setVolumes(settings)
	music.Volume = settings.music or music.Volume
	sfx.Volume = settings.sfx or sfx.Volume
	ambience.Volume = (settings.sfx or 0.8) * 0.55
	voice.Volume = settings.voice or voice.Volume
	ui.Volume = (settings.sfx or 0.8) * 0.85
end

-- One-shot sound effect. opts: { volume, pitch, pitchVar, group }
function Audio.play(key: string, opts)
	local id, region = Assets.sound(key)
	if id == "" then
		return nil
	end
	opts = opts or {}
	local g = opts.group == "ui" and ui or (opts.group == "voice" and voice or sfx)
	local pool = pools[key]
	if not pool then
		pool = { list = {}, idx = 0 }
		pools[key] = pool
	end
	pool.idx = pool.idx % 4 + 1
	local s = pool.list[pool.idx]
	if not s then
		s = makeSound(id, g, false, region)
		pool.list[pool.idx] = s
	end
	s.Volume = opts.volume or 0.8
	local pitch = opts.pitch or 1
	if opts.pitchVar then
		pitch += (math.random() - 0.5) * 2 * opts.pitchVar
	end
	s.PlaybackSpeed = pitch
	s.TimePosition = region and region.start or 0
	s:Play()
	return s
end

function Audio.ui(key: string)
	return Audio.play(key, { group = "ui", volume = 0.6 })
end

local VOICE_PREFIX = { male = "voice_m_", female = "voice_f_", deep = "voice_d_", hollow = "voice_h_" }
function Audio.voice(kind: string, what: string)
	local key = (VOICE_PREFIX[kind] or "voice_m_") .. what
	return Audio.play(key, { group = "voice", volume = 0.7, pitchVar = 0.06 })
end

local function fadeOut(s: Sound?, time: number)
	if not s then
		return
	end
	local tw = TweenService:Create(s, TweenInfo.new(time), { Volume = 0 })
	tw:Play()
	task.delay(time + 0.05, function()
		s:Stop()
		s:Destroy()
	end)
end

function Audio.music(key: string?, fade: number?)
	if key == currentMusicKey then
		return
	end
	fadeOut(currentMusic, fade or 1.2)
	currentMusic = nil
	currentMusicKey = key
	if not key then
		return
	end
	local id, region = Assets.sound(key)
	if id == "" then
		return
	end
	local s = makeSound(id, music, key ~= "music_victory", region)
	s.Volume = 0
	s:Play()
	TweenService:Create(s, TweenInfo.new(fade or 1.2), { Volume = 0.7 }):Play()
	currentMusic = s
end

function Audio.ambience(key: string?)
	if key == currentAmbKey then
		return
	end
	fadeOut(currentAmb, 1.5)
	currentAmb = nil
	currentAmbKey = key
	if not key or key == "" then
		return
	end
	local id, region = Assets.sound(key)
	if id == "" then
		return
	end
	local s = makeSound(id, ambience, true, region)
	s.Volume = 0
	s:Play()
	TweenService:Create(s, TweenInfo.new(2), { Volume = 0.6 }):Play()
	currentAmb = s
end

-- Duck music briefly (supers, finishers, KO)
function Audio.duck(amount: number, time: number)
	if not currentMusic then
		return
	end
	local s = currentMusic
	TweenService:Create(s, TweenInfo.new(0.15), { Volume = 0.7 * amount }):Play()
	task.delay(time, function()
		if s.Parent then
			TweenService:Create(s, TweenInfo.new(0.6), { Volume = 0.7 }):Play()
		end
	end)
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="27">
            <Properties>
              <string name="Name">Input</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Unified input: keyboard, gamepad and touch feed one fight-input table and one stream
-- of menu navigation events. Remembers the last device used for button prompts.

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Input = {}

Input.mode = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and "touch" or "keyboard"
Input.modeChanged = Instance.new("BindableEvent")
Input.nav = Instance.new("BindableEvent") -- (action: string)
Input.anyPressed = Instance.new("BindableEvent")

local KEY_FIGHT = {
	[Enum.KeyCode.A] = "left",
	[Enum.KeyCode.Left] = "left",
	[Enum.KeyCode.D] = "right",
	[Enum.KeyCode.Right] = "right",
	[Enum.KeyCode.W] = "up",
	[Enum.KeyCode.Up] = "up",
	[Enum.KeyCode.Space] = "up",
	[Enum.KeyCode.S] = "down",
	[Enum.KeyCode.Down] = "down",
	[Enum.KeyCode.J] = "L",
	[Enum.KeyCode.K] = "H",
	[Enum.KeyCode.L] = "K",
	[Enum.KeyCode.I] = "S",
	[Enum.KeyCode.U] = "B",
	[Enum.KeyCode.LeftShift] = "B",
	[Enum.KeyCode.O] = "E",
	[Enum.KeyCode.P] = "X",
	[Enum.KeyCode.Semicolon] = "X",
	[Enum.KeyCode.H] = "THROW",
}

local PAD_FIGHT = {
	[Enum.KeyCode.DPadLeft] = "left",
	[Enum.KeyCode.DPadRight] = "right",
	[Enum.KeyCode.DPadUp] = "up",
	[Enum.KeyCode.DPadDown] = "down",
	[Enum.KeyCode.ButtonX] = "L",
	[Enum.KeyCode.ButtonY] = "H",
	[Enum.KeyCode.ButtonA] = "K",
	[Enum.KeyCode.ButtonB] = "S",
	[Enum.KeyCode.ButtonR1] = "B",
	[Enum.KeyCode.ButtonL1] = "E",
	[Enum.KeyCode.ButtonR2] = "X",
	[Enum.KeyCode.ButtonL2] = "THROW",
}

local KEY_NAV = {
	[Enum.KeyCode.Up] = "up",
	[Enum.KeyCode.W] = "up",
	[Enum.KeyCode.Down] = "down",
	[Enum.KeyCode.S] = "down",
	[Enum.KeyCode.Left] = "left",
	[Enum.KeyCode.A] = "left",
	[Enum.KeyCode.Right] = "right",
	[Enum.KeyCode.D] = "right",
	[Enum.KeyCode.Return] = "confirm",
	[Enum.KeyCode.KeypadEnter] = "confirm",
	[Enum.KeyCode.Space] = "confirm",
	[Enum.KeyCode.J] = "confirm",
	[Enum.KeyCode.Backspace] = "back",
	[Enum.KeyCode.K] = "back",
	[Enum.KeyCode.Q] = "tabL",
	[Enum.KeyCode.E] = "tabR",
	[Enum.KeyCode.Tab] = "start",
	[Enum.KeyCode.F] = "alt",
}

local PAD_NAV = {
	[Enum.KeyCode.DPadUp] = "up",
	[Enum.KeyCode.DPadDown] = "down",
	[Enum.KeyCode.DPadLeft] = "left",
	[Enum.KeyCode.DPadRight] = "right",
	[Enum.KeyCode.ButtonA] = "confirm",
	[Enum.KeyCode.ButtonB] = "back",
	[Enum.KeyCode.ButtonL1] = "tabL",
	[Enum.KeyCode.ButtonR1] = "tabR",
	[Enum.KeyCode.ButtonStart] = "start",
	[Enum.KeyCode.ButtonSelect] = "start",
	[Enum.KeyCode.ButtonY] = "alt",
}

local held = {}
local touchHeld = {}
local stick = Vector2.zero
local padStick = Vector2.zero
Input.fightEnabled = false

local function setMode(m: string)
	if Input.mode ~= m then
		Input.mode = m
		Input.modeChanged:Fire(m)
	end
end

-- menu key repeat
local repeatState = { action = nil, t = 0, next = 0 }
local function navFire(action: string)
	Input.nav:Fire(action)
	if action == "up" or action == "down" or action == "left" or action == "right" then
		repeatState.action = action
		repeatState.t = 0
		repeatState.next = 0.38
	end
end

UserInputService.InputBegan:Connect(function(io, processed)
	if io.UserInputType == Enum.UserInputType.Keyboard then
		if processed and io.KeyCode ~= Enum.KeyCode.Return then
			return
		end
		setMode("keyboard")
		local f = KEY_FIGHT[io.KeyCode]
		if f then
			held[f] = true
		end
		local n = KEY_NAV[io.KeyCode]
		if n then
			navFire(n)
		end
		Input.anyPressed:Fire()
	elseif io.UserInputType.Name:find("Gamepad") then
		setMode("gamepad")
		local f = PAD_FIGHT[io.KeyCode]
		if f then
			held[f] = true
		end
		local n = PAD_NAV[io.KeyCode]
		if n then
			navFire(n)
		end
		Input.anyPressed:Fire()
	elseif io.UserInputType == Enum.UserInputType.Touch then
		setMode("touch")
		if not processed then
			Input.anyPressed:Fire()
		end
	elseif io.UserInputType == Enum.UserInputType.MouseButton1 then
		if not processed then
			Input.anyPressed:Fire()
		end
	end
end)

UserInputService.InputEnded:Connect(function(io)
	if io.UserInputType == Enum.UserInputType.Keyboard then
		local f = KEY_FIGHT[io.KeyCode]
		if f then
			held[f] = false
		end
		local n = KEY_NAV[io.KeyCode]
		if n and repeatState.action == n then
			repeatState.action = nil
		end
	elseif io.UserInputType.Name:find("Gamepad") then
		local f = PAD_FIGHT[io.KeyCode]
		if f then
			held[f] = false
		end
		local n = PAD_NAV[io.KeyCode]
		if n and repeatState.action == n then
			repeatState.action = nil
		end
	end
end)

-- analog stick
local lastStickDir = nil
UserInputService.InputChanged:Connect(function(io)
	if io.KeyCode == Enum.KeyCode.Thumbstick1 then
		local p = io.Position
		padStick = Vector2.new(p.X, p.Y)
		if padStick.Magnitude > 0.5 then
			setMode("gamepad")
		end
		local dir = nil
		if math.abs(padStick.X) > math.abs(padStick.Y) then
			if padStick.X > 0.6 then
				dir = "right"
			elseif padStick.X < -0.6 then
				dir = "left"
			end
		else
			if padStick.Y > 0.6 then
				dir = "up"
			elseif padStick.Y < -0.6 then
				dir = "down"
			end
		end
		if dir ~= lastStickDir then
			if dir then
				navFire(dir)
			elseif repeatState.action == lastStickDir then
				repeatState.action = nil
			end
			lastStickDir = dir
		end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	if repeatState.action then
		repeatState.t += dt
		if repeatState.t >= repeatState.next then
			repeatState.next = repeatState.t + 0.09
			Input.nav:Fire(repeatState.action)
		end
	end
end)

-- Touch API (used by MobileControls)
function Input.setTouch(button: string, down: boolean)
	touchHeld[button] = down
	if down then
		setMode("touch")
	end
end

function Input.setStick(v: Vector2)
	stick = v
end

function Input.clearTouch()
	table.clear(touchHeld)
	stick = Vector2.zero
end

-- Current fight input (held state)
function Input.fightState()
	local s = {
		left = false,
		right = false,
		up = false,
		down = false,
		L = false,
		H = false,
		K = false,
		S = false,
		B = false,
		E = false,
		X = false,
	}
	for k in s do
		if held[k] or touchHeld[k] then
			s[k] = true
		end
	end
	-- analog sticks
	local function applyStick(v: Vector2, invertY: boolean)
		local y = invertY and -v.Y or v.Y
		if v.X < -0.45 then
			s.left = true
		elseif v.X > 0.45 then
			s.right = true
		end
		if y < -0.55 then
			s.up = true
		elseif y > 0.55 then
			s.down = true
		end
	end
	if padStick.Magnitude > 0.3 then
		applyStick(padStick, true)
	end
	if stick.Magnitude > 0.3 then
		applyStick(stick, false)
	end
	-- throw macro = block + light
	if held.THROW or touchHeld.THROW then
		s.B = true
		s.L = true
	end
	return s
end

-- Button glyphs for prompts
local GLYPHS = {
	keyboard = { L = "J", H = "K", K = "L", S = "I", B = "U", E = "O", X = "P", THROW = "H", down = "S", up = "W", left = "A", right = "D", confirm = "ENTER", back = "BKSP", start = "TAB", tabL = "Q", tabR = "E", alt = "F" },
	gamepad = { L = "X", H = "Y", K = "A", S = "B", B = "RB", E = "LB", X = "RT", THROW = "LT", down = "\u{2193}", up = "\u{2191}", left = "\u{2190}", right = "\u{2192}", confirm = "A", back = "B", start = "START", tabL = "LB", tabR = "RB", alt = "Y" },
	touch = { L = "LIGHT", H = "HEAVY", K = "KICK", S = "SPECIAL", B = "BLOCK", E = "FRIEND", X = "SUPER", THROW = "THROW", down = "\u{2193}", up = "\u{2191}", left = "\u{2190}", right = "\u{2192}", confirm = "TAP", back = "BACK", start = "II", tabL = "\u{25C0}", tabR = "\u{25B6}", alt = "" },
}
function Input.glyph(action: string): string
	local set = GLYPHS[Input.mode] or GLYPHS.keyboard
	return set[action] or action
end

return Input
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="28">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!nonstrict
-- OOF FIGHTERS 1 client entry point: builds the UI root and runs the game flow
-- (title -> main menu -> Story / Ascent / Versus / Practice / Move List / Settings).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local Veil = ReplicatedStorage:WaitForChild("Veil")
local Fighters = require(Veil.Data.Fighters)
local Echoes = require(Veil.Data.Echoes)
local Story = require(Veil.Data.Story)
local Config = require(Veil.Config)

local Client = script.Parent
local Theme = require(Client.UI.Theme)
local Screens = require(Client.UI.Screens)
local Subtitles = require(Client.UI.Subtitles)
local Audio = require(Client.Core.Audio)
local Input = require(Client.Core.Input)
local FightView = require(Client.Render.FightView)
local Cutscene = require(Client.Render.Cutscene)
local StageBuilder = require(Client.Render.StageBuilder)
local FightCamera = require(Client.Render.FightCamera)

-------------------------------------------------------------------------------
-- Boot
-------------------------------------------------------------------------------

if not game:IsLoaded() then
	game.Loaded:Wait()
end

-- hide default Roblox HUD elements we don't use (keep the system menu & chat)
for _, t in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.EmotesMenu } do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(t, false)
	end)
end

local gui = Instance.new("ScreenGui")
gui.Name = "VeilUI"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 10
gui.Parent = player:WaitForChild("PlayerGui")
local root = Theme.root(gui)
Subtitles.mount(root)

-- a quiet backdrop behind menus
local camera = workspace.CurrentCamera
camera.CameraType = Enum.CameraType.Scriptable
camera.CFrame = CFrame.new(0, 6, 22) * CFrame.Angles(math.rad(-6), 0, 0)
Lighting.ClockTime = 0.5

-------------------------------------------------------------------------------
-- Profile & settings
-------------------------------------------------------------------------------

local profile = {
	settings = { music = 0.6, sfx = 0.8, voice = 0.85, subtitles = true, shake = true, difficulty = 2, touch = "auto" },
	stats = { wins = 0, losses = 0, ascents = 0, finishers = 0, storyDone = false },
}
local remotes = ReplicatedStorage:WaitForChild("VeilRemotes", 10)

task.spawn(function()
	if not remotes then
		return
	end
	local fn = remotes:FindFirstChild("GetProfile")
	if not fn then
		return
	end
	local ok, data = pcall(function()
		return fn:InvokeServer()
	end)
	if ok and type(data) == "table" then
		if type(data.settings) == "table" then
			for k, v in data.settings do
				profile.settings[k] = v
			end
		end
		if type(data.stats) == "table" then
			for k, v in data.stats do
				profile.stats[k] = v
			end
		end
		Audio.setVolumes(profile.settings)
		Subtitles.enabled = profile.settings.subtitles ~= false
	end
end)

local function applySettings()
	Audio.setVolumes(profile.settings)
	Subtitles.enabled = profile.settings.subtitles ~= false
	FightCamera.setShakeScale(profile.settings.shake == false and 0 or 1)
end
applySettings()

local function saveProfile(delta)
	if delta then
		for k, v in delta do
			if type(v) == "number" then
				profile.stats[k] = (profile.stats[k] or 0) + v
			elseif v == true then
				profile.stats[k] = true
			end
		end
	end
	if not remotes then
		return
	end
	local ev = remotes:FindFirstChild("SaveProfile")
	if ev then
		ev:FireServer({ settings = profile.settings, delta = delta })
	end
end

local function profileSummary()
	return {
		wins = profile.stats.wins,
		ascents = profile.stats.ascents,
		storyDone = profile.stats.storyDone,
	}
end

-------------------------------------------------------------------------------
-- Fight runner (handles pause / restart / quit)
-------------------------------------------------------------------------------

-- Returns outcome { kind = "end" | "restart" | "quit", result? }, plus a black cover frame.
local function runFight(opts, cover)
	cover = cover or Screens.fadeToBlack(root, 0.3)
	local finished = Instance.new("BindableEvent")
	local outcome = nil
	local view = nil
	local pausing = false

	local function finish(o)
		if outcome then
			return
		end
		outcome = o
		finished:Fire()
	end

	local fightOpts = table.clone(opts)
	fightOpts.root = root
	fightOpts.settings = profile.settings
	fightOpts.forceTouch = profile.settings.touch == "on"
	fightOpts.noTouch = profile.settings.touch == "off"
	fightOpts.onEnd = function(result)
		finish({ kind = "end", result = result })
	end
	fightOpts.onPause = function()
		if pausing or outcome then
			return
		end
		pausing = true
		task.spawn(function()
			view:setPaused(true)
			Audio.ui("ui_back")
			local r = Screens.pause(root, { noRestart = opts.noRestart })
			while r == "movelist" or r == "settings" do
				if r == "movelist" then
					Screens.moveList(root, opts.p1.fighter)
				else
					Screens.settings(root, profile.settings)
					applySettings()
					saveProfile(nil)
				end
				r = Screens.pause(root, { noRestart = opts.noRestart })
			end
			pausing = false
			if r == "resume" then
				view:setPaused(false)
			elseif r == "restart" then
				finish({ kind = "restart" })
			elseif r == "quit" then
				finish({ kind = "quit" })
			end
		end)
	end

	view = FightView.new(fightOpts)
	Screens.fadeFromBlack(cover, 0.7)
	if not outcome then
		finished.Event:Wait()
	end
	finished:Destroy()
	local out = Screens.fadeToBlack(root, 0.45)
	view:destroy()
	StageBuilder.clear()
	return outcome, out
end

local function recordResult(result)
	if not result then
		return
	end
	local delta = {}
	if result.winner == 1 then
		delta.wins = 1
		if result.finisher then
			delta.finishers = 1
		end
	else
		delta.losses = 1
	end
	saveProfile(delta)
end

-------------------------------------------------------------------------------
-- Modes
-------------------------------------------------------------------------------

local function randomEcho()
	return Echoes.list[math.random(1, #Echoes.list)].id
end

local function runVersus()
	while true do
		local sel = Screens.characterSelect(root, { pickOpponent = true })
		if not sel then
			return
		end
		local stageId, diff = Screens.stageSelect(root, profile.settings.difficulty)
		if stageId then
			local p1 = { fighter = sel.fighter, echo = sel.echo }
			local p2 = { fighter = sel.opp, echo = sel.oppEcho, cpu = true, difficulty = diff }
			while true do
				local cover = Screens.versus(root, p1, p2, stageId)
				local outcome, out = runFight({ p1 = p1, p2 = p2, stage = stageId }, cover)
				if outcome.kind == "restart" then
					Screens.fadeFromBlack(out, 0.1)
				elseif outcome.kind == "quit" then
					Screens.fadeFromBlack(out, 0.4)
					return
				else
					recordResult(outcome.result)
					Screens.fadeFromBlack(out, 0.4)
					local r = Screens.results(root, outcome.result)
					if r == "menu" then
						return
					elseif r == "select" then
						break
					end
					-- rematch: new random echo for the CPU keeps it fresh
					p2.echo = randomEcho()
				end
			end
		end
	end
end

local function runPractice()
	local sel = Screens.characterSelect(root, { pickOpponent = true, title = "PRACTICE: CHOOSE YOUR FIGHTER" })
	if not sel then
		return
	end
	while true do
		local p1 = { fighter = sel.fighter, echo = sel.echo }
		local p2 = { fighter = sel.opp, echo = sel.oppEcho, cpu = false }
		local cover = Screens.fadeToBlack(root, 0.3)
		local outcome, out = runFight({ p1 = p1, p2 = p2, stage = "proving", training = true, dummy = "stand" }, cover)
		Screens.fadeFromBlack(out, 0.3)
		if outcome.kind ~= "restart" then
			return
		end
	end
end

local function buildLadder(playerId: string)
	local pool = {}
	for _, f in Fighters.list do
		if f.id ~= playerId and f.id ~= "admin" then
			table.insert(pool, f.id)
		end
	end
	-- shuffle
	for i = #pool, 2, -1 do
		local j = math.random(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local ladder = {}
	for i = 1, math.min(6, #pool) do
		table.insert(ladder, { fighter = pool[i], echo = randomEcho() })
	end
	if playerId ~= "admin" then
		table.insert(ladder, { fighter = "admin", echo = "nightguard", boss = true })
	else
		table.insert(ladder, { fighter = "noob", echo = "grandpa", boss = true })
	end
	return ladder
end

local function runAscent()
	local sel = Screens.characterSelect(root, { title = "THE TOWER: CHOOSE YOUR FIGHTER", subtitle = "SEVEN TRYHARDS STAND BETWEEN YOU AND THE ADMIN" })
	if not sel then
		return
	end
	local ladder = buildLadder(sel.fighter)
	local base = profile.settings.difficulty or 2
	local i = 1
	while i <= #ladder do
		if Screens.ladder(root, ladder, i, sel.fighter) == "quit" then
			return
		end
		local opp = ladder[i]
		local diff = math.clamp(base + (i <= 2 and -1 or (i >= 6 and 1 or 0)), 1, #Config.Difficulty)
		local stageId
		if opp.boss then
			stageId = "emberthrone"
		else
			local options = { "hollowroot", "skyreach", "cathedral", "baseplate" }
			stageId = options[(i % #options) + 1]
		end
		local p1 = { fighter = sel.fighter, echo = sel.echo }
		local p2 = { fighter = opp.fighter, echo = opp.echo, cpu = true, difficulty = diff }
		local cover = Screens.versus(root, p1, p2, stageId, string.format("THE TOWER  \u{00B7}  TRYHARD %d OF %d", i, #ladder))
		local outcome, out = runFight({ p1 = p1, p2 = p2, stage = stageId, boss = opp.boss }, cover)
		Screens.fadeFromBlack(out, 0.4)
		if outcome.kind == "quit" then
			return
		elseif outcome.kind == "end" then
			recordResult(outcome.result)
			if outcome.result.winner == 1 then
				i += 1
			else
				local r = Screens.results(root, outcome.result, { entries = { { "retry", "TRY AGAIN" }, { "menu", "ABANDON ASCENT" } } })
				if r == "menu" then
					return
				end
			end
		end
	end
	saveProfile({ ascents = 1 })
	Screens.ending(root, sel.fighter)
end

local function runStory()
	local chapter = Story.chapters[1]
	if Screens.card(root, chapter.number, chapter.name, chapter.synopsis, { confirmText = "BEGIN", darkness = 0.55 }) == "back" then
		return
	end
	for _, beat in chapter.beats do
		if beat.type == "scene" then
			Cutscene.play(beat, root)
			StageBuilder.clear()
		else
			while true do
				local p1 = { fighter = beat.player, echo = beat.playerEcho }
				local p2 = { fighter = beat.opponent, echo = beat.opponentEcho, cpu = true, difficulty = beat.difficulty or 2 }
				local cover = Screens.versus(root, p1, p2, beat.stage, beat.title)
				local outcome, out = runFight({ p1 = p1, p2 = p2, stage = beat.stage, boss = beat.boss }, cover)
				Screens.fadeFromBlack(out, 0.4)
				if outcome.kind == "quit" then
					return
				elseif outcome.kind == "end" then
					recordResult(outcome.result)
					if outcome.result.winner == 1 then
						break
					end
					local r = Screens.results(root, outcome.result, { entries = { { "retry", "RETRY FIGHT" }, { "menu", "QUIT STORY" } } })
					if r == "menu" then
						return
					end
				end
			end
		end
	end
	saveProfile({ storyDone = true })
	Screens.card(root, "CHAPTER I COMPLETE", "TO BE CONTINUED", "The server is safe. For now. But deep in the Deleted Accounts folder, a guest is typing... and it just found out what ;admin does.", { darkness = 0.7 })
end

-------------------------------------------------------------------------------
-- Main loop
-------------------------------------------------------------------------------

Screens.title(root)
while true do
	local ok, err = pcall(function()
		local choice = Screens.mainMenu(root, profileSummary())
		if choice == "versus" then
			runVersus()
		elseif choice == "story" then
			runStory()
		elseif choice == "ascent" then
			runAscent()
		elseif choice == "practice" then
			runPractice()
		elseif choice == "movelist" then
			Screens.moveList(root)
		elseif choice == "settings" then
			Screens.settings(root, profile.settings)
			applySettings()
			saveProfile(nil)
		end
	end)
	if not ok then
		-- never leave the player stuck: log, clean up the world and return to the menu
		warn("[OofFighters] recovered from error: " .. tostring(err))
		StageBuilder.clear()
		FightCamera.disable()
		for _, ch in root:GetChildren() do
			if ch:IsA("GuiObject") and ch.Name ~= "Subtitles" then
				ch:Destroy()
			end
		end
		for _, name in { "VeilFight", "VeilCutscene", "VeilVFX" } do
			local inst = workspace:FindFirstChild(name)
			if inst then
				inst:Destroy()
			end
		end
		task.wait(0.5)
	end
	Input.fightEnabled = false
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">Render</string>
          </Properties>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Cutscene</string>
              <string name="Source"><![CDATA[--!nonstrict
-- In-engine story cinematics: letterboxed camera shots over the real stages with
-- posed actors, subtitles, location captions and scripted effects.

local RunService = game:GetService("RunService")

local Veil = game:GetService("ReplicatedStorage"):WaitForChild("Veil")
local Fighters = require(Veil.Data.Fighters)
local Stages = require(Veil.Data.Stages)
local Story = require(Veil.Data.Story)

local Client = script.Parent.Parent
local Rig = require(script.Parent.Rig)
local Poses = require(script.Parent.Poses)
local StageBuilder = require(script.Parent.StageBuilder)
local FightCamera = require(script.Parent.FightCamera)
local VFX = require(script.Parent.VFX)
local Audio = require(Client.Core.Audio)
local Input = require(Client.Core.Input)
local Theme = require(Client.UI.Theme)
local Subtitles = require(Client.UI.Subtitles)

local C = Theme.Colors
local F = Theme.Fonts

local Cutscene = {}

local YAW = math.rad(25)

local function rootCF(x: number, facing: number)
	local pos = Vector3.new(x, 0, 0)
	return CFrame.lookAt(pos, pos + Vector3.new(facing * math.cos(YAW), 0, math.sin(YAW)))
end

local function poseFor(anim: string?, style: string, t: number)
	if anim == "dazed" then
		local p = table.clone(Poses.States.dazed())
		local r = p.root
		p.root = { r[1], r[2], r[3], math.sin(t * 1.7) * 5, math.sin(t * 1.1) * 6, math.sin(t * 2.3) * 5 }
		return p
	elseif anim == "kneel" then
		return Poses.States.kneel()
	elseif anim == "win" then
		return Poses.WIN[style] or Poses.WIN.unarmed
	end
	return Poses.idle(style, t)
end

-- Camera presets -> function(t) returning CFrame, fov
local function shotCamera(shot, actors)
	local function head(i)
		local a = actors[i]
		if not a then
			return Vector3.new(0, 4, 0)
		end
		return Vector3.new(a.x, 4.4 * a.rig.scale, 0)
	end
	local function visibleMid()
		local sum, n = Vector3.zero, 0
		for _, a in actors do
			if not a.hidden then
				sum += Vector3.new(a.x, 3.2, 0)
				n += 1
			end
		end
		return n > 0 and sum / n or Vector3.new(0, 3.2, 0)
	end
	local cam = shot.cam
	if cam == "sky" then
		return function(t)
			local pos = Vector3.new(-8 + t * 1.6, 7 + t * 0.4, 30)
			local look = Vector3.new(-2 + t * 1.2, 18, -60)
			return CFrame.lookAt(pos, look), 50
		end
	elseif cam == "wide" then
		return function(t)
			local mid = visibleMid()
			local pos = mid + Vector3.new(-3 + t * 0.6, 2.2, 21 - t * 0.5)
			return CFrame.lookAt(pos, mid), 40
		end
	elseif cam == "two" then
		return function(t)
			local a, b = head(shot.a or 1), head(shot.b or 2)
			local mid = (a + b) / 2 - Vector3.new(0, 0.6, 0)
			local sep = (a - b).Magnitude
			local pos = mid + Vector3.new(t * 0.3, 0.6, 7 + sep * 0.9 - t * 0.2)
			return CFrame.lookAt(pos, mid), 38
		end
	elseif cam == "close" then
		return function(t)
			local a = actors[shot.a or 1]
			local h = head(shot.a or 1) - Vector3.new(0, 0.2, 0)
			local facing = a and a.facing or 1
			local pos = h + Vector3.new(facing * 3.2, 0.2, 5.4 - t * 0.18)
			return CFrame.lookAt(pos, h), 30
		end
	elseif cam == "over" then
		return function(t)
			local a, b = head(shot.a or 1), head(shot.b or 2)
			local dir = (b - a).Unit
			local pos = a - dir * 3.2 + Vector3.new(0, 0.8, 2.8 + t * 0.1)
			return CFrame.lookAt(pos, b - Vector3.new(0, 0.4, 0)), 36
		end
	elseif cam == "low" then
		return function(t)
			local a = actors[shot.a or 1]
			local h = head(shot.a or 1)
			local facing = a and a.facing or 1
			local pos = Vector3.new(h.X + facing * 4.5, 0.8 + t * 0.1, 6.5)
			return CFrame.lookAt(pos, h + Vector3.new(0, 0.6, 0)), 42
		end
	end
	return function(_t)
		local mid = visibleMid()
		return CFrame.lookAt(mid + Vector3.new(0, 3, 18), mid), 40
	end
end

-- Plays a scene beat. Yields until finished (or skipped). Returns "done" | "skipped".
function Cutscene.play(scene, uiRoot: Instance)
	local stageDef = Stages.get(scene.stage)
	local stage = StageBuilder.build(scene.stage)
	Audio.music("music_story")
	Audio.ambience(stageDef.ambience)
	local folder = Instance.new("Folder")
	folder.Name = "VeilCutscene"
	folder.Parent = workspace

	local actors = {}
	for i, a in scene.actors or {} do
		local def = Fighters.get(a.id)
		local rig = Rig.build(def.look, { name = def.name, world = workspace })
		rig.model.Parent = a.hidden and nil or folder
		actors[i] = {
			id = a.id,
			def = def,
			rig = rig,
			x = a.x,
			facing = a.facing,
			anim = a.anim or "stance",
			hidden = a.hidden == true,
			style = Poses.STYLE_OF[def.stance] or "unarmed",
		}
	end

	-- letterbox + caption + skip hint
	local ui = Theme.frame(uiRoot, { Name = "Cutscene", Size = UDim2.fromScale(1, 1), ZIndex = 35 })
	local barT = Theme.frame(ui, { Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 36 })
	local barB = Theme.frame(ui, {
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.fromScale(0, 1),
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0,
		ZIndex = 36,
	})
	Theme.tween(barT, 0.6, { Size = UDim2.new(1, 0, 0, 96) })
	Theme.tween(barB, 0.6, { Size = UDim2.new(1, 0, 0, 96) })
	local caption = Theme.label(ui, "", {
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.new(0.5, 0, 1, -150),
		AnchorPoint = Vector2.new(0.5, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = F.display,
		TextSize = 40,
		TextColor3 = C.ivory,
		TextTransparency = 1,
		ZIndex = 37,
	})
	Theme.textStroke(caption, 2, 0.2)
	local skip = Theme.label(ui, "", {
		Size = UDim2.fromOffset(400, 30),
		Position = UDim2.new(1, -30, 1, -30),
		AnchorPoint = Vector2.new(1, 1),
		TextXAlignment = Enum.TextXAlignment.Right,
		FontFace = F.label,
		TextSize = 16,
		TextColor3 = C.textDim,
		ZIndex = 37,
	})
	skip.Text = "[" .. Input.glyph("confirm") .. "] NEXT    [" .. Input.glyph("back") .. "] SKIP SCENE"
	local fade = Theme.frame(ui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 45 })
	Theme.tween(fade, 0.8, { BackgroundTransparency = 1 })

	FightCamera.enable()
	local t0 = os.clock()
	local renderConn = RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - t0
		for _, a in actors do
			if not a.hidden then
				Rig.apply(a.rig, rootCF(a.x, a.facing), poseFor(a.anim, a.style, t + a.x), { time = t })
			end
		end
		FightCamera.update(dt, -2, 0, 2, 0)
		StageBuilder.update(t, 0)
	end)

	local skipShot, skipScene = false, false
	local navConn = Input.nav.Event:Connect(function(action)
		if action == "confirm" then
			skipShot = true
		elseif action == "back" or action == "start" then
			skipScene = true
		end
	end)
	local tapConn = nil
	if Input.mode == "touch" then
		tapConn = Input.anyPressed.Event:Connect(function()
			skipShot = true
		end)
	end

	local function wait(sec: number)
		local start = os.clock()
		while os.clock() - start < sec do
			if skipShot or skipScene then
				return false
			end
			RunService.Heartbeat:Wait()
		end
		return true
	end

	local function runEvent(ev)
		local a = ev.actor and actors[ev.actor]
		if ev.type == "show" and a then
			a.hidden = false
			a.rig.model.Parent = folder
		elseif ev.type == "hide" and a then
			a.hidden = true
			a.rig.model.Parent = nil
		elseif ev.type == "anim" and a then
			a.anim = ev.anim
		elseif ev.type == "sfx" then
			Audio.play(ev.key, { volume = 0.9 })
		elseif ev.type == "shake" then
			FightCamera.shake(ev.amount or 0.6)
		elseif ev.type == "vfx" then
			local pos = a and Vector3.new(a.x, 0, 0) or Vector3.new(0, 0, 0)
			if ev.kind == "rift" then
				for k = 0, 8 do
					local p = Instance.new("Part")
					p.Anchored = true
					p.CanCollide = false
					p.CanQuery = false
					p.CanTouch = false
					p.Material = Enum.Material.Neon
					p.Color = k % 3 == 0 and Color3.fromHex("#FF3B4E") or Color3.fromHex("#63FF8A")
					p.Size = Vector3.new(1.2, 8 - math.abs(k - 4), 0.5)
					p.CFrame = CFrame.new(-6 + k * 1.6, 30 + math.sin(k * 1.9) * 2.5, -50) * CFrame.Angles(0, 0, math.rad(k % 2 == 0 and 24 or -24))
					p.Parent = folder
				end
				VFX.burstShockwave(Vector3.new(0, 30, -48), Color3.fromHex("#63FF8A"))
			elseif ev.kind == "teleport" then
				VFX.teleport(pos, a and Color3.fromHex(a.def.accent) or Color3.new(1, 1, 1))
			elseif ev.kind == "roots" then
				VFX.groundEruption(pos, "nature", 4)
			elseif ev.kind == "bolt_impact" then
				VFX.hit(pos + Vector3.new(0.8, 3.5, 0.4), "heavy", "ash", 1, false)
			elseif ev.kind == "smoke" then
				VFX.teleport(pos, Color3.fromHex("#8A8478"))
			elseif ev.kind == "souls" then
				VFX.elementBurst(pos + Vector3.new(0, 3, 0), "soulfire", true)
				VFX.burstShockwave(pos + Vector3.new(0, 3, 0), Color3.fromHex("#63FF8A"))
			elseif ev.kind == "flash" then
				local fl = Theme.frame(ui, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0, ZIndex = 44 })
				Theme.tween(fl, 1.2, { BackgroundTransparency = 1 })
			end
		end
	end

	for _, shot in scene.shots or {} do
		if skipScene then
			break
		end
		skipShot = false
		FightCamera.cinematic(shotCamera(shot, actors))
		local lineTotal = 0
		for _, line in shot.lines or {} do
			lineTotal += Story.lineDuration(line.text)
		end
		local duration = shot.duration or (lineTotal + 0.6)
		-- schedule events
		local evs = table.clone(shot.events or {})
		table.sort(evs, function(x, y)
			return (x.t or 0) < (y.t or 0)
		end)
		local shotStart = os.clock()
		local evIdx = 1
		local evConn = RunService.Heartbeat:Connect(function()
			local el = os.clock() - shotStart
			while evs[evIdx] and (evs[evIdx].t or 0) <= el do
				runEvent(evs[evIdx])
				evIdx += 1
			end
		end)
		if shot.caption then
			caption.Text = shot.caption
			Theme.tween(caption, 0.6, { TextTransparency = 0 })
		end
		-- lines
		local lineStart = 0.25
		task.wait(0)
		if shot.lines and #shot.lines > 0 then
			wait(lineStart)
			for _, line in shot.lines do
				if skipShot or skipScene then
					break
				end
				local d = Story.lineDuration(line.text)
				local spk = Fighters.byId[line.speaker]
				local col = spk and Color3.fromHex(spk.accent) or C.goldBright
				Subtitles.show(Story.speakerNames[line.speaker] or line.speaker, line.text, d - 0.15, col)
				if spk then
					Audio.voice(spk.voice, "attack")
				end
				if not wait(d) then
					break
				end
			end
			if not skipShot and not skipScene then
				wait(math.max(0, duration - lineTotal - lineStart))
			end
		else
			wait(duration)
		end
		-- flush remaining events so visibility stays consistent when skipping
		while evs[evIdx] do
			runEvent(evs[evIdx])
			evIdx += 1
		end
		evConn:Disconnect()
		if shot.caption then
			Theme.tween(caption, 0.4, { TextTransparency = 1 })
		end
		Subtitles.hide()
	end

	-- outro
	Theme.tween(fade, 0.5, { BackgroundTransparency = 0 })
	task.wait(0.55)
	navConn:Disconnect()
	if tapConn then
		tapConn:Disconnect()
	end
	renderConn:Disconnect()
	FightCamera.clearCinematic()
	for _, a in actors do
		Rig.destroy(a.rig)
	end
	folder:Destroy()
	ui:Destroy()
	VFX.clear()
	local _ = stage
	return skipScene and "skipped" or "done"
end

return Cutscene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">FightCamera</string>
              <string name="Source"><![CDATA[--!nonstrict
-- 2.5D fight camera with smoothing, zoom-by-distance, jump tracking, shake and
-- cinematic overrides (intros, supers, finishers, cutscenes).

local Veil = game:GetService("ReplicatedStorage"):WaitForChild("Veil")
local Config = require(Veil.Config)

local FightCamera = {}

local cam: Camera = workspace.CurrentCamera
local state = {
	pos = Vector3.new(0, Config.CameraHeight + 3, Config.CameraBaseDistance),
	look = Vector3.new(0, Config.CameraLookHeight, 0),
	fov = Config.CameraFov,
	shake = 0,
	shakeDecay = 6,
	cinematic = nil,
	enabled = false,
	shakeScale = 1,
}

function FightCamera.enable()
	cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	state.enabled = true
end

function FightCamera.disable()
	state.enabled = false
	state.cinematic = nil
end

function FightCamera.setShakeScale(k: number)
	state.shakeScale = k
end

function FightCamera.shake(amount: number)
	state.shake = math.max(state.shake, amount * state.shakeScale)
end

-- fn(t) -> (CFrame, fov?) ; duration in seconds (nil = until cleared)
function FightCamera.cinematic(fn, duration: number?)
	state.cinematic = { fn = fn, t = 0, duration = duration }
end

function FightCamera.clearCinematic()
	state.cinematic = nil
end

function FightCamera.isCinematic(): boolean
	return state.cinematic ~= nil
end

-- Snap instantly to the fight framing for the given fighters.
function FightCamera.snap(x1: number, x2: number)
	local tp, tl = FightCamera.target(x1, 0, x2, 0)
	state.pos = tp
	state.look = tl
end

function FightCamera.target(x1: number, y1: number, x2: number, y2: number)
	local mid = (x1 + x2) / 2
	local sep = math.abs(x1 - x2)
	local dist = Config.CameraBaseDistance + math.max(0, sep - 4) * Config.CameraDistancePerStud
	local halfView = dist * math.tan(math.rad(Config.CameraFov / 2)) * 1.6
	local lim = Config.StageHalfWidth + 2 - halfView
	if lim > 0 then
		mid = math.clamp(mid, -lim, lim)
	end
	local maxY = math.max(y1, y2)
	local h = Config.CameraHeight + maxY * 0.55
	local lookY = Config.CameraLookHeight + maxY * 0.45
	return Vector3.new(mid, h, dist), Vector3.new(mid, lookY, 0)
end

local function noise(t: number, seed: number): number
	return math.sin(t * 37.1 + seed) * 0.5 + math.sin(t * 61.7 + seed * 2.3) * 0.35 + math.sin(t * 13.3 + seed * 0.7) * 0.15
end

local clock = 0
function FightCamera.update(dt: number, x1: number, y1: number, x2: number, y2: number)
	if not state.enabled then
		return
	end
	clock += dt
	cam.CameraType = Enum.CameraType.Scriptable
	local cf, fov
	if state.cinematic then
		local c = state.cinematic
		c.t += dt
		cf, fov = c.fn(c.t)
		if c.duration and c.t >= c.duration then
			state.cinematic = nil
		end
		state.pos = cf.Position
		state.look = cf.Position + cf.LookVector * 20
		state.fov = fov or state.fov
	else
		local tp, tl = FightCamera.target(x1, y1, x2, y2)
		local k = 1 - math.exp(-dt * 6)
		state.pos = state.pos:Lerp(tp, k)
		state.look = state.look:Lerp(tl, k)
		state.fov = state.fov + (Config.CameraFov - state.fov) * k
		cf = CFrame.lookAt(state.pos, state.look)
	end
	if state.shake > 0.001 then
		local s = state.shake
		cf = cf * CFrame.new(noise(clock, 1) * s * 0.35, noise(clock, 7) * s * 0.35, 0) * CFrame.Angles(0, 0, noise(clock, 3) * s * 0.02)
		state.shake = math.max(0, s - dt * state.shakeDecay * math.max(0.4, s))
	end
	cam.CFrame = cf
	cam.FieldOfView = state.fov
end

function FightCamera.position(): Vector3
	return state.pos
end

return FightCamera
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="32">
            <Properties>
              <string name="Name">FightView</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Runs a match: fixed-step engine simulation, CPU brains, rendering of fighters,
-- Echoes and projectiles, combat events -> VFX / audio / camera / HUD, super and
-- finisher cinematics, intros and the end-of-match handoff.

local RunService = game:GetService("RunService")

local Veil = game:GetService("ReplicatedStorage"):WaitForChild("Veil")
local Config = require(Veil.Config)
local Fighters = require(Veil.Data.Fighters)
local Echoes = require(Veil.Data.Echoes)
local Stages = require(Veil.Data.Stages)
local MoveKit = require(Veil.Data.MoveKit)
local Engine = require(Veil.Combat.Engine)
local AI = require(Veil.Combat.AI)

local Client = script.Parent.Parent
local Rig = require(script.Parent.Rig)
local Poses = require(script.Parent.Poses)
local StageBuilder = require(script.Parent.StageBuilder)
local FightCamera = require(script.Parent.FightCamera)
local VFX = require(script.Parent.VFX)
local Audio = require(Client.Core.Audio)
local Input = require(Client.Core.Input)
local HUD = require(Client.UI.HUD)
local Subtitles = require(Client.UI.Subtitles)
local MobileControls = require(Client.UI.MobileControls)
local Theme = require(Client.UI.Theme)

local FightView = {}
FightView.__index = FightView

local DT = 1 / 60
local YAW = math.rad(25)

local ECHO_STYLE = { staff = "pole", bow = "ranged", lantern = "unarmed", none = "unarmed" }

local STRENGTH_SFX = { light = "hit_light", medium = "hit_medium", heavy = "hit_heavy", special = "hit_heavy", super = "super_impact" }
local STRENGTH_SHAKE = { light = 0.25, medium = 0.45, heavy = 0.8, special = 0.7, super = 1.4 }

local function v3(x: number, y: number, z: number?): Vector3
	return Vector3.new(x, y, z or 0)
end

local function rootCFrame(x: number, y: number, facing: number, extraYaw: number?): CFrame
	local pos = v3(x, y, 0)
	local yaw = YAW + (extraYaw or 0)
	local fwd = Vector3.new(facing * math.cos(yaw), 0, math.sin(yaw))
	return CFrame.lookAt(pos, pos + fwd)
end

function FightView.new(opts)
	local self = setmetatable({}, FightView)
	self.opts = opts
	self.settings = opts.settings or {}
	self.time = 0
	self.acc = 0
	self.paused = false
	self.ended = false
	self.connections = {}

	local p1Def = Fighters.get(opts.p1.fighter)
	local p2Def = Fighters.get(opts.p2.fighter)
	local p1Echo = Echoes.get(opts.p1.echo)
	local p2Echo = Echoes.get(opts.p2.echo)
	self.defs = { p1Def, p2Def }
	self.echoDefs = { p1Echo, p2Echo }
	self.styles = { Poses.STYLE_OF[p1Def.stance] or "unarmed", Poses.STYLE_OF[p2Def.stance] or "unarmed" }

	-- world
	self.stage = StageBuilder.build(opts.stage)
	local stageDef = Stages.get(opts.stage)
	self.folder = Instance.new("Folder")
	self.folder.Name = "VeilFight"
	self.folder.Parent = workspace

	-- engine
	self.match = Engine.newMatch({
		p1 = { fighter = opts.p1.fighter, echo = opts.p1.echo, cpu = opts.p1.cpu },
		p2 = { fighter = opts.p2.fighter, echo = opts.p2.echo, cpu = opts.p2.cpu, boss = opts.boss },
		stage = opts.stage,
		training = opts.training,
		dummy = opts.dummy,
		seed = opts.seed or math.floor(os.clock() * 1000) % 1000000,
		roundsToWin = opts.roundsToWin,
		shortIntro = opts.shortIntro,
		noFinisher = opts.noFinisher,
	})
	self.ai = {}
	for i, spec in { opts.p1, opts.p2 } do
		if spec.cpu then
			self.ai[i] = AI.new(self.match, i, spec.difficulty or 2, (opts.seed or 7) + i * 101)
		end
	end
	if opts.training and not opts.p2.cpu then
		self.match.trainingDummy = opts.dummy or "stand"
	end

	-- rigs
	self.rigs = {}
	self.anim = {}
	self.highlights = {}
	for i, def in self.defs do
		local rig = Rig.build(def.look, { name = def.name, world = workspace })
		rig.model.Parent = self.folder
		self.rigs[i] = rig
		self.anim[i] = { key = nil, start = 0, from = nil, last = Poses.stance(self.styles[i]), walkPhase = 0 }
		local hl = Instance.new("Highlight")
		hl.FillColor = Color3.new(1, 1, 1)
		hl.FillTransparency = 1
		hl.OutlineTransparency = 1
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = rig.model
		self.highlights[i] = hl
	end
	self.echoRigs = {}
	self.projVisuals = {}
	self.prevPos = {}
	for i, f in self.match.fighters do
		self.prevPos[i] = { x = f.x, y = f.y }
	end

	-- UI
	self.hud = HUD.new(opts.root, p1Def, p1Echo, p2Def, p2Echo, { training = opts.training })
	if (Input.mode == "touch" or opts.forceTouch) and not opts.noTouch then
		self.touch = MobileControls.new(self.hud.root, {
			onPause = function()
				if opts.onPause then
					opts.onPause()
				end
			end,
		})
	end
	if self.touch and opts.training then
		-- touch players cycle the practice dummy with an on-screen button
		local b = Instance.new("TextButton")
		b.Name = "DummyButton"
		b.Text = "DUMMY"
		b.FontFace = Theme.Fonts.labelBold
		b.TextSize = 18
		b.TextColor3 = Theme.Colors.ivory
		b.AutoButtonColor = false
		b.BackgroundColor3 = Color3.fromHex("#0C0D10")
		b.BackgroundTransparency = 0.3
		b.Size = UDim2.fromOffset(120, 50)
		b.Position = UDim2.new(1, -36, 0, 350)
		b.AnchorPoint = Vector2.new(1, 0)
		b.ZIndex = 30
		b.Parent = self.hud.root
		Theme.corner(b, 8)
		Theme.stroke(b, Theme.Colors.goldDim, 1.5)
		table.insert(self.connections, b.Activated:Connect(function()
			self:cycleDummy()
		end))
	end
	self.hud:setVisible(true)

	-- camera & audio
	FightCamera.enable()
	FightCamera.setShakeScale(self.settings.shake == false and 0 or 1)
	FightCamera.snap(self.match.fighters[1].x, self.match.fighters[2].x)
	Audio.music(stageDef.music)
	Audio.ambience(stageDef.ambience)

	Input.fightEnabled = true
	table.insert(self.connections, RunService.RenderStepped:Connect(function(dt)
		self:frame(math.min(dt, 0.1))
	end))
	table.insert(self.connections, Input.nav.Event:Connect(function(action)
		if action == "start" and not self.ended and opts.onPause then
			opts.onPause()
		elseif action == "alt" and self.match.training then
			self:cycleDummy()
		elseif action == "confirm" or action == "back" then
			if self.match.phase == "intro" then
				Engine.skipIntro(self.match)
			end
		end
	end))
	if self.match.phase == "intro" then
		self:introCamera(1)
	end
	return self
end

-------------------------------------------------------------------------------
-- Simulation
-------------------------------------------------------------------------------

function FightView:setPaused(p: boolean)
	self.paused = p
	if self.touch then
		self.touch:setVisible(not p)
	end
end

function FightView:cycleDummy()
	local order = { "stand", "block", "cpu" }
	local cur = self.match.trainingDummy or "stand"
	local idx = table.find(order, cur) or 1
	local nextMode = order[idx % #order + 1]
	self.match.trainingDummy = nextMode
	local f2 = self.match.fighters[2]
	if nextMode == "cpu" then
		f2.isCPU = true
		self.ai[2] = AI.new(self.match, 2, 2, 77)
	else
		f2.isCPU = false
		self.ai[2] = nil
	end
	self.hud:announce("DUMMY: " .. string.upper(nextMode), nil, { size = 54, hold = 0.8, band = false })
end

function FightView:inputFor(i: number)
	local brain = self.ai[i]
	if brain then
		return brain:getInput()
	end
	if i == 1 then
		return Input.fightState()
	end
	return Engine.NeutralInput
end

function FightView:frame(dt: number)
	self.time += dt
	local m = self.match
	if not self.paused then
		local scale = (m.slowmo and m.slowmo > 0) and 0.35 or 1
		self.acc += dt * scale
		local steps = 0
		while self.acc >= DT and steps < 4 do
			self.acc -= DT
			steps += 1
			for i, f in m.fighters do
				self.prevPos[i].x = f.x
				self.prevPos[i].y = f.y
			end
			local i1 = self:inputFor(1)
			local i2 = self:inputFor(2)
			Engine.step(m, i1, i2)
			for _, ev in Engine.drainEvents(m) do
				self:onEvent(ev)
			end
		end
		if steps >= 4 then
			self.acc = 0
		end
	end
	self:render(dt)
end

-------------------------------------------------------------------------------
-- Rendering
-------------------------------------------------------------------------------

local function hitPose(react: string)
	if react == "high" then
		return Poses.States.hit_high()
	elseif react == "low" then
		return Poses.States.hit_low()
	end
	return Poses.States.hit_mid()
end

function FightView:poseFor(i: number, f, t: number)
	local style = self.styles[i]
	local st = f.state
	local m = self.match
	local key, pose
	local extraYaw = 0
	if st == "attack" and f.move then
		local mv = f.move
		key = "atk:" .. mv.id .. ":" .. tostring(m.frame - f.moveT)
		pose = Poses.attack(mv.anim, style, f.moveT, mv.startup, mv.active, mv.recovery)
	elseif st == "stand" or st == "walk" then
		local walking = f.walk ~= 0 and (m.phase == "fight" or m.phase == "finish_prompt")
		if walking then
			key = "walk"
			local a = self.anim[i]
			a.walkPhase += (f.walk > 0 and 1 or -1) * 0.22 * f.def.walkMult
			pose = Poses.walk(style, a.walkPhase, f.walk)
		else
			key = "idle"
			pose = Poses.idle(style, t)
		end
	elseif st == "crouch" then
		key = "crouch"
		pose = Poses.States.crouch(style)
	elseif st == "block" or st == "blockstun" then
		key = f.crouch and "cblock" or "block"
		pose = f.crouch and Poses.States.crouch_block(style) or Poses.States.block(style)
		if st == "blockstun" then
			pose = table.clone(pose)
			local r = pose.root or { 0, 0, 0 }
			pose.root = { r[1], r[2], (r[3] or 0) + 0.25 }
		end
	elseif st == "jumpsquat" or st == "land" then
		key = "land"
		pose = Poses.States.land(style)
	elseif st == "air" then
		key = f.vy > 0 and "jump" or "fall"
		pose = f.vy > 0 and Poses.States.jump(style) or Poses.States.fall(style)
		if f.jumpDir ~= 0 and f.vy > -0.2 then
			pose = table.clone(pose)
			pose.root = { 0, 0.1, 0, -f.jumpDir * math.clamp(f.t * 12, 0, 360) * (f.t < 30 and 1 or 0), 0, 0 }
		end
	elseif st == "dash" then
		key = "dash"
		pose = Poses.States.dash(style)
	elseif st == "backdash" then
		key = "backdash"
		pose = Poses.States.backdash(style)
	elseif st == "hitstun" then
		key = "hit:" .. tostring(f.hitReact) .. tostring(f.lastHitFrame or 0)
		local base = hitPose(f.hitReact)
		local k = math.clamp(f.stun / 12, 0, 1)
		pose = Poses.lerp(Poses.stance(style), base, k)
	elseif st == "juggle" then
		key = "juggle"
		pose = table.clone(Poses.States.juggle())
		local spin = math.clamp(-f.vy * 90, -40, 60)
		pose.root = { 0, 0, 0, 52 + spin, 0, 0 }
	elseif st == "knockdown" or st == "dead_down" then
		key = "lie"
		pose = Poses.States.lie()
	elseif st == "getup" then
		key = "getup"
		local k = math.clamp(f.t / Config.GetupFrames, 0, 1)
		if k < 0.5 then
			pose = Poses.lerp(Poses.States.lie(), Poses.States.getup(style), k * 2)
		else
			pose = Poses.lerp(Poses.States.getup(style), Poses.stance(style), (k - 0.5) * 2)
		end
	elseif st == "thrown" then
		key = "thrown"
		pose = Poses.States.thrown()
	elseif st == "throwing" then
		key = f.throwT < 26 and "throwing" or "slam"
		pose = f.throwT < 26 and Poses.States.throwing() or Poses.States.throwing_slam()
	elseif st == "breaker" then
		key = "breaker"
		pose = Poses.States.breaker()
	elseif st == "super" then
		pose, key = self:superPose(i, f, style)
	elseif st == "finisher" then
		pose, key = self:finisherPose(i, f, style)
	elseif st == "win" then
		key = "win"
		pose = table.clone(Poses.WIN[style] or Poses.WIN.unarmed)
		local b = math.sin(t * 2) * 1.5
		pose.UT = { (pose.UT and pose.UT[1] or 0) + b, pose.UT and pose.UT[2] or 0, 0 }
	elseif st == "dazed" then
		key = "dazed"
		pose = table.clone(Poses.States.dazed())
		local r = pose.root
		pose.root = { r[1], r[2], r[3], math.sin(t * 1.7) * 6, math.sin(t * 1.1) * 8, math.sin(t * 2.3) * 7 }
	elseif st == "intro" then
		key = "intro"
		local introT = m.phaseT / 60
		local mine = (i == 1 and introT < 2.5) or (i == 2 and introT >= 2.5)
		if mine and m.round == 1 then
			pose = Poses.lerp(Poses.stance(style), Poses.WIN[style] or Poses.WIN.unarmed, math.clamp(math.sin(math.min(introT % 2.5, 2.2) / 2.2 * math.pi) * 1.4, 0, 1))
		else
			pose = Poses.idle(style, t)
		end
	elseif st == "banished" then
		key = "banished"
		pose = Poses.States.dazed()
	else
		key = st
		pose = Poses.stance(style)
	end
	return pose, key, extraYaw
end

-- Super cinematic choreography (150 frames)
function FightView:superPose(i: number, _f, style: string)
	local c = self.match.cinematic
	if not c then
		return Poses.stance(style), "super"
	end
	local t = c.t
	if c.attacker == i then
		local seq = Poses.SuperSequence[style] or Poses.SuperSequence.unarmed
		if t < 18 then
			return Poses.lerp(Poses.stance(style), Poses.States.breaker(), t / 18), "super:charge"
		end
		local idx = math.min(#seq, math.floor((t - 18) / 20) + 1)
		local local_t = (t - 18) - (idx - 1) * 20
		local name = seq[idx]
		if t >= 118 then
			local def = Poses.Attacks[seq[#seq]]
			return def and def.hit or Poses.stance(style), "super:final"
		end
		return Poses.attack(name, style, local_t, 8, 4, 8), "super:" .. idx
	else
		if t < 118 then
			local cyc = math.floor(t / 10) % 2
			return cyc == 0 and Poses.States.hit_high() or Poses.States.hit_mid(), "superhit:" .. cyc
		end
		return Poses.States.juggle(), "superhit:final"
	end
end

function FightView:finisherPose(_i: number, _f, style: string)
	local fin = self.match.finisher
	local t = fin and fin.t or 0
	if t < 50 then
		return Poses.lerp(Poses.stance(style), Poses.Attacks.cast_up.hit, t / 50), "fin:charge"
	elseif t < 190 then
		local seq = Poses.SuperSequence[style] or Poses.SuperSequence.unarmed
		local idx = math.min(#seq, math.floor((t - 50) / 28) + 1)
		local lt = (t - 50) - (idx - 1) * 28
		return Poses.attack(seq[idx], style, lt, 10, 6, 12), "fin:" .. idx
	elseif t < 230 then
		local def = Poses.Attacks[(Poses.SuperSequence[style] or Poses.SuperSequence.unarmed)[5]]
		return def.hit, "fin:final"
	end
	return Poses.WIN[style] or Poses.WIN.unarmed, "fin:win"
end

function FightView:render(dt: number)
	local m = self.match
	local alpha = math.clamp(self.acc / DT, 0, 1)
	local t = self.time
	for i, f in m.fighters do
		local rig = self.rigs[i]
		if rig.shattered then
			continue
		end
		local a = self.anim[i]
		local pose, key, extraYaw = self:poseFor(i, f, t)
		if key ~= a.key then
			a.from = a.last
			a.start = t
			a.key = key
			a.blend = (string.sub(key, 1, 4) == "atk:") and 0.05 or 0.1
		end
		local final = pose
		if a.from then
			local k = (t - a.start) / a.blend
			if k < 1 then
				final = Poses.lerp(a.from, pose, Poses.ease(math.clamp(k, 0, 1)))
			else
				a.from = nil
			end
		end
		a.last = final
		local pp = self.prevPos[i]
		local x = pp.x + (f.x - pp.x) * alpha
		local y = pp.y + (f.y - pp.y) * alpha
		if m.hitstop > 0 and (f.state == "hitstun" or f.state == "juggle" or f.state == "blockstun") then
			x += math.sin(t * 90) * 0.07
		end
		local cf = rootCFrame(x, y, f.facing, extraYaw)
		Rig.apply(rig, cf, final, { time = t, vx = (f.x - pp.x) * f.facing * 3, vy = f.vy or 0 })
		-- weapon trails during active frames
		local trailOn = false
		if f.state == "attack" and f.move then
			local mv = f.move
			trailOn = (mv.trail or mv.kind == "special" or mv.kind == "super") and f.moveT >= mv.startup - 3 and f.moveT <= mv.startup + mv.active + 3
		elseif f.state == "super" or f.state == "finisher" then
			trailOn = true
		end
		if rig.trailOn ~= trailOn then
			rig.trailOn = trailOn
			Rig.setTrails(rig, trailOn)
		end
		-- invulnerability shimmer during teleports
		local fade = 0
		if f.state == "attack" and f.move and f.move.teleport then
			local tp = f.move.teleport.frame
			local d = math.abs(f.moveT - tp)
			if d < 6 then
				fade = 1 - d / 6
			end
		end
		Rig.setTransparency(rig, math.floor(fade * 10) / 10)
	end

	self:renderEchoes(t)
	self:renderProjectiles(t)

	local f1, f2 = m.fighters[1], m.fighters[2]
	FightCamera.update(dt, f1.x, f1.y, f2.x, f2.y)
	StageBuilder.update(t, FightCamera.position().X)
	self.hud:update(m, dt)
	if self.touch then
		self.touch:update(f1, Config.SuperCost, Config.BreakerCost)
	end
	if m.training then
		self:trainingReadout()
	end
	if m.over and not self.ended then
		self.ended = true
		task.delay(3.4, function()
			if not self.destroyed and self.opts.onEnd then
				self.opts.onEnd(self:result())
			end
		end)
	end
end

function FightView:renderEchoes(t: number)
	local m = self.match
	local alive = {}
	for _, e in m.echoes do
		alive[e.id] = true
		local er = self.echoRigs[e.id]
		if not er then
			local def = e.def
			local rig = Rig.build(def.look, { name = "Echo_" .. def.id, spectral = Color3.fromHex(def.accent), world = workspace })
			rig.model.Parent = self.folder
			er = { rig = rig, style = ECHO_STYLE[def.look.weapon] or "unarmed" }
			self.echoRigs[e.id] = er
		end
		local mv = e.move
		local pose = Poses.attack(mv.anim, er.style, e.t, mv.startup, mv.active, mv.recovery)
		Rig.apply(er.rig, rootCFrame(e.x, 0, e.facing), pose, { time = t })
		local total = mv.startup + mv.active + mv.recovery
		local fade = 0
		if e.t < 8 then
			fade = 1 - e.t / 8
		elseif e.t > total - 8 then
			fade = (e.t - (total - 8)) / 8
		end
		Rig.setTransparency(er.rig, math.clamp(math.floor(fade * 10) / 10, 0, 1))
	end
	for id, er in self.echoRigs do
		if not alive[id] then
			Rig.destroy(er.rig)
			self.echoRigs[id] = nil
		end
	end
end

function FightView:renderProjectiles(_t: number)
	local m = self.match
	local alive = {}
	for _, p in m.projectiles do
		alive[p.id] = true
		local vis = self.projVisuals[p.id]
		if not vis then
			vis = VFX.projectile(p.def.kind, p.def.element)
			self.projVisuals[p.id] = vis
		end
		local facing = p.vx < 0 and -1 or (p.vx > 0 and 1 or p.facing)
		local origin = nil
		if p.def.kind == "hook" then
			local o = m.fighters[p.owner]
			origin = v3(o.x + o.facing * 1.2, 3.2)
		end
		if p.delay > 0 then
			vis.model.Parent = nil
		else
			if not vis.model.Parent then
				vis.model.Parent = workspace:FindFirstChild("VeilVFX") or workspace
			end
			vis:set(v3(p.x, p.y), facing, p.t / 60, origin)
		end
	end
	for id, vis in self.projVisuals do
		if not alive[id] then
			vis:destroy(vis.lastPos)
			self.projVisuals[id] = nil
		end
	end
end

function FightView:trainingReadout()
	local m = self.match
	local p1 = m.fighters[1]
	local lines = {}
	lines[1] = "PRACTICE  \u{2014}  DUMMY: " .. string.upper(m.trainingDummy or "stand")
	lines[2] = "Switch dummy:  [" .. (Input.mode == "touch" and "DUMMY" or Input.glyph("alt")) .. "]"
	if self.lastMove then
		lines[3] = self.lastMove.name
		lines[4] = MoveKit.describe(self.lastMove)
	else
		lines[3] = "Perform a move to see its frame data"
		lines[4] = ""
	end
	lines[5] = string.format("Last combo: %d hits  /  %d dmg", self.lastCombo or 0, self.lastComboDmg or 0)
	self.hud:trainingInfo(lines)
	local _ = p1
end

-------------------------------------------------------------------------------
-- Events
-------------------------------------------------------------------------------

function FightView:rigFlash(i: number, color: Color3?)
	local hl = self.highlights[i]
	if not hl then
		return
	end
	hl.FillColor = color or Color3.new(1, 1, 1)
	hl.FillTransparency = 0.35
	Theme.tween(hl, 0.14, { FillTransparency = 1 })
end

function FightView:fighterWorldPos(i: number, yOff: number?)
	local f = self.match.fighters[i]
	return v3(f.x, f.y + (yOff or 3))
end

function FightView:introCamera(i: number)
	local f = self.match.fighters[i]
	local rig = self.rigs[i]
	local s = rig.scale
	FightCamera.cinematic(function(t)
		local head = v3(f.x, 4.4 * s, 0)
		local side = f.facing
		local orbit = math.rad(-20 + t * 8) * side
		local dist = 7.5 * s - t * 0.25
		local pos = head + Vector3.new(math.sin(orbit) * dist * side + side * 2.5, -0.4 + t * 0.12, math.cos(orbit) * dist)
		return CFrame.lookAt(pos, head - Vector3.new(0, 0.6 * s, 0)), 32
	end, 2.5)
end

function FightView:onEvent(ev)
	local m = self.match
	local typ = ev.type
	if typ == "intro" then
		local f = m.fighters[ev.fighter]
		local def = f.def
		Subtitles.show(def.name, def.intro[ev.line] or def.intro[1], 2.3, Color3.fromHex(def.accent))
		Audio.voice(def.voice, "attack")
		if ev.fighter == 2 then
			self:introCamera(2)
		end
	elseif typ == "round_call" then
		FightCamera.clearCinematic()
		local final = m.fighters[1].roundWins == m.roundsToWin - 1 and m.fighters[2].roundWins == m.roundsToWin - 1
		self.hud:announce(final and "FINAL ROUND (NO PRESSURE)" or ("ROUND " .. tostring(ev.round)), nil, { hold = 1.1 })
		Audio.play("round_gong", { volume = 0.9 })
		Audio.play("countdown", { volume = 0.6 })
	elseif typ == "fight" then
		self.hud:announce("FIGHT", nil, { punch = true, color = Theme.Colors.goldBright, hold = 0.7 })
		Audio.play("fight", { volume = 1 })
		FightCamera.shake(0.5)
	elseif typ == "move" then
		local f = m.fighters[ev.fighter]
		local mv = f.def.moves[ev.move]
		if mv then
			if mv.sfx then
				Audio.play(mv.sfx, { volume = 0.7, pitchVar = 0.08 })
			end
			if (mv.kind == "special" or mv.strength == "heavy") and math.random() < 0.55 then
				Audio.voice(f.def.voice, "attack")
			end
			if ev.fighter == 1 then
				self.lastMove = mv
			end
			if mv.kind == "special" and mv.element then
				local cols = VFX.colors(mv.element)
				VFX.flashBall(self:fighterWorldPos(ev.fighter, 3.4) + v3(f.facing * 1.0, 0), cols[2], 2.2, 0.18)
			end
		end
	elseif typ == "super_start" then
		local f = m.fighters[ev.fighter]
		self.hud:flash(Color3.fromHex(f.def.accent), 0.45)
		Audio.play("super_start", { volume = 1 })
		FightCamera.shake(0.6)
		VFX.burstShockwave(self:fighterWorldPos(ev.fighter, 3), Color3.fromHex(f.def.accent))
	elseif typ == "hit" then
		local attacker = m.fighters[ev.attacker]
		local dir = attacker.facing
		local pos = v3(ev.x, ev.y, 0.2)
		local essence = ev.source ~= "throw"
		VFX.hit(pos, ev.strength or "medium", ev.element, dir, essence)
		Audio.play(ev.sfx or STRENGTH_SFX[ev.strength] or "hit_medium", { volume = 0.85, pitchVar = 0.07 })
		FightCamera.shake(STRENGTH_SHAKE[ev.strength] or 0.4)
		self:rigFlash(ev.victim)
		local victim = m.fighters[ev.victim]
		victim.lastHitFrame = m.frame
		if ev.combo and ev.combo >= 2 then
			self.hud:combo(ev.attacker, ev.combo, (ev.comboDamage or 0) / victim.maxHp * 100)
		end
		if math.random() < 0.4 or ev.strength == "heavy" then
			Audio.voice(victim.def.voice, "hurt")
		end
		if ev.result == "knockdown" or ev.result == "launch" then
			FightCamera.shake(0.6)
		end
		if ev.attacker == 1 then
			self.lastCombo = ev.combo
			self.lastComboDmg = ev.comboDamage
		end
	elseif typ == "block" then
		local attacker = m.fighters[ev.attacker]
		VFX.block(v3(ev.x, ev.y, 0.2), attacker.facing)
		Audio.play("block", { volume = 0.7, pitchVar = 0.06 })
		FightCamera.shake(0.15)
	elseif typ == "throw" then
		Audio.play("whoosh_heavy", { volume = 0.7 })
		Audio.voice(m.fighters[ev.attacker].def.voice, "attack")
	elseif typ == "tech" then
		VFX.parry(v3(ev.x, ev.y, 0.3))
		Audio.play("tech", { volume = 0.8 })
		self.hud:announce("NICE TRY", nil, { size = 56, hold = 0.6, band = false })
	elseif typ == "projectile_spawn" then
		local p = nil
		for _, pp in m.projectiles do
			if pp.id == ev.id then
				p = pp
			end
		end
		if p then
			local vis = VFX.projectile(p.def.kind, p.def.element)
			self.projVisuals[p.id] = vis
		end
	elseif typ == "projectile_end" then
		local vis = self.projVisuals[ev.id]
		if vis then
			vis:destroy(v3(ev.x, ev.y, 0.3))
			self.projVisuals[ev.id] = nil
			if ev.hit then
				Audio.play("projectile_hit", { volume = 0.7, pitchVar = 0.08 })
			end
		end
	elseif typ == "clash" then
		VFX.flashBall(v3(ev.x, ev.y, 0.3), Color3.new(1, 1, 1), 4, 0.2)
		VFX.ring(v3(ev.x, ev.y, 0.3), Color3.fromHex("#FFE6A0"), 6, 0.25)
		Audio.play("projectile_hit", { volume = 0.9 })
	elseif typ == "echo_summon" then
		local f = m.fighters[ev.fighter]
		local echo = f.echoDef
		VFX.teleport(v3(f.x - f.facing * 1.6, 0), Color3.fromHex(echo.accent))
		Audio.play("echo_summon", { volume = 0.8 })
		Subtitles.show(echo.name, echo.callLine, 1.4, Color3.fromHex(echo.accent))
	elseif typ == "echo_vanish" then
		VFX.teleport(v3(ev.x, 0), Color3.fromHex("#9FEFFF"))
	elseif typ == "teleport" then
		local f = m.fighters[ev.fighter]
		local col = Color3.fromHex(f.def.accent)
		VFX.teleport(v3(ev.fromX, ev.fromY or 0), col)
		VFX.teleport(v3(ev.toX, 0), col)
		Audio.play("teleport", { volume = 0.8 })
	elseif typ == "dash" then
		local f = m.fighters[ev.fighter]
		VFX.dust(v3(f.x, 0), false)
		Audio.play("dash", { volume = 0.5 })
	elseif typ == "jump" then
		Audio.play("jump", { volume = 0.45, pitchVar = 0.05 })
	elseif typ == "land" then
		VFX.dust(v3(ev.x, 0), ev.heavy)
		Audio.play("land", { volume = ev.heavy and 0.9 or 0.4 })
		if ev.heavy then
			FightCamera.shake(0.6)
			VFX.groundEruption(v3(ev.x, 0), m.fighters[ev.fighter].def.moves.SB and m.fighters[ev.fighter].def.moves.SB.element or "ice", 2.5)
		end
	elseif typ == "knockdown" then
		VFX.dust(v3(ev.x, 0), true)
		Audio.play("knockdown", { volume = 0.9 })
		FightCamera.shake(0.5)
	elseif typ == "getup" then
		Audio.play("getup", { volume = 0.4 })
	elseif typ == "parry" then
		VFX.parry(v3(ev.x, ev.y, 0.3))
		Audio.play("parry", { volume = 1 })
		self.hud:flash(Color3.new(1, 1, 1), 0.3)
		self.hud:announce("NOT TODAY", nil, { size = 60, hold = 0.6, band = false, color = Theme.Colors.goldBright })
	elseif typ == "armor" then
		VFX.ring(v3(ev.x, ev.y, 0.3), Color3.fromHex("#FFD27A"), 5, 0.25)
		Audio.play("block", { volume = 0.9, pitch = 0.8 })
	elseif typ == "breaker" then
		local f = m.fighters[ev.fighter]
		VFX.burstShockwave(v3(ev.x, ev.y), Color3.fromHex(f.def.accent))
		Audio.play("breaker", { volume = 1 })
		self.hud:flash(Color3.fromHex(f.def.accent), 0.5)
		self.hud:announce("RAGE QUIT!", nil, { size = 70, hold = 0.7, band = false, color = Color3.fromHex(f.def.accent) })
		FightCamera.shake(1)
	elseif typ == "super_hit" then
		self:startSuperCinematic(ev)
	elseif typ == "super_end" then
		self:endSuperCinematic()
	elseif typ == "ko" then
		self.hud:flash(Color3.new(1, 1, 1), 0.8)
		self.hud:announce("OOF!", ev.perfect and "NO DAMAGE TAKEN. EMBARRASSING." or nil, { punch = true, color = Theme.Colors.crimsonBright, size = 150, hold = 2.0 })
		Audio.play("ko", { volume = 1 })
		Audio.play("oof", { group = "voice", volume = 1 })
		Audio.duck(0.35, 2.5)
		FightCamera.shake(1.4)
		VFX.burstShockwave(v3(ev.x, ev.y), Theme.Colors.crimsonBright)
	elseif typ == "time_over" then
		self.hud:announce("TIME", nil, { hold = 1.4 })
		Audio.play("round_gong", { volume = 1 })
	elseif typ == "round_win" then
		if ev.winner and ev.winner > 0 then
			local wf = m.fighters[ev.winner]
			self.hud:announce(wf.def.name .. " WINS", ev.perfect and "NOT EVEN CLOSE" or (ev.timeOver and "TIME (SERVER LAG)" or nil), {
				size = 84,
				hold = 1.8,
				color = Theme.Colors.ivory,
			})
			self:winCamera(ev.winner)
		else
			self.hud:announce("DRAW", "BOTH OF YOU ARE NOOBS", { hold = 1.6 })
		end
	elseif typ == "finish_prompt" then
		FightCamera.clearCinematic()
		self.hud:showFinisherPrompt(true)
		Audio.play("finisher_ready", { volume = 1 })
		Audio.duck(0.4, 6)
	elseif typ == "finisher_start" then
		self.hud:showFinisherPrompt(false)
		self:startFinisherCinematic(ev)
	elseif typ == "finisher_hit" then
		local loser = self.rigs[ev.loser]
		local wf = m.fighters[ev.winner]
		local col = Color3.fromHex(wf.def.accent)
		VFX.elementBurst(v3(m.fighters[ev.loser].x, 3), ev.style, true)
		VFX.oofBreak(loser, col)
		loser.shattered = true
		Audio.play("shatter", { volume = 1 })
		Audio.play("oof", { group = "voice", volume = 1 })
		self.hud:flash(col, 0.8)
		FightCamera.shake(1.5)
		task.delay(0.6, function()
			if self.destroyed then
				return
			end
			self.hud:announce("ACCOUNT DELETED", nil, { size = 100, hold = 2.0, color = Theme.Colors.crimsonBright })
		end)
	elseif typ == "match_end" then
		self.hud:showFinisherPrompt(false)
		local wf = m.fighters[ev.winner]
		local quote = wf.def.victory[wf.winQuote or 1] or wf.def.victory[1]
		task.delay(ev.finisher and 1.2 or 0.4, function()
			if self.destroyed then
				return
			end
			self.hud:announce(wf.def.name .. " WINS", nil, { size = 92, hold = 2.4 })
			Subtitles.show(wf.def.name, quote, 2.8, Color3.fromHex(wf.def.accent))
			Audio.voice(wf.def.voice, "attack")
			Audio.music("music_victory", 1.0)
		end)
		self:winCamera(ev.winner)
	end
end

function FightView:winCamera(i: number)
	local f = self.match.fighters[i]
	local s = self.rigs[i].scale
	FightCamera.cinematic(function(t)
		local center = v3(f.x, 3.6 * s, 0)
		local a = math.rad(15 + t * 6) * f.facing
		local pos = center + Vector3.new(math.sin(a) * 9 * f.facing + f.facing * 3, 0.6 + t * 0.15, math.cos(a) * 9)
		return CFrame.lookAt(pos, center), 34
	end, 4.5)
end

function FightView:startSuperCinematic(ev)
	local m = self.match
	local a = m.fighters[ev.attacker]
	local v = m.fighters[ev.victim]
	local col = Color3.fromHex(a.def.accent)
	self.hud:superBanner(a.def.superName, ev.attacker, col)
	Audio.duck(0.3, 2.6)
	local grade = self.stage and self.stage.fx and self.stage.fx.grade
	if grade then
		self.savedGrade = { grade.Brightness, grade.Saturation, grade.TintColor }
		Theme.tween(grade, 0.3, { Brightness = -0.18, Saturation = -0.4, TintColor = col:Lerp(Color3.new(1, 1, 1), 0.6) })
	end
	local strikeFrames = { 26, 46, 66, 86, 106 }
	for k, fr in strikeFrames do
		task.delay(fr / 60, function()
			if self.destroyed or not self.match.cinematic then
				return
			end
			local pos = v3(v.x, 3.2 + (k % 2) * 0.6, 0.4)
			VFX.hit(pos, "heavy", ev.style, a.facing, true)
			Audio.play("hit_heavy", { volume = 0.8, pitchVar = 0.1 })
			FightCamera.shake(0.7)
		end)
	end
	task.delay(118 / 60, function()
		if self.destroyed then
			return
		end
		self.hud:flash(Color3.new(1, 1, 1), 0.85)
		VFX.burstShockwave(v3(v.x, 3), col)
		VFX.elementBurst(v3(v.x, 3), ev.style, true)
		FightCamera.shake(1.6)
	end)
	FightCamera.cinematic(function(t)
		local mid = v3((a.x + v.x) / 2, 3.2, 0)
		local ang = math.rad(-35 + t * 40) * a.facing
		local dist = 10 - math.min(t, 1.2) * 2.5
		local pos = mid + Vector3.new(math.sin(ang) * dist, 1.2 + math.sin(t * 2) * 0.5, math.cos(ang) * dist)
		if t > 1.95 then
			pos = mid + Vector3.new(-a.facing * 4, 0.5, 7)
		end
		return CFrame.lookAt(pos, mid), 40 - math.min(t, 1) * 6
	end, 150 / 60)
end

function FightView:endSuperCinematic()
	FightCamera.clearCinematic()
	local grade = self.stage and self.stage.fx and self.stage.fx.grade
	if grade and self.savedGrade then
		Theme.tween(grade, 0.4, { Brightness = self.savedGrade[1], Saturation = self.savedGrade[2], TintColor = self.savedGrade[3] })
	end
end

function FightView:startFinisherCinematic(ev)
	local m = self.match
	local w = m.fighters[ev.winner]
	local l = m.fighters[ev.loser]
	local col = Color3.fromHex(w.def.accent)
	self.hud:superBanner(w.def.finisher.name, ev.winner, col)
	Audio.play("super_start", { volume = 1 })
	local grade = self.stage and self.stage.fx and self.stage.fx.grade
	if grade then
		Theme.tween(grade, 0.6, { Brightness = -0.2, Saturation = -0.5, TintColor = col:Lerp(Color3.new(1, 1, 1), 0.5) })
	end
	for k = 0, 4 do
		task.delay((50 + k * 28 + 12) / 60, function()
			if self.destroyed then
				return
			end
			VFX.hit(v3(l.x, 3.2, 0.4), "heavy", ev.style, w.facing, false)
			Audio.play("hit_heavy", { volume = 0.8, pitchVar = 0.1 })
			FightCamera.shake(0.6)
		end)
	end
	-- elemental build-up around the loser
	task.delay(0.4, function()
		if not self.destroyed then
			VFX.elementBurst(v3(l.x, 2.5), ev.style, true)
		end
	end)
	FightCamera.cinematic(function(t)
		local mid = v3((w.x + l.x) / 2, 3.4, 0)
		local ang = math.rad(25 - t * 14) * w.facing
		local dist = 13 - math.min(t, 3) * 1.6
		local pos = mid + Vector3.new(math.sin(ang) * dist, 1.5 + t * 0.2, math.cos(ang) * dist)
		return CFrame.lookAt(pos, mid), 38
	end, 6.0)
end

function FightView:result()
	local m = self.match
	return {
		winner = m.winner,
		rounds = { m.fighters[1].roundWins, m.fighters[2].roundWins },
		stats = { m.fighters[1].stats, m.fighters[2].stats },
		p1 = self.opts.p1,
		p2 = self.opts.p2,
		stage = self.opts.stage,
		finisher = m.finisher and m.finisher.triggered or false,
	}
end

function FightView:destroy()
	self.destroyed = true
	for _, c in self.connections do
		c:Disconnect()
	end
	self.connections = {}
	Input.fightEnabled = false
	for _, vis in self.projVisuals do
		vis:destroy()
	end
	self.projVisuals = {}
	for _, er in self.echoRigs do
		Rig.destroy(er.rig)
	end
	self.echoRigs = {}
	if self.touch then
		self.touch:destroy()
	end
	self.hud:destroy()
	self.folder:Destroy()
	VFX.clear()
	Subtitles.hide()
	FightCamera.disable()
end

return FightView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">Looks</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Character dressing: faces, hair, headwear, masks, armour, cloth and weapons.
-- Every piece is attached to a bone with an offset in that bone's local space
-- (unscaled; Rig scales by the fighter's size). Bone space: +Y up the limb,
-- -Z is the front of the body, +X the fighter's right.

local Looks = {}

local V = Vector3.new
local C = CFrame.new
local A = CFrame.Angles
local rad = math.rad

local BALL = Enum.PartType.Ball
local CYL = Enum.PartType.Cylinder

local function hexDarken(h: string, k: number): Color3
	local c = Color3.fromHex(h)
	return Color3.new(c.R * k, c.G * k, c.B * k)
end
Looks.darken = hexDarken

-------------------------------------------------------------------------------
-- Faces
-------------------------------------------------------------------------------

local FEATURE = "#1A1310"

local function eyes(attach, look, z)
	attach("Head", V(0.17, 0.08, 0.04), C(0.23, 0.07, z), FEATURE, "SmoothPlastic", { shadow = false })
	attach("Head", V(0.17, 0.08, 0.04), C(-0.23, 0.07, z), FEATURE, "SmoothPlastic", { shadow = false })
	attach("Head", V(0.3, 0.06, 0.04), C(0.23, 0.21, z) * A(0, 0, rad(12)), look.hairColor or FEATURE, "SmoothPlastic", { shadow = false })
	attach("Head", V(0.3, 0.06, 0.04), C(-0.23, 0.21, z) * A(0, 0, rad(-12)), look.hairColor or FEATURE, "SmoothPlastic", { shadow = false })
end

local FACES = {}
FACES.plain = function(attach, look)
	eyes(attach, look, -0.62)
	attach("Head", V(0.1, 0.16, 0.06), C(0, -0.06, -0.63), hexDarken(look.skin, 0.88), "SmoothPlastic", { shadow = false })
	attach("Head", V(0.28, 0.04, 0.04), C(0, -0.27, -0.61), "#5A2E26", "SmoothPlastic", { shadow = false })
end
FACES.scarred = function(attach, look)
