  {
   "id": "luarmor",
   "category": "service with no authorised retrieval",
   "loader": "script_key = \"ABCDEFGHIJ1234567890\"\nloadstring(game:HttpGet(\"https://api.luarmor.net/files/v3/loaders/0123456789abcdef0123456789abcdef.lua\"))()\n",
   "service": {},
   "expect": [
    "not-retrievable"
   ]
  },
  {
