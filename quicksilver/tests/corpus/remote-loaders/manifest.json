  {
   "id": "retrieved-unrecoverable",
   "category": "retrieved but unrecoverable",
   "loader": "loadstring(game:HttpGet(\"https://pastebin.com/raw/Zenfus01\"))()\n",
   "service": {
    "https://pastebin.com/raw/Zenfus01": {
