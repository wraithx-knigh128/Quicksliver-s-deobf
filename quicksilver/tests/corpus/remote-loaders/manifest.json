   "loader": "loadstring(game:HttpGet(\"https://paste.ee/r/Empty01\"))()\n",
   "service": {
    "https://paste.ee/r/Empty01": {
     "file": "empty.txt",
     "type": "text/plain"
    }
   },
   "expect": [
