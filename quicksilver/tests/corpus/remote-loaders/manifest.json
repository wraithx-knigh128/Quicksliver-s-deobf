   "category": "requires an owner key",
   "loader": "loadstring(game:HttpGet(\"https://raw.githubusercontent.com/qs-fixtures/demo/main/x.lua?token=SECRET123\"))()\n",
   "service": {},
   "expect": [
    "not-retrievable"
   ]
  },
  {
