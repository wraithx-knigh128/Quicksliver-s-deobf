{
 "description": "Loader fixtures: each case is a loader script and the responses a mock service gives for its addresses. Payloads are fixtures of this repository (originals, IronBrew 2, Prometheus, ZenFus outputs; a Roblox Studio model from rojo-rbx/rbx-test-files, MIT) wrapped in transport forms. Generated by tools/loaders/build-fixtures.mjs; no real service involved.",
 "cases": [
  {
   "id": "direct-plain",
   "category": "direct source",
   "loader": "loadstring(game:HttpGet(\"https://raw.githubusercontent.com/qs-fixtures/demo/main/plain.lua\"))()\n",
   "service": {
    "https://raw.githubusercontent.com/qs-fixtures/demo/main/plain.lua": {
     "file": "plain.lua",
     "type": "text/plain"
    }
   },
   "expect": [
    "retrieved-plain"
   ]
  },
  {
   "id": "public-ironbrew2",
   "category": "public endpoint, obfuscated",
   "loader": "loadstring(game:HttpGet(\"https://pastebin.com/raw/Ib2Demo01\"))()\n",
   "service": {
    "https://pastebin.com/raw/Ib2Demo01": {
     "file": "ib2.lua",
     "type": "text/plain"
    }
   },
   "expect": [
    "retrieved-reconstructed"
   ]
  },
  {
   "id": "public-prometheus",
   "category": "public endpoint, obfuscated",
   "loader": "loadstring(game:HttpGet(\"https://gist.githubusercontent.com/qs/abc123/raw\"))()\n",
   "service": {
    "https://gist.githubusercontent.com/qs/abc123/raw": {
     "file": "prom.lua",
     "type": "text/plain"
    }
   },
   "expect": [
    "retrieved-reconstructed"
   ]
  },
  {
   "id": "encoded-base64-gzip",
   "category": "encoded response",
   "loader": "loadstring(game:HttpGet(\"https://rentry.co/ib2gz/raw\"))()\n",
   "service": {
    "https://rentry.co/ib2gz/raw": {
     "file": "ib2.b64gz.txt",
     "type": "text/plain"
    }
   },
   "expect": [
    "retrieved-reconstructed"
   ]
  },
  {
   "id": "encoded-json-field",
   "category": "encoded response",
   "loader": "loadstring(game:HttpGet(\"https://paste.ee/r/JsonCode\"))()\n",
   "service": {
    "https://paste.ee/r/JsonCode": {
     "file": "plain.json",
     "type": "application/json"
    }
   },
   "expect": [
    "retrieved-plain"
   ]
  },
  {
   "id": "encoded-hex-zlib",
   "category": "encoded response",
   "loader": "loadstring(game:HttpGet(\"https://cdn.discordapp.com/attachments/1/2/payload.txt\"))()\n",
   "service": {
    "https://cdn.discordapp.com/attachments/1/2/payload.txt": {
