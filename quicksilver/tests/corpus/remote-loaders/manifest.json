     "type": "text/plain"
    }
   },
   "expect": [
    "retrieved-plain"
   ]
  },
  {
   "id": "multi-stage",
   "category": "multi-stage",
   "loader": "loadstring(game:HttpGet(\"https://raw.githubusercontent.com/qs-fixtures/demo/main/stage1.lua\"))()\n",
   "service": {
    "https://raw.githubusercontent.com/qs-fixtures/demo/main/stage1.lua": {
     "file": "stage1.lua",
     "type": "text/plain"
    },
    "https://paste.ee/r/Stage2Ib2": {
     "file": "ib2.lua",
     "type": "text/plain"
    }
   },
   "expect": [
    "nested-loader",
    "retrieved-reconstructed"
   ]
  },
  {
   "id": "invalid-endpoint",
   "category": "invalid endpoint",
   "loader": "loadstring(game:HttpGet(\"https://raw.githubusercontent.com/qs-fixtures/demo/main/missing.lua\"))()\n",
   "service": {
    "https://raw.githubusercontent.com/qs-fixtures/demo/main/missing.lua": {
     "status": 404,
     "file": "404.txt",
     "type": "text/plain"
    }
   },
   "expect": [
    "transport-failed"
   ]
  },
  {
   "id": "auth-failure",
   "category": "authentication failure",
   "loader": "loadstring(game:HttpGet(\"https://pastebin.com/raw/Private01\"))()\n",
   "service": {
    "https://pastebin.com/raw/Private01": {
     "status": 403,
     "file": "403.json",
     "type": "application/json"
    }
   },
   "expect": [
    "transport-failed"
   ]
  },
  {
   "id": "service-unavailable",
   "category": "unavailable service",
   "loader": "loadstring(game:HttpGet(\"https://rentry.co/down/raw\"))()\n",
   "service": {
    "https://rentry.co/down/raw": {
     "fail": "network"
    }
   },
   "expect": [
    "transport-failed"
   ]
  },
  {
   "id": "html-instead-of-script",
   "category": "malformed response",
   "loader": "loadstring(game:HttpGet(\"https://raw.githubusercontent.com/qs-fixtures/demo/main/page.lua\"))()\n",
   "service": {
    "https://raw.githubusercontent.com/qs-fixtures/demo/main/page.lua": {
     "file": "page.html",
     "type": "text/html"
    }
   },
   "expect": [
    "transport-failed"
   ],
   "note": "the fetcher refuses web pages (415) before they reach the decoder"
  },
  {
   "id": "html-as-text",
   "category": "malformed response",
   "loader": "loadstring(game:HttpGet(\"https://paste.ee/r/HtmlText\"))()\n",
   "service": {
    "https://paste.ee/r/HtmlText": {
     "file": "page.html",
     "type": "text/plain"
    }
   },
   "expect": [
    "not-code"
   ],
   "note": "a page served as text/plain passes the fetcher; the payload stage recognises it"
  },
  {
   "id": "truncated-gzip",
   "category": "malformed response",
   "loader": "loadstring(game:HttpGet(\"https://paste.ee/r/Truncated\"))()\n",
   "service": {
    "https://paste.ee/r/Truncated": {
     "file": "truncated.gz",
     "type": "application/octet-stream"
    }
   },
   "expect": [
    "not-code"
   ]
  },
  {
   "id": "json-error-200",
