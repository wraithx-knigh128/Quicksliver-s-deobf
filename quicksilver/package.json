{
  "name": "quicksilver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QuickSilver: analysis and recovery of obfuscated Lua / Luau source",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "scorecard": "node tests/tools-scorecard.mjs --write",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/ui.e2e.mjs",
    "license:keygen": "node tools/license/keygen.mjs",
    "license:issue": "node tools/license/issue.mjs",
    "lab:study": "node tools/lab/study.mjs",
    "lab:run": "node tools/lab/run.mjs",
    "lab:kb": "node tools/lab/kb.mjs",
    "lab": "node tools/lab/study.mjs && node tools/lab/run.mjs --seeds 16 && node tools/lab/kb.mjs",
    "runtime:setup": "sh tools/runtime/setup.sh",
    "research:collect": "node tools/research/collect.mjs",
    "research:profiles": "node tools/research/profiles-build.mjs",
    "research:capabilities": "node tools/research/capabilities.mjs",
    "research:pipeline": "node tools/research/pipeline.mjs --write",
    "research:differential": "node tools/research/differential.mjs",
    "research": "node tools/luraph/verify.mjs && node tools/research/profiles-build.mjs && node tools/research/capabilities.mjs && node tools/research/pipeline.mjs --write",
    "luraph:verify": "node tools/luraph/verify.mjs",
    "reconstruct:serve": "python3 api/reconstruct.py --serve 8788"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  }
}
