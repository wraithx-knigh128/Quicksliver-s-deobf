{
  "name": "quicksilver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QuickSilver: analysis and recovery of obfuscated Lua / Luau source",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "scorecard": "node tests/tools-scorecard.mjs --write",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/ui.e2e.mjs",
    "license:keygen": "node tools/license/keygen.mjs",
    "license:issue": "node tools/license/issue.mjs",
    "lab:study": "node tools/lab/study.mjs",
    "lab:run": "node tools/lab/run.mjs",
    "lab:kb": "node tools/lab/kb.mjs",
    "lab": "node tools/lab/study.mjs && node tools/lab/run.mjs --seeds 16 && node tools/lab/kb.mjs"
  }
}
